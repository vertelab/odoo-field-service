<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view: the fork has no form view for order types, so this
         module supplies one. It also carries the colour picker. -->
    <record id="view_fieldservice_order_type_form" model="ir.ui.view">
        <field name="name">fieldservice.order.type.form</field>
        <field name="model">fieldservice.order.type</field>
        <field name="arch" type="xml">
            <form string="Field Service Order Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="color" widget="color" class="oe_inline"/>
                            <field name="use_service_checklist"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view: add the colour column after the name.

         elevata_order_types also tried to hide `internal_type` here, but
         our fork's fieldservice.order.type has no such field — that xpath
         matched nothing in the 17 port either. Dropped rather than ported. -->
    <record id="view_fieldservice_order_type_list_inherit_color" model="ir.ui.view">
        <field name="name">fieldservice.order.type.list.inherit.color</field>
        <field name="model">fieldservice.order.type</field>
        <field name="inherit_id" ref="fieldservice_vrtl.view_fieldservice_order_type_list"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="color" widget="color"/>
                <field name="use_service_checklist" optional="show"/>
            </field>
        </field>
    </record>


</odoo>
