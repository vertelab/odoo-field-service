<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="fieldservice_order_view_form_vrtl" model="ir.ui.view">
        <field name="name">fieldservice.order.form.vrtl</field>
        <field name="model">fieldservice.order</field>
        <field name="inherit_id" ref="fieldservice_vrtl.view_fieldservice_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_top_left']/field[@name='order_number']" position="after">
                <field name="property_id"
                       options="{'no_create': True}"
                       invisible="not property_id"/>
            </xpath>
        </field>
    </record>

    <record id="fieldservice_order_view_search_vrtl" model="ir.ui.view">
        <field name="name">fieldservice.order.search.vrtl</field>
        <field name="model">fieldservice.order</field>
        <field name="inherit_id" ref="fieldservice_vrtl.view_fieldservice_order_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="property_id"/>
            </xpath>
        </field>
    </record>
</odoo>
