    <record id="view_fieldservice_order_line_employee_kanban" model="ir.ui.view">
        <field name="name">fieldservice.order.line.employee.kanban</field>
        <field name="model">fieldservice.order.line.employee</field>
        <field name="arch" type="xml">
            <kanban default_group_by="fieldservice_order_line_id" class="o_kanban_mobile" on_create="quick_create">
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable">
                            <a role="menuitem" type="open" class="dropdown-item">Edit</a>
                        </t>
                        <t t-if="widget.deletable">
                            <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                        </t>
                    </t>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <t t-if="record.image_1024">
                                <field name="image_1024" widget="background_image" options="{'zoom': true, 'zoom_delay': 1000, 'preview_image':'image_128'}" class="d-block position-relative"/>
                            </t>
                            <t t-elif="record.image_128">
                                <field name="avatar_128" widget="background_image" options="{'zoom': true, 'zoom_delay': 1000}" class="d-block position-relative"/>
                            </t>
                            <div t-else="" class="d-flex align-items-center justify-content-center bg-100 bg-gradient">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-75 h-75 opacity-50" viewBox="0 0 20 20">
                                    <g fill="currentColor">
                                        <path d="M 10 11 C 4.08 11 2 14 2 16 L 2 19 L 18 19 L 18 16 C 18 14 15.92 11 10 11 Z"/>
                                        <circle cx="10" cy="5.5" r="4.5"/>
                                    </g>
                                </svg>
                            </div>
                        </aside>
                        <main class="ms-2">
                            <field class="fw-bold fs-5" name="name"/>
                            <div class="pt-2">
                                <field name="fieldservice_order_line_id" />
                            </div>
                            <div class="pt-2">
                                <span t-if="record.address.raw_value">Address: </span>
                                <field name="address" />
                            </div>
                            <footer class="mt-auto pt-2">
                                <div class="d-lg-contents">
                                    <div>
                                        <field name="priority" widget="priority"/>
                                    </div>
                                    <div class="ms-auto">
                                        <field name="date_start" widget="date"/>
                                        <field name="date_end" widget="date"/>
                                    </div>
                                </div>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
        <!-- 
        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
            <field name="employee_id" invisible="1"/>
            <div class="o_kanban_image_fill_left d-none d-md-block" t-attf-style="background-image: url(#{kanban_image('hr.employee', 'image_128', record.employee_id.raw_value)})" role="img"/>
        </div> -->

    </record>
    <record id="view_fieldservice_order_line_employee_list" model="ir.ui.view">
        <field name="name">fieldservice.order.line.employee.list</field>
        <field name="model">fieldservice.order.line.employee</field>
        <field name="arch" type="xml">
            <list string="External Views">
                <field name="fieldservice_order_line_id"/>
                <field name="employee_id"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_fieldservice_employees" model="ir.actions.act_window">
        <field name="name">Field Service Employees</field>
        <field name="res_model">fieldservice.order.line.employee</field>
        <field name="view_mode">kanban,form,list</field>
    </record>

    <menuitem id="menu_fieldservice_employees" name="Field Service Employees" parent="fieldservice_vrtl.menu_fieldservice_root" action="action_fieldservice_employees" sequence="20"/>

</odoo>




    
