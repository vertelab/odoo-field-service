<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="email_template_elevata_offer" model="mail.template">
        <field name="name">Offert - Skicka till kund</field>
        <field name="model_id" ref="elevata_offer.model_elevata_offer"/>
        <field name="subject">Offert {{ object.name }} &#8211; {{ object.company_id.name }}</field>
        <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email or '') }}</field>
        <field name="email_to">{{ object.partner_id.email_formatted }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete">True</field>
        <field name="body_html" type="html">
<div style="font-family:'Segoe UI',Arial,sans-serif;font-size:13px;color:#333;max-width:600px;margin:0 auto;">

  <p>Hej <t t-out="object.partner_id.name"/>,</p>

  <p>
    Tack f&#246;r ditt intresse. Vi bifogar h&#228;rmed offert
    <strong><t t-out="object.name"/></strong>
    <t t-if="object.offer_type == 'serviceavtal'"> avseende serviceavtal f&#246;r era hissar</t>
    <t t-elif="object.offer_type == 'reparation'"> avseende reparation/uppgradering</t>
    <t t-elif="object.offer_type == 'modernisering'"> avseende modernisering</t>
    <t t-elif="object.offer_type == 'nyinstallation'"> avseende nyinstallation</t>.
  </p>

  <table style="width:100%;border-collapse:collapse;margin:16px 0;font-size:12px;">
    <tr style="background:#f5f5f5;">
      <td style="padding:8px 12px;color:#777;width:140px;">Offertnummer</td>
      <td style="padding:8px 12px;font-weight:600;"><t t-out="object.name"/></td>
    </tr>
    <tr>
      <td style="padding:8px 12px;color:#777;">Datum</td>
      <td style="padding:8px 12px;"><t t-out="object.date"/></td>
    </tr>
    <t t-if="object.validity_date">
    <tr style="background:#f5f5f5;">
      <td style="padding:8px 12px;color:#777;">Giltig t.o.m.</td>
      <td style="padding:8px 12px;font-weight:600;"><t t-out="object.validity_date"/></td>
    </tr>
    </t>
  </table>

  <p>
    Offerten finns bifogad som PDF. Har du fr&#229;gor eller vill godk&#228;nna offerten
    &#228;r du varmt v&#228;lkommen att kontakta oss.
  </p>

  <p style="margin-top:24px;">
    Med v&#228;nliga h&#228;lsningar,<br/>
    <strong><t t-out="object.user_id.name or object.company_id.name"/></strong><br/>
    <t t-if="object.user_id.phone">
      Tel: <t t-out="object.user_id.phone"/><br/>
    </t>
    <t t-if="object.user_id.email">
      E-post: <t t-out="object.user_id.email"/><br/>
    </t>
    <t t-out="object.company_id.name"/>
  </p>

</div>
        </field>
    </record>

    <record id="email_template_elevata_offer_won" model="mail.template">
        <field name="name">Offert - Accepterad bekräftelse</field>
        <field name="model_id" ref="elevata_offer.model_elevata_offer"/>
        <field name="subject">Bekräftelse &#8211; Offert {{ object.name }} accepterad</field>
        <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email or '') }}</field>
        <field name="email_to">{{ object.partner_id.email_formatted }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete">False</field>
        <field name="body_html" type="html">
<div style="font-family:'Segoe UI',Arial,sans-serif;font-size:13px;color:#333;max-width:600px;margin:0 auto;">

  <p>Hej <t t-out="object.partner_id.name"/>,</p>

  <p>
    Vi bekr&#228;ftar h&#228;rmed att offert <strong><t t-out="object.name"/></strong> har accepterats.
  </p>

  <p>
    Vi p&#229;b&#246;rjar arbetet enligt &#246;verenskommelse. Ni kommer att f&#229; ytterligare information
    om planering och tidsbokning inom kort.
  </p>

  <p>Tack f&#246;r ert f&#246;rtroende!</p>

  <p style="margin-top:24px;">
    Med v&#228;nliga h&#228;lsningar,<br/>
    <strong><t t-out="object.user_id.name or object.company_id.name"/></strong><br/>
    <t t-if="object.user_id.phone">
      Tel: <t t-out="object.user_id.phone"/><br/>
    </t>
    <t t-out="object.company_id.name"/>
  </p>

</div>
        </field>
    </record>

</odoo>
