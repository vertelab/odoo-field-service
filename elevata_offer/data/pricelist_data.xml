<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- STANDARDPRISLISTA — Elevata Hiss AB                           -->
    <!-- Priser i kr/år (exkl. moms). Justeras efter kundavtal.        -->
    <!-- OBS: noupdate=1 — laddas bara vid nyinstallation              -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="pricelist_standard" model="elevata.pricelist">
        <field name="name">Standardprislista</field>
        <field name="active">True</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- AVTALSPRISER OCH TIMPRISER — hanteras av                      -->
    <!-- pricelist_subscription_defaults.xml (noupdate=0)              -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- MATERIALPÅSLAG — tiered multiplier på inköpskostnad           -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="markup_0_500" model="elevata.price.markup">
        <field name="pricelist_id" ref="pricelist_standard"/>
        <field name="from_amount">0.0</field>
        <field name="to_amount">500.0</field>
        <field name="multiplier">2.5</field>
    </record>
    <record id="markup_501_5000" model="elevata.price.markup">
        <field name="pricelist_id" ref="pricelist_standard"/>
        <field name="from_amount">501.0</field>
        <field name="to_amount">5000.0</field>
        <field name="multiplier">2.2</field>
    </record>
    <record id="markup_5001_10000" model="elevata.price.markup">
        <field name="pricelist_id" ref="pricelist_standard"/>
        <field name="from_amount">5001.0</field>
        <field name="to_amount">10000.0</field>
        <field name="multiplier">1.7</field>
    </record>
    <record id="markup_10001_50000" model="elevata.price.markup">
        <field name="pricelist_id" ref="pricelist_standard"/>
        <field name="from_amount">10001.0</field>
        <field name="to_amount">50000.0</field>
        <field name="multiplier">1.5</field>
    </record>
    <record id="markup_50001" model="elevata.price.markup">
        <field name="pricelist_id" ref="pricelist_standard"/>
        <field name="from_amount">50001.0</field>
        <field name="to_amount">0.0</field>
        <field name="multiplier">1.4</field>
    </record>

</odoo>
