<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Premium: Modernisering, Serviceavtal och Nyinstallation (omslag + 3 innehållssidor) -->
    <template id="offer_doc_premium">
        <t t-set="otype" t-value="doc.offer_type"/>
        <t t-set="hero" t-value="doc.pdf_hero()"/>
        <t t-set="bgimg" t-value="{'modernisering': 'hero_installation.jpg', 'serviceavtal': 'control_repair.jpg'}.get(otype, 'cabin.jpg')"/>
        <t t-set="tech" t-value="doc.pdf_tech_rows()"/>
        <t t-set="facts" t-value="doc.pdf_facts()"/>
        <t t-set="sn" t-value="0"/>

        <div class="od">

            <!-- ══════════ SIDA 1: FÖRSÄTTSBLAD ══════════ -->
            <t t-call="elevata_offer.offer_pdf_cover"/>

            <!-- ══════════ SIDA 2: BAKGRUND OCH LÖSNING ══════════ -->
            <div class="sheet flow">
                <t t-call="elevata_offer.offer_pdf_header"/>
                <div class="pgbody">

                    <t t-if="otype == 'serviceavtal'">
                        <t t-set="sn" t-value="sn + 1"/>
                        <h2><span class="n" t-out="sn"/>Serviceinnehåll</h2>
                        <div class="rich sec" t-if="doc.pdf_html('content')" t-out="doc.pdf_html('content')"/>
                        <div class="imgcards">
                            <t t-foreach="doc.pdf_cards()" t-as="c">
                                <div class="imgcard keep"><img t-att-src="img4 + c['image']"/><b t-out="c['title']"/><span t-out="c['text']"/></div>
                            </t>
                        </div>
                        <div class="rich sec" t-if="doc.pdf_html('service_sections')" t-out="doc.pdf_html('service_sections')"/>
                    </t>

                    <t t-else="">
                        <t t-set="sn" t-value="sn + 1"/>
                        <h2><span class="n" t-out="sn"/>Bakgrund och förutsättningar</h2>
                        <div class="bgrow">
                            <img t-att-src="img4 + bgimg"/>
                            <table class="facts2" t-if="facts">
                                <t t-foreach="facts" t-as="f"><tr><td t-out="f['label']"/><td t-out="f['value']"/></tr></t>
                            </table>
                        </div>
                        <div class="rich sec" t-if="doc.pdf_html('content')" t-out="doc.pdf_html('content')"/>
                        <div class="rich sec" t-if="doc.pdf_html('background')" t-out="doc.pdf_html('background')"/>
                        <div class="rich sec" t-if="doc.pdf_html('scope_of_work')" t-out="doc.pdf_html('scope_of_work')"/>

                        <t t-set="sn" t-value="sn + 1"/>
                        <h2 style="margin-top:6mm"><span class="n" t-out="sn"/>Föreslagen lösning</h2>
                        <div class="rich sec" t-if="doc.pdf_html('modernization_proposal')" t-out="doc.pdf_html('modernization_proposal')"/>
                        <p class="muted" t-else="">Vi samordnar avtalade teknikområden med fastighetens förutsättningar.</p>
                        <div class="imgcards">
                            <t t-foreach="doc.pdf_cards()" t-as="c">
                                <div class="imgcard keep"><img t-att-src="img4 + c['image']"/><b t-out="c['title']"/><span t-out="c['text']"/></div>
                            </t>
                        </div>
                        <div class="goals keep">
                            <h3>Ett tydligt projekt från start</h3>
                            <ul>
                                <t t-foreach="doc.pdf_goals()" t-as="g">
                                    <li><t t-call="elevata_offer.offer_pdf_icon"><t t-set="icon" t-value="'check'"/></t><span t-out="g"/></li>
                                </t>
                            </ul>
                        </div>
                    </t>
                </div>
                <t t-call="elevata_offer.offer_pdf_footer"><t t-set="pg" t-value="2"/></t>
            </div>

            <!-- ══════════ SIDA 3: OMFATTNING, PRIS OCH TIDSPLAN/AVTALSVILLKOR ══════════ -->
            <div class="sheet flow">
                <t t-call="elevata_offer.offer_pdf_header"/>
                <div class="pgbody">

                    <t t-set="sn" t-value="sn + 1"/>
                    <div class="sec">
                        <t t-if="otype == 'serviceavtal'">
                            <h2><span class="n" t-out="sn"/>Hissar och pris</h2>
                            <t t-set="rows" t-value="doc.pdf_price_rows()"/>
                            <t t-set="amount_head" t-value="'Årsavgift exkl. moms'"/>
                            <t t-call="elevata_offer.offer_pdf_price_table"/>
                        </t>
                        <t t-else="">
                            <h2><span class="n" t-out="sn"/>Omfattning och pris</h2>
                            <t t-set="srows" t-value="doc.pdf_scope_rows()"/>
                            <t t-set="locs" t-value="list(dict.fromkeys(r['location'] for r in srows if r['location']))"/>
                            <p class="muted" t-if="len(locs) == 1"><b>Hiss:</b> <t t-out="locs[0]"/></p>
                            <table class="tb">
                                <thead><tr><th class="s">Pos</th><th>Benämning</th><th class="c">Antal</th><th>Enhet</th><th class="r">À-pris exkl. moms</th><th class="r">Summa exkl. moms</th></tr></thead>
                                <tbody>
                                    <t t-foreach="srows" t-as="r">
                                        <tr class="keep">
                                            <td class="s" t-out="r['pos']"/>
                                            <td><span t-out="r['label']"/><div class="muted" t-if="r['location'] and len(locs) &gt; 1" t-out="r['location']"/></td>
                                            <td class="c" t-out="r['qty']"/>
                                            <td t-out="r['unit']"/>
                                            <td class="r" t-out="doc.pdf_money(r['price'])"/>
                                            <td class="r" t-out="doc.pdf_money(r['amount'])"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div class="totband"><span>Summa exkl. moms</span><span t-out="doc.pdf_money(doc.amount_untaxed)"/></div>
                        </t>
                        <div class="pricenote">Alla priser anges exklusive moms. Priserna avser angiven omfattning och prisperiod. Tillägg avtalas separat.</div>
                    </div>

                    <t t-if="otype == 'serviceavtal'">
                        <t t-if="doc.pdf_hourly_rules()">
                            <div class="sec keep">
                                <h3>Timpriser vid behov (exkl. moms)</h3>
                                <div class="rates">
                                    <t t-foreach="doc.pdf_hourly_rules()" t-as="h">
                                        <div class="rate"><span t-out="h['label']"/><b t-out="doc.pdf_money(h['amount'])"/></div>
                                    </t>
                                </div>
                            </div>
                        </t>
                        <t t-set="sn" t-value="sn + 1"/>
                        <div class="sec keep">
                            <h2><span class="n" t-out="sn"/>Avtalsvillkor</h2>
                            <div class="facts">
                                <div class="fact"><span>Startdatum</span><b t-out="doc.contract_start_date"/></div>
                                <div class="fact"><span>Avtalstid</span><b t-out="dict(doc._fields['contract_years'].selection).get(doc.contract_years, '')"/></div>
                                <div class="fact"><span>Fakturering</span><b t-out="dict(doc._fields['billing_interval'].selection).get(doc.billing_interval, '')"/></div>
                                <div class="fact"><span>Betalningsvillkor</span><b t-out="doc.payment_term_id.name or '30 dagar netto'"/></div>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <t t-set="sn" t-value="sn + 1"/>
                        <div class="sec keep">
                            <h2><span class="n" t-out="sn"/>Tidsplan</h2>
                            <t t-call="elevata_offer.offer_pdf_steps"/>
                        </div>
                    </t>

                    <t t-set="sn" t-value="sn + 1"/>
                    <div class="sec keep">
                        <h2><span class="n" t-out="sn"/>Nästa steg</h2>
                        <t t-call="elevata_offer.offer_pdf_next"/>
                    </div>

                    <t t-if="otype != 'serviceavtal'">
                    <t t-set="sn" t-value="sn + 1"/>
                    <div class="sec keep">
                        <h2><span class="n" t-out="sn"/>Villkor i korthet</h2>
                        <div class="cards">
                            <t t-foreach="doc.pdf_terms_cards()" t-as="c">
                                <div class="card">
                                    <t t-call="elevata_offer.offer_pdf_icon"><t t-set="icon" t-value="c['icon']"/></t>
                                    <div><b t-out="c['title']"/><span t-out="c['text']"/></div>
                                </div>
                            </t>
                        </div>
                    </div>
                    </t>
                </div>
                <t t-call="elevata_offer.offer_pdf_footer"><t t-set="pg" t-value="3"/></t>
            </div>

            <!-- ══════════ SIDA 4: AVTALSBILAGA OCH GODKÄNNANDE ══════════ -->
            <t t-set="terms" t-value="doc.pdf_terms_sections()"/>
            <div class="sheet flow">
                <t t-call="elevata_offer.offer_pdf_header"/>
                <div class="pgbody">
                    <h2><span class="n"><t t-call="elevata_offer.offer_pdf_icon"><t t-set="icon" t-value="'file'"/></t></span>Avtalsbilaga</h2>

                    <div class="sec" t-if="tech and otype != 'serviceavtal'">
                        <h3>Teknisk beskrivning</h3>
                        <table class="tb">
                            <thead><tr><th style="width:44mm">Komponent</th><th>Beskrivning</th></tr></thead>
                            <tbody>
                                <t t-foreach="tech" t-as="row">
                                    <tr class="keep"><td class="nm" t-out="row['title']"/><td><div class="rich" t-out="row['html']"/></td></tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <div class="small" t-if="terms">
                        <div class="cols2">
                            <t t-foreach="terms" t-as="tm">
                                <div class="keep"><h3 t-out="tm['title']"/><div class="rich" t-out="tm['html']"/></div>
                            </t>
                        </div>
                    </div>
                    <p class="muted" t-if="not terms and not (tech and otype != 'serviceavtal')">Offertens villkor framgår av föregående sidor.</p>

                </div>
                <t t-call="elevata_offer.offer_pdf_footer"><t t-set="pg" t-value="4"/></t>
            </div>

            <!-- ══════════ TACKSIDA ══════════ -->
            <t t-call="elevata_offer.offer_pdf_thanks"/>

        </div>
    </template>

</odoo>
