#. module: elevata_offer
#: model:mail.template,body_html:elevata_offer.email_template_elevata_offer
msgid ""
"<div style=\"font-family:'Segoe UI',Arial,sans-serif;font-size:13px;color:#333;max-width:600px;margin:0 auto;\">\n"
"\n"
"  <p>Hej <t t-out=\"object.partner_id.name\"></t>,</p>\n"
"\n"
"  <p>\n"
"    Tack för ditt intresse. Vi bifogar härmed offert\n"
"    <strong><t t-out=\"object.name\"></t></strong>\n"
"    <t t-if=\"object.offer_type == 'serviceavtal'\"> avseende serviceavtal för era hissar</t>\n"
"    <t t-elif=\"object.offer_type == 'reparation'\"> avseende reparation/uppgradering</t>\n"
"    <t t-elif=\"object.offer_type == 'modernisering'\"> avseende modernisering</t>\n"
"    <t t-elif=\"object.offer_type == 'nyinstallation'\"> avseende nyinstallation</t>.\n"
"  </p>\n"
"\n"
"  <table style=\"width:100%;border-collapse:collapse;margin:16px 0;font-size:12px;\">\n"
"    <tr style=\"background:#f5f5f5;\">\n"
"      <td style=\"padding:8px 12px;color:#777;width:140px;\">Offertnummer</td>\n"
"      <td style=\"padding:8px 12px;font-weight:600;\"><t t-out=\"object.name\"></t></td>\n"
"    </tr>\n"
"    <tr>\n"
"      <td style=\"padding:8px 12px;color:#777;\">Datum</td>\n"
"      <td style=\"padding:8px 12px;\"><t t-out=\"object.date\"></t></td>\n"
"    </tr>\n"
"    <t t-if=\"object.validity_date\">\n"
"    <tr style=\"background:#f5f5f5;\">\n"
"      <td style=\"padding:8px 12px;color:#777;\">Giltig t.o.m.</td>\n"
"      <td style=\"padding:8px 12px;font-weight:600;\"><t t-out=\"object.validity_date\"></t></td>\n"
"    </tr>\n"
"    </t>\n"
"  </table>\n"
"\n"
"  <p>\n"
"    Offerten finns bifogad som PDF. Har du frågor eller vill godkänna offerten\n"
"    är du varmt välkommen att kontakta oss.\n"
"  </p>\n"
"\n"
"  <p style=\"margin-top:24px;\">\n"
"    Med vänliga hälsningar,<br>\n"
"    <strong><t t-out=\"object.user_id.name or object.company_id.name\"></t></strong><br>\n"
"    <t t-if=\"object.user_id.phone\">\n"
"      Tel: <t t-out=\"object.user_id.phone\"></t><br>\n"
"    </t>\n"
"    <t t-if=\"object.user_id.email\">\n"
"      E-post: <t t-out=\"object.user_id.email\"></t><br>\n"
"    </t>\n"
"    <t t-out=\"object.company_id.name\"></t>\n"
"  </p>\n"
"\n"
"</div>\n"
"        "
msgstr "<div style=\"font-family:'Segoe UI',Arial,sans-serif;font-size:13px;color:#333;max-width:600px;margin:0 auto;\">\\n\"\"\\n\"\"  <p>Hej <t t-out=\"object.partner_id.name\"></t>,</p>\\n\"\"\\n\"\"  <p>\\n\"\"    Tack för ditt intresse. Vi bifogar härmed offert\\n\"\"    <strong><t t-out=\"object.name\"></t></strong>\\n\"\"    <t t-if=\"object.offer_type == 'serviceavtal'\"> avseende serviceavtal för era hissar</t>\\n\"\"    <t t-elif=\"object.offer_type == 'reparation'\"> avseende reparation/uppgradering</t>\\n\"\"    <t t-elif=\"object.offer_type == 'modernisering'\"> avseende modernisering</t>\\n\"\"    <t t-elif=\"object.offer_type == 'nyinstallation'\"> avseende nyinstallation</t>.\\n\"\"  </p>\\n\"\"\\n\"\"  <table style=\"width:100%;border-collapse:collapse;margin:16px 0;font-size:12px;\">\\n\"\"    <tr style=\"background:#f5f5f5;\">\\n\"\"      <td style=\"padding:8px 12px;color:#777;width:140px;\">Offertnummer</td>\\n\"\"      <td style=\"padding:8px 12px;font-weight:600;\"><t t-out=\"object.name\"></t></td>\\n\"\"    </tr>\\n\"\"    <tr>\\n\"\"      <td style=\"padding:8px 12px;color:#777;\">Datum</td>\\n\"\"      <td style=\"padding:8px 12px;\"><t t-out=\"object.date\"></t></td>\\n\"\"    </tr>\\n\"\"    <t t-if=\"object.validity_date\">\\n\"\"    <tr style=\"background:#f5f5f5;\">\\n\"\"      <td style=\"padding:8px 12px;color:#777;\">Giltig t.o.m.</td>\\n\"\"      <td style=\"padding:8px 12px;font-weight:600;\"><t t-out=\"object.validity_date\"></t></td>\\n\"\"    </tr>\\n\"\"    </t>\\n\"\"  </table>\\n\"\"\\n\"\"  <p>\\n\"\"    Offerten finns bifogad som PDF. Har du frågor eller vill godkänna offerten\\n\"\"    är du varmt välkommen att kontakta oss.\\n\"\"  </p>\\n\"\"\\n\"\"  <p style=\"margin-top:24px;\">\\n\"\"    Med vänliga hälsningar,<br>\\n\"\"    <strong><t t-out=\"object.user_id.name or object.company_id.name\"></t></strong><br>\\n\"\"    <t t-if=\"object.user_id.phone\">\\n\"\"      Tel: <t t-out=\"object.user_id.phone\"></t><br>\\n\"\"    </t>\\n\"\"    <t t-if=\"object.user_id.email\">\\n\"\"      E-post: <t t-out=\"object.user_id.email\"></t><br>\\n\"\"    </t>\\n\"\"    <t t-out=\"object.company_id.name\"></t>\\n\"\"  </p>\\n\"\"\\n\"\"</div>\\n\"\"        "

