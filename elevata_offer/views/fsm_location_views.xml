<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fsm_location_offer_button" model="ir.ui.view">
        <field name="name">fsm.location.offer.button</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_offers" icon="fa-file-text-o"
                        invisible="offer_count == 0">
                    <field name="offer_count" widget="statinfo" string="Offerter"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
