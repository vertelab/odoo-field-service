<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- V6 editor: Offertrader först, sedan HTML-redigering, sedan PDF -->
    <record id="view_offer_editor_v6" model="ir.ui.view">
        <field name="name">elevata.offer.editor.v6</field>
        <field name="model">elevata.offer</field>
        <field name="inherit_id" ref="view_elevata_offer_form"/>
        <field name="arch" type="xml">
            <!-- Dölj flikar som ersätts av HTML-redigering -->
            <xpath expr="//page[@name='repair_scope']" position="attributes"><attribute name="invisible">True</attribute></xpath>
            <xpath expr="//page[@name='edit_content']" position="attributes"><attribute name="invisible">True</attribute></xpath>
            <xpath expr="//page[@name='tech_spec']" position="attributes"><attribute name="invisible">True</attribute></xpath>
            <xpath expr="//page[@name='repair_terms']" position="attributes"><attribute name="invisible">True</attribute></xpath>
            <xpath expr="//page[@name='content']" position="attributes"><attribute name="invisible">True</attribute></xpath>

            <!-- Dölj leveranstid-fält som flyttas till HTML-redigering -->
            <xpath expr="(//group/group/field[@name='delivery_time_info'])[1]" position="attributes"><attribute name="invisible">True</attribute></xpath>
            <xpath expr="(//group/group/field[@name='delivery_time_info'])[2]" position="attributes"><attribute name="invisible">True</attribute></xpath>
            <xpath expr="//group/group/field[@name='modernization_construction_time']" position="attributes"><attribute name="invisible">True</attribute></xpath>

            <!-- Visa template_id och design_version -->
            <xpath expr="//field[@name='template_id']" position="attributes">
                <attribute name="invisible">False</attribute>
                <attribute name="string">Vald mall</attribute>
            </xpath>

            <xpath expr="//field[@name='simple_layout']" position="attributes">
                <attribute name="string">Kompakt layout</attribute>
            </xpath>

            <!-- Offertrader är redan första fliken — bra -->

            <!-- Byt namn på PDF-fliken och ersätt innehållet -->
            <xpath expr="//page[@name='design_preview_page']" position="replace">
                <page string="HTML-redigering" name="html_edit_page">
                    <field name="report_html_url" widget="offer_html_editor" nolabel="1"/>
                </page>
                <page string="PDF" name="pdf_preview_page">
                    <field name="report_html_url" widget="offer_preview" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Mallformuläret: samma upplägg -->
    <record id="view_offer_template_editor_v6" model="ir.ui.view">
        <field name="name">elevata.offer.template.editor.v6</field>
        <field name="model">elevata.offer.template</field>
        <field name="inherit_id" ref="view_offer_template_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='template_scope']" position="attributes"><attribute name="invisible">True</attribute></xpath>
            <xpath expr="//page[@name='template_tech_spec']" position="attributes"><attribute name="invisible">True</attribute></xpath>
            <xpath expr="//page[@name='template_terms']" position="attributes"><attribute name="invisible">True</attribute></xpath>
            <xpath expr="//field[@name='delivery_time_info']" position="attributes"><attribute name="invisible">True</attribute></xpath>
            <xpath expr="//field[@name='modernization_construction_time']" position="attributes"><attribute name="invisible">True</attribute></xpath>
            <xpath expr="//field[@name='simple_layout']" position="attributes"><attribute name="string">Kompakt layout</attribute></xpath>

            <!-- Lägg till HTML-redigering i notebook -->
            <xpath expr="//page[@name='template_design']" position="replace">
                <page string="HTML-redigering" name="template_html_edit">
                    <group>
                        <group string="Layoutinställningar">
                            <field name="design_version"/>
                            <field name="cover_image" widget="image" filename="cover_image_filename"
                                   options="{'accepted_file_extensions': '.jpg,.jpeg,.png,.webp'}"/>
                            <field name="cover_image_filename" invisible="1"/>
                            <field name="accent_color" placeholder="#2F4560"/>
                        </group>
                        <group string="Planering">
                            <field name="estimated_days"/>
                        </group>
                    </group>
                    <separator string="Textavsnitt"/>
                    <field name="offer_title" widget="offer_text_editor" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
