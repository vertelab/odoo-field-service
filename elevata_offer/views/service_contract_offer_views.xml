<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Lägg till Offert-flik på serviceavtalet -->
    <record id="view_service_contract_form_offer" model="ir.ui.view">
        <field name="name">elevata.service.contract.form.offer</field>
        <field name="model">elevata.service.contract</field>
        <field name="inherit_id" ref="elevata_service_contract.view_service_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='template_history']" position="before">
                <page string="Offert" name="offer_page" invisible="not offer_id">
                    <group>
                        <group>
                            <field name="offer_id" string="Offert"/>
                        </group>
                        <group>
                            <div>
                                <button name="action_open_offer_pdf" string="Öppna offert-PDF"
                                        type="object" class="btn btn-primary btn-sm"
                                        icon="fa-file-pdf-o"/>
                            </div>
                        </group>
                    </group>
                    <field name="offer_pdf_url" widget="offer_preview" nolabel="1"
                           invisible="not offer_pdf_url"/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
