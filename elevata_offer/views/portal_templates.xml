<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- PORTAL: Lägg till "Offerter" på startsidan          -->
    <!-- ═══════════════════════════════════════════════════ -->
    <template id="portal_my_home_offer" name="Portal My Home – Offerter"
              inherit_id="portal.portal_my_home"
              priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/elevata_offer/static/src/img/icon_offer.svg'"/>
                <t t-set="title">Offerter</t>
                <t t-set="url" t-value="'/my/offers'"/>
                <t t-set="text">Visa och hantera dina offerter</t>
                <t t-set="placeholder_count" t-value="'offer_count'"/>
            </t>
        </div>
    </template>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- PORTAL: Lista – Mina offerter                      -->
    <!-- ═══════════════════════════════════════════════════ -->
    <template id="portal_my_offers" name="My Offers">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Offerter</t>
            </t>

            <t t-if="not offers">
                <div class="alert alert-warning mt-3" role="alert">
                    Det finns inga offerter att visa just nu.
                </div>
            </t>

            <t t-if="offers" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Offertnummer</th>
                        <th>Typ</th>
                        <th>Datum</th>
                        <th>Giltig t.o.m.</th>
                        <th class="text-end">Belopp</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="offers" t-as="offer">
                        <tr>
                            <td>
                                <a t-att-href="'/my/offer/%s' % offer.id">
                                    <t t-esc="offer.name"/>
                                </a>
                            </td>
                            <td><t t-esc="offer.offer_type"/></td>
                            <td><t t-esc="offer.date"/></td>
                            <td><t t-esc="offer.validity_date"/></td>
                            <td class="text-end">
                                <t t-esc="'%.0f' % offer.amount_untaxed"/> <t t-esc="offer.currency_id.symbol"/>
                            </td>
                            <td>
                                <span t-attf-class="badge rounded-pill
                                    #{offer.state == 'won' and 'text-bg-success' or ''}
                                    #{offer.state == 'lost' and 'text-bg-danger' or ''}
                                    #{offer.state in ('sent','negotiation') and 'text-bg-warning' or ''}
                                    #{offer.state == 'draft' and 'text-bg-info' or ''}">
                                    <t t-esc="offer.state"/>
                                </span>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- PORTAL: Detalj – Offert                            -->
    <!-- ═══════════════════════════════════════════════════ -->
    <template id="portal_offer_detail" name="Offer Detail">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert" groups="base.group_user">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backend_url" t-value="'/web#model=elevata.offer&amp;id=%s' % offer.id"/>
                </t>
            </t>

            <div class="container mt-4">
                <div class="row mb-4">
                    <div class="col-12">
                        <h2>
                            Offert <t t-esc="offer.name"/>
                            <span t-attf-class="badge rounded-pill ms-2
                                #{offer.state == 'won' and 'text-bg-success' or ''}
                                #{offer.state == 'lost' and 'text-bg-danger' or ''}
                                #{offer.state in ('sent','negotiation') and 'text-bg-warning' or ''}
                                #{offer.state == 'draft' and 'text-bg-info' or ''}">
                                <t t-esc="offer.state"/>
                            </span>
                        </h2>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <table class="table table-sm">
                            <tr>
                                <td class="text-muted" style="width:140px;">Typ</td>
                                <td><t t-esc="offer.offer_type"/></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Kund</td>
                                <td><t t-esc="offer.partner_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Datum</td>
                                <td><t t-esc="offer.date"/></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Giltig t.o.m.</td>
                                <td><t t-esc="offer.validity_date"/></td>
                            </tr>
                            <tr t-if="offer.user_id">
                                <td class="text-muted">Ansvarig</td>
                                <td><t t-esc="offer.user_id.name"/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Offertrader -->
                <t t-if="offer.line_ids">
                    <h4>Offertrader</h4>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Hiss</th>
                                <th>Beskrivning</th>
                                <th class="text-end">À-pris</th>
                                <th class="text-end">Delsumma</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="offer.line_ids" t-as="line">
                                <tr>
                                    <td><t t-esc="line.equipment_id.name or ''"/></td>
                                    <td><t t-esc="line.name or ''"/></td>
                                    <td class="text-end"><t t-esc="'%.0f' % line.price_unit"/> <t t-esc="offer.currency_id.symbol"/></td>
                                    <td class="text-end"><t t-esc="'%.0f' % line.price_subtotal"/> <t t-esc="offer.currency_id.symbol"/></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end"><strong>Summa exkl. moms</strong></td>
                                <td class="text-end"><strong><t t-esc="'%.0f' % offer.amount_untaxed"/> <t t-esc="offer.currency_id.symbol"/></strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </t>

                <!-- Offerttext -->
                <t t-if="offer.content">
                    <h4 class="mt-4">Offerttext</h4>
                    <div t-raw="offer.content"/>
                </t>

                <!-- Acceptera-knapp -->
                <div class="mt-4 mb-5" t-if="offer.state in ('sent','negotiation')">
                    <form t-att-action="'/my/offer/%s/accept' % offer.id" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <button type="submit" class="btn btn-primary btn-lg">
                            Acceptera offert
                        </button>
                    </form>
                </div>
            </div>
        </t>
    </template>

</odoo>
