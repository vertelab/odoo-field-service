<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- FORM VIEW                                          -->
    <!-- ═══════════════════════════════════════════════════ -->
    <record id="view_elevata_offer_form" model="ir.ui.view">
        <field name="name">elevata.offer.form</field>
        <field name="model">elevata.offer</field>
        <field name="arch" type="xml">
            <form string="Offert">
                <header>
                    <button name="action_send" string="Skicka offert" type="object"
                            class="oe_highlight"
                            invisible="state not in ['draft','sent','negotiation']"/>
                    <button name="action_negotiation" string="Förhandling" type="object"
                            invisible="state != 'sent'"/>
                    <button name="action_new_version" string="Ny version" type="object"
                            invisible="state != 'negotiation'"/>
                    <button name="action_won" string="Markera som vunnen" type="object"
                            class="oe_highlight"
                            invisible="state not in ['sent','negotiation']"/>
                    <button name="action_lost" string="Markera som förlorad" type="object"
                            invisible="state not in ['sent','negotiation']"/>
                    <button name="action_reset_draft" string="Återställ till utkast" type="object"
                            invisible="state not in ['lost','expired']"/>
                    <button name="action_preview" string="Förhandsgranska" type="object"
                            icon="fa-eye"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,negotiation,won,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_service_contract"
                                icon="fa-file-text-o"
                                invisible="not service_contract_id">
                            <field name="service_contract_count" widget="statinfo" string="Serviceavtal"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_fsm_orders"
                                icon="fa-wrench"
                                invisible="fsm_order_count == 0">
                            <field name="fsm_order_count" widget="statinfo" string="Arbetsordrar"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_versions"
                                icon="fa-history"
                                invisible="version_count == 0">
                            <field name="version_count" widget="statinfo" string="Revisioner"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_milestones"
                                icon="fa-money"
                                invisible="milestone_count == 0"
                                groups="fieldservice_vrtl.fieldservice_group_sales,fieldservice_vrtl.fieldservice_group_manager">
                            <field name="milestone_invoiced_pct" widget="percentpie" string="Fakturerat"/>
                        </button>
                    </div>
                    <field name="service_contract_id" invisible="1"/>
                    <field name="milestone_count" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                            <span invisible="version &lt;= 1"
                                  style="font-size:14px;font-weight:normal;color:#888;margin-left:8px;">
                                v<field name="version" readonly="1" nolabel="1"
                                        style="display:inline;"/>
                            </span>
                        </h1>
                        <div invisible="not parent_id" style="font-size:12px;color:#999;margin-top:2px;">
                            Revision av: <field name="parent_id" readonly="1" nolabel="1"/>
                        </div>
                        <field name="offer_title" class="mt-1"
                               placeholder="Rubrik på offerten, t.ex. Byte av hisslinor (valfritt)"
                               readonly="state in ['won','lost']"/>
                    </div>
                    <group>
                        <group name="left">
                            <field name="offer_type" readonly="state in ['won','lost']"/>
                            <field name="template_id" readonly="1" invisible="not template_id"/>
                            <field name="partner_id" readonly="state in ['won','lost']"/>
                        </group>
                        <group name="right">
                            <field name="date"/>
                            <field name="validity_days" string="Giltighetstid (dagar)"/>
                            <field name="validity_date" readonly="1" string="Giltig t.o.m."/>
                            <field name="user_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <group invisible="offer_type != 'serviceavtal'">
                        <group string="Serviceavtals-inställningar" name="contract_settings">
                            <field name="contract_start_date" string="Startdatum"/>
                            <field name="contract_years" string="Avtalsår"/>
                            <field name="billing_interval" string="Faktureringsintervall"/>
                            <field name="payment_term_id" string="Betalningsvillkor"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>

                    <group invisible="offer_type != 'reparation'">
                        <group string="Reparationsvillkor">
                            <field name="warranty_years" string="Garantitid"/>
                            <field name="repair_payment_structure" string="Betalningsstruktur"/>
                            <field name="delivery_time_info" string="Leveranstid"
                                   placeholder='T.ex. "Ca 8 arbetsveckor från erhållen beställning"'/>
                            <field name="simple_layout" string="Enkel offert (1 sida)"/>
                        </group>
                    </group>

                    <group invisible="offer_type != 'modernisering'">
                        <group string="Moderniseringsinställningar">
                            <field name="warranty_years" string="Garantitid"/>
                            <field name="repair_payment_structure" string="Betalningsstruktur"/>
                            <field name="delivery_time_info" string="Leveranstid"
                                   placeholder='T.ex. "Ca 14 arbetsveckor från erhållen beställning"'/>
                            <field name="modernization_construction_time" string="Ombyggnadstid"
                                   placeholder='T.ex. "Ca 10 arbetsdagar / hiss"'/>
                        </group>
                    </group>

                    <div invisible="offer_type not in ('reparation','serviceavtal','modernisering','nyinstallation') or state in ['won','lost']">
                        <button name="action_load_template" string="Ladda mall"
                                type="object" class="btn btn-primary btn-sm"
                                icon="fa-magic"
                                help="Fyller i alla fält från en fördefinierad mall"/>
                        <button name="action_save_as_template" string="Spara som mall"
                                type="object" class="btn btn-secondary btn-sm ms-2"
                                icon="fa-floppy-o"
                                help="Sparar offertens texter och rader som en ny mall"
                                confirm="Skapa en ny offertmall baserad på denna offert?"/>
                    </div>

                    <notebook>
                        <page string="Uppdrag" name="repair_scope"
                              invisible="offer_type not in ('reparation','serviceavtal','modernisering')">
                            <group invisible="offer_type != 'reparation'">
                                <group string="Bakgrund">
                                    <field name="background" nolabel="1" colspan="2"
                                           placeholder="Varför behövs reparationen? Beskriv felanmälan, besiktningsanmärkning eller slitage..."
                                           readonly="state in ['won','lost']"/>
                                </group>
                                <group string="Planering">
                                    <field name="estimated_start" string="Planerad start"/>
                                    <field name="estimated_days" string="Uppskattad tid (dagar)"/>
                                    <field name="downtime_info" string="Driftstopp"
                                           placeholder="Förväntad påverkan på hissens tillgänglighet..."/>
                                </group>
                            </group>
                            <group string="Arbetsbeskrivning"
                                   invisible="offer_type != 'reparation'">
                                <field name="scope_of_work" nolabel="1" colspan="2"
                                       placeholder="Detaljerad teknisk specifikation av vad som ska utföras..."
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group string="Uppdragsbeskrivning"
                                   invisible="offer_type != 'serviceavtal'">
                                <field name="content" nolabel="1" colspan="2"
                                       placeholder="Beskriv vad serviceavtalet omfattar..."
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group invisible="offer_type != 'modernisering'">
                                <group string="Bakgrund och behov">
                                    <field name="background" nolabel="1" colspan="2"
                                           placeholder="Varför behövs moderniseringen? Beskriv åldersstigen utrustning, lagkrav, energiförbrukning..."
                                           readonly="state in ['won','lost']"/>
                                </group>
                                <group string="Planering">
                                    <field name="estimated_start" string="Planerad start"/>
                                    <field name="estimated_days" string="Uppskattad tid (dagar)"/>
                                    <field name="downtime_info" string="Driftstopp"
                                           placeholder="Förväntad påverkan på hissens tillgänglighet..."/>
                                </group>
                            </group>
                            <group string="Vårt förslag"
                                   invisible="offer_type != 'modernisering'">
                                <field name="modernization_proposal" nolabel="1" colspan="2"
                                       placeholder="Övergripande lösningsbeskrivning — vad innebär moderniseringen?"
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group string="Besiktning"
                                   invisible="offer_type != 'modernisering'">
                                <field name="modernization_inspection_note" nolabel="1" colspan="2"
                                       placeholder="Vem ombesörjer och bekostar besiktning, anmälningar till myndigheter..."
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group string="Kvalitet och Miljö"
                                   invisible="offer_type != 'modernisering'">
                                <field name="modernization_quality_env" nolabel="1" colspan="2"
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group string="Förtydliganden &amp; Reservationer"
                                   invisible="offer_type != 'modernisering'">
                                <field name="modernization_reservations" nolabel="1" colspan="2"
                                       readonly="state in ['won','lost']"/>
                            </group>
                        </page>
                        <page string="Redigera" name="edit_content"
                              invisible="offer_type != 'serviceavtal'">
                            <div class="mb-3" invisible="state in ['won','lost']">
                                <button name="action_insert_default_service_sections"
                                        string="Återställ standardinnehåll (sida 2)"
                                        type="object" class="btn btn-secondary btn-sm me-2"
                                        icon="fa-refresh"/>
                                <button name="action_insert_default_content"
                                        string="Återställ offerttext (sida 3)"
                                        type="object" class="btn btn-secondary btn-sm"
                                        icon="fa-refresh"/>
                            </div>
                            <group string="Sida 2 — Avtalets innehåll (vad ingår)">
                                <field name="service_sections" nolabel="1" colspan="2"
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group string="Sida 3 — Offerttext / villkor">
                                <field name="content" nolabel="1" colspan="2"
                                       readonly="state in ['won','lost']"/>
                            </group>
                        </page>
                        <page string="Offertrader" name="lines">
                            <field name="offer_type" invisible="1"/>
                            <field name="line_ids" readonly="state in ['won','lost']">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="equipment_id" string="Hiss"/>
                                    <!-- Serviceavtal-kolumner -->
                                    <field name="contract_type_selection"
                                           column_invisible="parent.offer_type != 'serviceavtal'"/>
                                    <field name="visits_per_year"
                                           column_invisible="parent.offer_type != 'serviceavtal'"/>
                                    <!-- Typ (synlig för alla typer) -->
                                    <field name="line_type"/>
                                    <field name="rate_type" optional="show"
                                           column_invisible="parent.offer_type not in ['serviceavtal','reparation']"
                                           string="Tidtyp"/>
                                    <field name="product_id" optional="show"
                                           column_invisible="parent.offer_type == 'serviceavtal'"/>
                                    <field name="quantity"
                                           column_invisible="parent.offer_type == 'serviceavtal'"/>
                                    <field name="uom_id" optional="show"
                                           column_invisible="parent.offer_type == 'serviceavtal'"/>
                                    <!-- Alltid synliga -->
                                    <field name="name"/>
                                    <field name="list_price" optional="show"
                                           column_invisible="parent.offer_type != 'serviceavtal'"
                                           string="Std.pris"/>
                                    <field name="discount" optional="show"
                                           column_invisible="parent.offer_type != 'serviceavtal'"
                                           string="Rabatt %"/>
                                    <field name="price_unit"/>
                                    <field name="saving" readonly="1" optional="show"
                                           column_invisible="parent.offer_type != 'serviceavtal'"/>
                                    <field name="price_subtotal" readonly="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_untaxed" string="Totalt exkl. moms"
                                       widget="monetary" options="{'currency_field':'currency_id'}"
                                       class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Prisregler" name="price_rules"
                              invisible="offer_type != 'serviceavtal'">
                            <div class="mb-2" invisible="state in ['won','lost']">
                                <button name="action_load_standard_prices" string="Hämta standardpriser från prislistan"
                                        type="object" class="btn btn-secondary btn-sm"
                                        icon="fa-download"
                                        help="Skapar timprisregler automatiskt baserat på kundens prislista"/>
                            </div>
                            <field name="price_rule_ids" readonly="state in ['won','lost']">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="rule_type"/>
                                    <field name="equipment_id" string="Hiss"
                                           optional="show"/>
                                    <field name="rate_type"/>
                                    <field name="contract_type"/>
                                    <field name="price" string="Pris (kr)"/>
                                    <field name="discount_pct" string="Rabatt %"/>
                                    <field name="is_included"/>
                                    <field name="note" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Teknisk beskrivning" name="tech_spec"
                              invisible="offer_type != 'modernisering'">
                            <group string="Allmänt">
                                <field name="tech_general" nolabel="1" colspan="2"
                                       placeholder="Kretsschema, apparatlista, instruktioner, skyltar..."
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group string="Automatdörrar schakt">
                                <field name="tech_doors" nolabel="1" colspan="2"
                                       placeholder="Dörrblad, dagermått, nedre dörrstyrningar..."
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group string="Maskinrum">
                                <field name="tech_machine_room" nolabel="1" colspan="2"
                                       placeholder="Drivsystem, hydraultank, elinstallation..."
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group string="Schakt">
                                <field name="tech_shaft" nolabel="1" colspan="2"
                                       placeholder="Schaktutrustning, korgkablar, schaktbelysning..."
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group string="Hisskorg">
                                <field name="tech_car" nolabel="1" colspan="2"
                                       placeholder="Korgdörrar, ljusridå, nödbelysning..."
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group string="Apparatställ">
                                <field name="tech_control_panel" nolabel="1" colspan="2"
                                       placeholder="Modell, drivsystem, manöversystem, dörrsystem, spänning..."
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group string="Signalisering / Tablåer">
                                <field name="tech_signalization" nolabel="1" colspan="2"
                                       placeholder="Anropstablåer, korgtablå, våningsvisare..."
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group string="Optioner">
                                <field name="tech_options" nolabel="1" colspan="2"
                                       placeholder="Tillval och optioner..."
                                       readonly="state in ['won','lost']"/>
                            </group>
                        </page>
                        <page string="Villkor" name="repair_terms"
                              invisible="offer_type not in ('reparation','serviceavtal','modernisering')">
                            <group string="Garantivillkor">
                                <field name="warranty_terms" nolabel="1" colspan="2"
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group string="Betalningsvillkor">
                                <field name="payment_terms_text" nolabel="1" colspan="2"
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group string="Allmänna villkor">
                                <field name="terms_conditions" nolabel="1" colspan="2"
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group string="Leveranstid">
                                <field name="delivery_time" nolabel="1" colspan="2"
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group string="Leveransvillkor">
                                <field name="delivery_terms" nolabel="1" colspan="2"
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group string="Ingår ej">
                                <field name="not_included" nolabel="1" colspan="2"
                                       readonly="state in ['won','lost']"/>
                            </group>
                            <group string="CE / Myndighetskrav" name="ce_group">
                                <field name="ce_compliance_note" nolabel="1" colspan="2"
                                       placeholder="CE-märkning eller andra myndighetskrav (valfritt)..."
                                       readonly="state in ['won','lost']"/>
                            </group>
                        </page>
                        <page string="Offerttext" name="content"
                              invisible="offer_type in ('reparation','serviceavtal')">
                            <div class="mb-2" invisible="state in ['won','lost']">
                                <button name="action_insert_default_content" string="Infoga standardtext"
                                        type="object" class="btn btn-secondary btn-sm"
                                        icon="fa-file-text-o"/>
                            </div>
                            <field name="content" readonly="state in ['won','lost']"/>
                        </page>
                        <page string="Betalningsplan" name="milestones"
                              invisible="offer_type not in ('reparation','modernisering','nyinstallation') or state != 'won'">
                            <div class="mb-2"
                                 groups="fieldservice_vrtl.fieldservice_group_sales,fieldservice_vrtl.fieldservice_group_manager">
                                <button name="action_invoice_next_milestone"
                                        string="Fakturera nästa milstolpe"
                                        type="object" class="btn btn-primary btn-sm"
                                        icon="fa-file-text-o"
                                        invisible="milestone_invoiced_pct &gt;= 100"/>
                            </div>
                            <field name="milestone_ids" readonly="1">
                                <list decoration-success="state == 'paid'"
                                      decoration-info="state == 'invoiced'"
                                      decoration-muted="state == 'pending'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="percentage" string="%"/>
                                    <field name="amount" sum="Totalt"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'paid'"
                                           decoration-info="state == 'invoiced'"
                                           decoration-warning="state == 'pending'"/>
                                    <field name="invoice_id" optional="show"/>
                                    <field name="invoice_state" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="PDF" name="design_preview_page">
                            <field name="report_html_url" widget="offer_preview" nolabel="1"/>
                        </page>
                        <page string="Övrigt" name="other" invisible="state != 'lost'">
                            <group>
                                <field name="lost_reason"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- TREE VIEW                                          -->
    <!-- ═══════════════════════════════════════════════════ -->
    <record id="view_elevata_offer_tree" model="ir.ui.view">
        <field name="name">elevata.offer.tree</field>
        <field name="model">elevata.offer</field>
        <field name="arch" type="xml">
            <list string="Offerter" decoration-success="state == 'won'"
                  decoration-danger="state == 'lost'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="offer_type"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="validity_date" optional="show"/>
                <field name="amount_untaxed" string="Belopp (exkl. moms)"/>
                <field name="user_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'won'"
                       decoration-danger="state == 'lost'"
                       decoration-warning="state in ['sent','negotiation']"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SEARCH VIEW                                        -->
    <!-- ═══════════════════════════════════════════════════ -->
    <record id="view_elevata_offer_search" model="ir.ui.view">
        <field name="name">elevata.offer.search</field>
        <field name="model">elevata.offer</field>
        <field name="arch" type="xml">
            <search string="Sök offerter">
                <field name="name" string="Offertnummer"/>
                <field name="partner_id" string="Kund"/>
                <separator/>
                <filter name="draft" string="Utkast" domain="[('state','=','draft')]"/>
                <filter name="sent" string="Skickade" domain="[('state','=','sent')]"/>
                <filter name="negotiation" string="Förhandling" domain="[('state','=','negotiation')]"/>
                <filter name="won" string="Vunna" domain="[('state','=','won')]"/>
                <filter name="lost" string="Förlorade" domain="[('state','=','lost')]"/>
                <separator/>
                <filter name="serviceavtal" string="Serviceavtal" domain="[('offer_type','=','serviceavtal')]"/>
                <filter name="reparation" string="Reparation / Uppgradering" domain="[('offer_type','=','reparation')]"/>
                <filter name="modernisering" string="Modernisering" domain="[('offer_type','=','modernisering')]"/>
                <filter name="nyinstallation" string="Nyinstallation" domain="[('offer_type','=','nyinstallation')]"/>
                <separator/>
                <filter name="billing_not_invoiced" string="Ej fakturerad" domain="[('billing_state','=','not_invoiced')]"/>
                <filter name="billing_partial" string="Delvis fakturerad" domain="[('billing_state','=','partially_invoiced')]"/>
                <filter name="billing_full" string="Slutfakturerad" domain="[('billing_state','=','fully_invoiced')]"/>
                <filter name="billing_paid" string="Slutbetald" domain="[('billing_state','=','paid')]"/>
                <separator/>
                <group expand="1" string="Gruppera">
                    <filter name="group_type" string="Offerttyp" context="{'group_by': 'offer_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_billing" string="Betalningsstatus" context="{'group_by': 'billing_state'}"/>
                    <filter name="group_partner" string="Kund" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_user" string="Ansvarig" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- PROJEKTUPPFÖLJNING - TREE VIEW                     -->
    <!-- ═══════════════════════════════════════════════════ -->
    <record id="view_elevata_offer_project_tree" model="ir.ui.view">
        <field name="name">elevata.offer.project.tree</field>
        <field name="model">elevata.offer</field>
        <field name="arch" type="xml">
            <list string="Projektuppföljning"
                  decoration-success="billing_state == 'paid'"
                  decoration-info="billing_state == 'fully_invoiced'"
                  decoration-warning="billing_state == 'partially_invoiced'"
                  decoration-muted="billing_state == 'not_invoiced'">
                <field name="name" string="Offert"/>
                <field name="partner_id" string="Kund"/>
                <field name="offer_type" string="Typ"/>
                <field name="user_id" string="Ansvarig" widget="many2one_avatar_user"/>
                <field name="amount_untaxed" string="Belopp (ex moms)" sum="Totalt"/>
                <field name="milestone_count" string="Milstolpar"/>
                <field name="milestone_invoiced_pct" string="Fakturerat %" widget="progressbar"/>
                <field name="milestone_paid_pct" string="Betalt %" widget="progressbar"/>
                <field name="billing_state" string="Status" widget="badge"
                       decoration-success="billing_state == 'paid'"
                       decoration-info="billing_state == 'fully_invoiced'"
                       decoration-warning="billing_state == 'partially_invoiced'"
                       decoration-danger="billing_state == 'not_invoiced'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- PROJEKTUPPFÖLJNING - KANBAN VIEW                   -->
    <!-- ═══════════════════════════════════════════════════ -->
    <record id="view_elevata_offer_project_kanban" model="ir.ui.view">
        <field name="name">elevata.offer.project.kanban</field>
        <field name="model">elevata.offer</field>
        <field name="arch" type="xml">
            <kanban default_group_by="billing_state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="offer_type"/>
                <field name="amount_untaxed"/>
                <field name="milestone_invoiced_pct"/>
                <field name="milestone_paid_pct"/>
                <field name="billing_state"/>
                <field name="user_id"/>
                <field name="currency_id"/>
                <progressbar field="billing_state" colors='{"not_invoiced": "danger", "partially_invoiced": "warning", "fully_invoiced": "info", "paid": "success"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click oe_kanban_card">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="o_kanban_record_top_right">
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="partner_id"/>
                                    <div class="text-muted">
                                        <field name="offer_type"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <strong>
                                            <field name="amount_untaxed" widget="monetary"
                                                   options="{'currency_field': 'currency_id'}"/>
                                        </strong>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span t-if="record.milestone_invoiced_pct.raw_value"
                                              class="badge rounded-pill text-bg-info"
                                              style="font-size:11px;">
                                            Fakt: <field name="milestone_invoiced_pct"/>%
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- KANBAN VIEW                                        -->
    <!-- ═══════════════════════════════════════════════════ -->
    <record id="view_elevata_offer_kanban" model="ir.ui.view">
        <field name="name">elevata.offer.kanban</field>
        <field name="model">elevata.offer</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="offer_type"/>
                <field name="amount_untaxed"/>
                <field name="validity_date"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card
                            #{record.state.raw_value == 'won' ? 'oe_kanban_color_10' : ''}
                            #{record.state.raw_value == 'lost' ? 'oe_kanban_color_1' : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="o_kanban_record_top_right">
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="partner_id"/>
                                    <div class="text-muted">
                                        <field name="offer_type"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <strong>
                                            <field name="amount_untaxed" widget="monetary"
                                                   options="{'currency_field': 'currency_id'}"/>
                                        </strong>
                                    </div>
                                    <div class="oe_kanban_bottom_right text-muted" style="font-size:11px;">
                                        <t t-if="record.validity_date.raw_value">
                                            Giltig t.o.m. <field name="validity_date"/>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- PIVOT VIEW                                         -->
    <!-- ═══════════════════════════════════════════════════ -->
    <record id="view_elevata_offer_pivot" model="ir.ui.view">
        <field name="name">elevata.offer.pivot</field>
        <field name="model">elevata.offer</field>
        <field name="arch" type="xml">
            <pivot string="Offertstatistik" display_quantity="1">
                <field name="offer_type" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_untaxed" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- GRAPH VIEW                                         -->
    <!-- ═══════════════════════════════════════════════════ -->
    <record id="view_elevata_offer_graph" model="ir.ui.view">
        <field name="name">elevata.offer.graph</field>
        <field name="model">elevata.offer</field>
        <field name="arch" type="xml">
            <graph string="Offerter per typ och status" type="bar" stacked="1">
                <field name="offer_type" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_untaxed" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ACTION                                             -->
    <!-- ═══════════════════════════════════════════════════ -->
    <record id="action_elevata_offer" model="ir.actions.act_window">
        <field name="name">Offerter</field>
        <field name="res_model">elevata.offer</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_elevata_offer_search"/>
        <field name="context">{}</field>
    </record>

</odoo>
