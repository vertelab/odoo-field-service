<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- PRICELIST FORM                                     -->
    <!-- ═══════════════════════════════════════════════════ -->
    <record id="view_elevata_pricelist_form" model="ir.ui.view">
        <field name="name">elevata.pricelist.form</field>
        <field name="model">elevata.pricelist</field>
        <field name="arch" type="xml">
            <form string="Prislista">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="currency_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="subscription_price"/>
                            <field name="inspection_price"/>
                            <field name="admin_fee_percent"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Avtalspriser" name="rules">
                            <field name="rule_ids">
                                <list editable="bottom">
                                    <field name="contract_type"/>
                                    <field name="visits_per_year"/>
                                    <field name="price"/>
                                    <field name="note" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Timpriser / Avgifter" name="rates">
                            <field name="rate_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="rate_type"/>
                                    <field name="price"/>
                                    <field name="note" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Materialpåslag" name="markups">
                            <field name="markup_ids">
                                <list editable="bottom">
                                    <field name="from_amount"/>
                                    <field name="to_amount"/>
                                    <field name="multiplier"/>
                                    <field name="note" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- PRICELIST TREE                                     -->
    <!-- ═══════════════════════════════════════════════════ -->
    <record id="view_elevata_pricelist_tree" model="ir.ui.view">
        <field name="name">elevata.pricelist.tree</field>
        <field name="model">elevata.pricelist</field>
        <field name="arch" type="xml">
            <list string="Prislistor">
                <field name="name"/>
                <field name="currency_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- PRICELIST ACTION                                   -->
    <!-- ═══════════════════════════════════════════════════ -->
    <record id="action_elevata_pricelist" model="ir.actions.act_window">
        <field name="name">Prislistor</field>
        <field name="res_model">elevata.pricelist</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- RES.PARTNER: Prislista-fält                        -->
    <!-- ═══════════════════════════════════════════════════ -->
    <record id="view_partner_pricelist_elevata" model="ir.ui.view">
        <field name="name">res.partner.elevata.pricelist</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_payment_term_id']" position="after">
                <field name="elevata_pricelist_id"
                       string="Elevata Prislista"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
