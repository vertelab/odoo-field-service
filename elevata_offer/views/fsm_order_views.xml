<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fsm_order_elevata_milestone_button" model="ir.ui.view">
        <field name="name">fsm.order.elevata.milestone.button</field>
        <field name="model">fieldservice.order</field>
        <field name="inherit_id" ref="elevata_fsm_flow.fsm_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="elevata_milestone_count" invisible="1"/>
                <button class="oe_stat_button" type="object"
                        name="action_view_elevata_milestones"
                        icon="fa-money"
                        invisible="elevata_milestone_count == 0"
                        groups="elevata_base.group_sales,elevata_base.group_manager">
                    <field name="elevata_milestone_invoiced_pct" widget="percentpie" string="Fakturerat"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
