<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <!-- ═══ PDF-flik ═══ -->
    <t t-name="elevata_offer.OfferPreviewWidget">
        <div class="o_offer_pdf_preview">
            <div class="d-flex flex-wrap gap-2 mb-2">
                <button type="button" t-on-click="loadPreview" class="btn btn-primary" t-att-disabled="state.loading">
                    <i t-if="state.loading" class="fa fa-spinner fa-spin me-1"/>
                    <t t-if="state.loading">Skapar PDF…</t>
                    <t t-else="">Generera PDF</t>
                </button>
                <a t-if="state.url" t-att-href="state.url" t-att-download="state.filename" class="btn btn-outline-secondary">
                    <i class="fa fa-download me-1"/>Ladda ner
                </a>
                <a t-if="state.url" t-att-href="state.url" target="_blank" rel="noopener" class="btn btn-outline-secondary">
                    <i class="fa fa-external-link me-1"/>Nytt fönster
                </a>
            </div>
            <p class="text-muted small">Sparar och genererar riktig PDF — samma fil som skickas vid e-post.</p>
            <div t-if="state.error" role="alert" class="alert alert-danger" t-esc="state.error"/>
            <iframe t-if="state.url" t-att-src="state.url" title="Offertens PDF" style="width:100%;min-height:85vh;border:1px solid #cbd5df;border-radius:4px;"/>
            <div t-else="" class="bg-light border rounded p-5 text-center text-muted" style="min-height:300px;display:flex;align-items:center;justify-content:center;">
                <div>
                    <i class="fa fa-file-pdf-o fa-3x mb-3 d-block" style="opacity:0.3"/>
                    <p>Klicka <b>Generera PDF</b> för att se offertens faktiska sidor.</p>
                </div>
            </div>
        </div>
    </t>

    <!-- ═══ HTML-redigering — live-vy med contenteditable ═══ -->
    <t t-name="elevata_offer.OfferHtmlEditorWidget">
        <div class="o_offer_html_editor">
            <!-- Verktygsfält -->
            <div class="d-flex flex-wrap gap-2 mb-2 align-items-center">
                <button type="button" class="btn btn-primary" t-on-click="refreshPreview" t-att-disabled="state.loading">
                    <i t-if="state.loading" class="fa fa-spinner fa-spin me-1"/>
                    <i t-else="" class="fa fa-refresh me-1"/>
                    Ladda förhandsgranskning
                </button>
                <button type="button" class="btn btn-success" t-on-click="saveChanges">
                    <i class="fa fa-save me-1"/>Spara ändringar
                </button>
                <button type="button" t-att-class="'btn btn-sm ' + (state.codeMode ? 'btn-warning' : 'btn-outline-secondary')" t-on-click="toggleCodeMode">
                    <i class="fa fa-code me-1"/><t t-if="state.codeMode">Stäng kodvy</t><t t-else="">&lt;/&gt; Kodvy</t>
                </button>
                <span t-if="state.dirty" class="text-warning small"><i class="fa fa-circle me-1"/>Osparade ändringar</span>
                <span t-if="state.savedMsg" class="text-success small"><i class="fa fa-check me-1"/><t t-esc="state.savedMsg"/></span>
            </div>
            <p class="text-muted small mb-2">
                Klicka direkt i texten nedan för att redigera. Fält markeras vid hovring.
                <span t-if="state.editableCount" class="badge bg-secondary ms-1"><t t-esc="state.editableCount"/> redigerbara fält</span>
            </p>

            <div t-if="state.error" role="alert" class="alert alert-danger" t-esc="state.error"/>

            <!-- Kodvy (visas ovanför iframe när aktiv) -->
            <div t-if="state.codeMode" class="mb-3 border rounded p-3 bg-light">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <label class="fw-bold">Redigera HTML-kod för:</label>
                    <select class="form-select form-select-sm" style="width:auto;" t-on-change="onCodeFieldChange" t-att-value="state.codeField">
                        <t t-foreach="editableFields" t-as="f" t-key="f">
                            <option t-att-value="f" t-esc="f"/>
                        </t>
                    </select>
                </div>
                <textarea class="form-control font-monospace" rows="10" t-att-value="state.codeValue" t-on-input="onCodeInput" style="font-size:12px;"/>
                <p class="text-muted small mt-1">Ändringarna appliceras när du klickar Spara ändringar.</p>
            </div>

            <!-- Iframe med offertens HTML-rendering -->
            <iframe t-if="htmlUrl" t-ref="editFrame" t-att-src="htmlUrl" t-on-load="onIframeLoad" title="Redigera offert" style="width:100%;min-height:85vh;border:1px solid #cbd5df;border-radius:4px;background:#f8f9fa;"/>
            <div t-if="!htmlUrl" class="bg-light border rounded p-5 text-center text-muted" style="min-height:200px;display:flex;align-items:center;justify-content:center;">
                <p>Spara offerten först för att kunna redigera i förhandsgranskningen.</p>
            </div>
        </div>
    </t>

    <!-- ═══ Textavsnitt-editor för mallar ═══ -->
    <t t-name="elevata_offer.OfferTextEditorWidget">
        <div class="o_offer_text_editor">
            <label class="fw-bold d-block mb-1">Välj textavsnitt</label>
            <select class="form-select mb-3" t-on-change="selectSection" t-att-value="state.selected" aria-label="Textavsnitt">
                <t t-foreach="sections" t-as="section" t-key="section[0]">
                    <option t-att-value="section[0]" t-esc="section[1]"/>
                </t>
            </select>
            <h5 t-esc="selected[1]" class="mb-2"/>
            <div class="border rounded p-3 bg-white" style="min-height:260px;">
                <div t-key="state.selected">
                    <Field name="state.selected" record="props.record" readonly="readonly" fieldInfo="fieldInfo"/>
                </div>
            </div>
            <p class="text-muted small mt-2">HTML-fält har en &lt;/&gt;-knapp i verktygsfältet för att se/redigera HTML-källkod.</p>
        </div>
    </t>

</templates>
