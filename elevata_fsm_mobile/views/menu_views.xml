<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root: Fältservice Tekniker -->
    <!-- Rotmenyns action = arbetsordrarna blir startsida i appen -->
    <menuitem
        id="menu_mobile_root"
        name="Hisstekniker"
        sequence="5"
        groups="elevata_base.group_technician"
        action="action_fsm_order_mobile"
        web_icon="elevata_fsm_mobile,static/description/icon.png"/>

    <!-- ═══ Min dashboard (teknikerns egen instrumentpanel) ═══ -->
    <menuitem
        id="menu_mobile_tech_dashboard"
        name="Min dashboard"
        parent="menu_mobile_root"
        action="elevata_fsm_flow.action_fsm_tech_dashboard"
        sequence="5"
        groups="elevata_base.group_technician"/>

    <!-- ═══ Arbetsordrar (kanban, "Mina ordrar" förvalt) ═══ -->
    <menuitem
        id="menu_mobile_my_orders"
        name="Arbetsordrar"
        parent="menu_mobile_root"
        action="action_fsm_order_mobile"
        sequence="10"
        groups="elevata_base.group_technician"/>

    <!-- ═══ Kalender ═══ -->
    <menuitem
        id="menu_mobile_calendar"
        name="Kalender"
        parent="menu_mobile_root"
        action="calendar.action_calendar_event"
        sequence="30"
        groups="elevata_base.group_technician"/>

    <!-- ═══ Hissar (direkt efter Kalender, karta som standard) ═══ -->
    <record id="action_mobile_elevators" model="ir.actions.act_window">
        <field name="name">Hissar</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">googlemap,list,form</field>
        <field name="views" eval="[
            (ref('elevata_googlemap_hiss.view_maintenance_equipment_hiss_map'), 'googlemap'),
            (ref('elevata_fsm_flow.view_maintenance_equipment_elevator_list_fsm_flow'), 'list'),
            (ref('maintenance.hr_equipment_view_form'), 'form'),
        ]"/>
        <field name="domain">[('is_elevator', '=', True)]</field>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="menu_mobile_elevators"
        name="Hissar"
        parent="menu_mobile_root"
        action="action_mobile_elevators"
        sequence="35"
        groups="elevata_base.group_technician"/>

    <!-- ═══ Övrigt ═══ -->
    <menuitem
        id="menu_mobile_misc"
        name="Övrigt"
        parent="menu_mobile_root"
        sequence="50"
        groups="elevata_base.group_technician"/>

    <!-- Tidrapporter -->
    <record id="action_my_timesheets_tech" model="ir.actions.act_window">
        <field name="name">Mina tidrapporter</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="domain">[('project_id', '!=', False), ('user_id', '=', uid)]</field>
        <field name="context">{'is_timesheet': 1, 'search_default_week': 1}</field>
    </record>

    <menuitem
        id="menu_mobile_my_timesheets"
        name="Tidrapporter"
        parent="menu_mobile_misc"
        action="action_my_timesheets_tech"
        sequence="10"/>

    <!-- Ledighet / Frånvaro -->
    <menuitem
        id="menu_mobile_time_off"
        name="Ledighet/Frånvaro"
        parent="menu_mobile_misc"
        action="hr_holidays.hr_leave_action_my_request"
        sequence="20"/>

    <!-- Min ledighetsöversikt -->
    <menuitem
        id="menu_mobile_my_leaves"
        name="Min ledighetsöversikt"
        parent="menu_mobile_misc"
        action="hr_holidays.hr_leave_action_my"
        sequence="25"/>

    <!-- Certifieringar -->
    <menuitem
        id="menu_mobile_certifications"
        name="Certifieringar"
        parent="menu_mobile_misc"
        action="elevata_employee_certification.action_certification_overview"
        sequence="30"/>

    <!-- Nycklar -->
    <menuitem
        id="menu_mobile_keys"
        name="Nycklar"
        parent="menu_mobile_misc"
        action="elevata_fsm_key_management.action_key_management"
        sequence="40"/>

    <!-- ═══ Kartor (under Övrigt) ═══ -->
    <menuitem
        id="menu_mobile_maps"
        name="Kartor"
        parent="menu_mobile_misc"
        sequence="50"
        groups="elevata_base.group_technician"/>

    <!-- Karta: Arbetsorder -->
    <record id="action_map_orders_tech" model="ir.actions.act_window">
        <field name="name">Arbetsorder — karta</field>
        <field name="res_model">fieldservice.order</field>
        <field name="view_mode">googlemap,list,form</field>
        <field name="views" eval="[
            (ref('elevata_googlemap_arbetsorder.view_fieldservice_order_map'), 'googlemap'),
            (ref('view_fsm_order_mobile_list'), 'list'),
            (ref('view_fsm_order_mobile_form'), 'form'),
        ]"/>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="menu_mobile_map_orders"
        name="Arbetsorder"
        parent="menu_mobile_maps"
        action="action_map_orders_tech"
        sequence="10"/>

    <!-- Karta: Hissar -->
    <menuitem
        id="menu_mobile_map_elevators"
        name="Hissar"
        parent="menu_mobile_maps"
        action="elevata_googlemap_hiss.action_maintenance_equipment_map"
        sequence="20"/>

    <!-- Karta: Nyckelrör -->
    <menuitem
        id="menu_mobile_map_keys"
        name="Nyckelrör"
        parent="menu_mobile_maps"
        action="elevata_googlemap_hiss.action_maintenance_equipment_map"
        sequence="30"/>

</odoo>
