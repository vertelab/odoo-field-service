<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Mobile list view — Mina order (tekniker)
         ============================================================ -->
    <record id="view_fsm_order_mobile_list" model="ir.ui.view">
        <field name="name">fieldservice.order.mobile.list</field>
        <field name="model">fieldservice.order</field>
        <field name="arch" type="xml">
            <list string="Mina arbetsorder" decoration-success="stage_id.is_closed"
                  class="elevata-mobile-list">
                <field name="name" string="Order" class="fw-bold"/>
                <field name="equipment_id" string="Hiss"/>
                <field name="product_tmpl_id" string="Typ"/>
                <field name="planned_start_datetime" string="Planerad" widget="datetime"/>
                <field name="stage_id" string="Status" widget="badge"
                       decoration-success="stage_id.is_closed"
                       decoration-warning="not stage_id.is_closed"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         Mobile form view — Arbetsorder (tekniker)
         ============================================================ -->
    <record id="view_fsm_order_mobile_form" model="ir.ui.view">
        <field name="name">fieldservice.order.mobile.form</field>
        <field name="model">fieldservice.order</field>
        <field name="arch" type="xml">
            <form string="Arbetsorder" class="elevata-mobile-form">

                <header>
                    <button name="action_open_directions"
                            string="Navigera hit"
                            type="object"
                            class="btn-primary elevata-mobile-btn-nav"
                            icon="fa-location-arrow"/>
                    <button name="action_complete"
                            string="Markera som klar"
                            type="object"
                            class="btn-primary elevata-mobile-btn-complete"
                            invisible="stage_id.is_closed"/>
                    <field name="stage_id" widget="statusbar"
                           options="{'clickable': '0'}"/>
                </header>

                <sheet>

                    <!-- Order-rubrik + hissinfo -->
                    <div class="elevata-mobile-header">
                        <h3 class="elevata-mobile-order-name">
                            <field name="name" readonly="1" nolabel="1"/>
                        </h3>
                        <div class="elevata-mobile-location-info">
                            <field name="equipment_id" readonly="1" nolabel="1"
                                   options="{'no_open': True}"/>
                        </div>
                        <div class="elevata-mobile-type-row">
                            <field name="product_tmpl_id" readonly="1" nolabel="1"/>
                            <field name="planned_start_datetime" readonly="1" nolabel="1"
                                   widget="datetime"/>
                        </div>
                        <div class="elevata-mobile-address">
                            <i class="fa fa-map-marker text-primary" title="Vägbeskrivning"/>
                            <field name="directions_address" readonly="1" nolabel="1"
                                   class="ms-1"/>
                        </div>
                    </div>

                    <!-- Garantibadge -->
                    <div invisible="not is_warranty"
                         class="elevata-mobile-warranty-badge">
                        <span class="badge text-bg-danger">
                            Garantijobb — faktureras ej
                        </span>
                    </div>
                    <field name="is_warranty" invisible="1"/>

                    <!-- Serviceavtal (info, readonly) -->
                    <group invisible="not location_active_contract_id"
                           class="elevata-mobile-contract-info">
                        <field name="location_active_contract_id"
                               string="Serviceavtal" readonly="1"/>
                        <field name="live_contract_type" string="Avtalstyp" readonly="1"
                               invisible="not live_contract_type"/>
                    </group>
                    <field name="location_active_contract_id" invisible="1"/>

                    <separator/>

                    <!-- CHECKLISTA -->
                    <group string="Servicechecklista" name="mobile_checklist_grp"
                           invisible="not checklist_item_ids"
                           class="elevata-mobile-section">
                        <field name="checklist_item_ids" nolabel="1" colspan="2">
                            <list editable="bottom" class="elevata-mobile-checklist">
                                <field name="done" widget="boolean_toggle"
                                       class="elevata-mobile-checkbox"/>
                                <field name="name" string="Uppgift" readonly="1"/>
                                <field name="note" string="Anteckning"
                                       optional="show" placeholder="Anteckning..."/>
                            </list>
                        </field>
                        <div class="elevata-mobile-checklist-progress text-muted">
                            <field name="checklist_done_count" class="d-inline"/> av
                            <field name="checklist_count" class="d-inline"/> klara
                        </div>
                        <field name="checklist_done_count" invisible="1"/>
                        <field name="checklist_count" invisible="1"/>
                    </group>
                    <field name="location_require_checklist" invisible="1"/>

                    <!-- FOTON -->
                    <group string="Bilder" class="elevata-mobile-section">
                        <field name="photo_before" widget="image" nolabel="1"/>
                        <field name="photo_after" widget="image" nolabel="1"/>
                        <field name="photo_fault" widget="image" nolabel="1"/>
                    </group>

                    <!-- TIDRAPPORT -->
                    <group string="Tidrapportering" class="elevata-mobile-section">
                        <field name="employee_timesheet_ids" nolabel="1" colspan="2"
                               context="{'default_task_id': task_id}">
                            <list editable="bottom" class="elevata-mobile-timesheet">
                                <field name="employee_id" string="Tekniker" required="1"/>
                                <field name="date" string="Datum"/>
                                <field name="time_start" widget="timepicker_field"
                                       string="Start"/>
                                <field name="time_end" widget="timepicker_field"
                                       string="Slut"/>
                                <field name="unit_amount" string="Timmar"
                                       widget="float_time" readonly="1"/>
                                <field name="rate_type" string="Typ"/>
                                <field name="name" string="Beskrivning" optional="show"/>
                                <field name="task_id" column_invisible="1"/>
                            </list>
                        </field>
                    </group>

                    <!-- ANTECKNINGAR / RESOLUTION -->
                    <group string="Åtgärd / anteckningar" class="elevata-mobile-section">
                        <field name="resolution" nolabel="1" colspan="2"
                               placeholder="Beskriv vad som gjordes, eventuella anmärkningar..."
                               class="elevata-mobile-textarea"/>
                    </group>

                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

    <!-- ============================================================
         Huvudformulär arbetsorder — klickbara adresser
         ============================================================ -->
    <record id="view_fsm_order_form_directions" model="ir.ui.view">
        <field name="name">fieldservice.order.form.directions</field>
        <field name="model">fieldservice.order</field>
        <field name="inherit_id" ref="elevata_fsm_flow.fsm_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='street']" position="replace">
                <field name="directions_address" string="Adress"
                       readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='city']" position="replace"/>
        </field>
    </record>

    <!-- ============================================================
         Hiss-formulär — "Vägbeskrivning"-knapp + klickbar adress
         ============================================================ -->
    <record id="view_fsm_location_form_mobile_nav" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.mobile.nav</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_directions"
                        string="Vägbeskrivning"
                        type="object"
                        icon="fa-location-arrow"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <div class="elevata-directions-link mb-2">
                    <field name="directions_address"
                           nolabel="1" readonly="1" class="ms-1"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         Sökvy — döp om filtret "My Orders" till "Mina ordrar"
         ============================================================ -->
    <record id="view_fsm_order_search_mobile" model="ir.ui.view">
        <field name="name">fieldservice.order.search.mobile</field>
        <field name="model">fieldservice.order</field>
        <field name="inherit_id" ref="elevata_fsm_flow.fsm_order_search_view_inherit"/>
        <field name="arch" type="xml">
            <filter name="my_orders" position="attributes">
                <attribute name="string">Mina ordrar</attribute>
            </filter>
        </field>
    </record>

    <!-- ============================================================
         Action — Arbetsordrar (tekniker, mobiloptimerad)
         Kanban som standard, "Mina ordrar" förvalt
         ============================================================ -->
    <record id="action_fsm_order_mobile" model="ir.actions.act_window">
        <field name="name">Arbetsordrar</field>
        <field name="res_model">fieldservice.order</field>
        <field name="view_mode">kanban,tree,calendar,googlemap,form</field>
        <field name="views" eval="[
            (ref('elevata_fsm_flow.view_fieldservice_order_kanban_elevata'), 'kanban'),
            (ref('view_fsm_order_mobile_list'), 'tree'),
            (ref('fieldservice_vrtl.fieldservice_order_management_view_calendar'), 'calendar'),
            (ref('elevata_googlemap_arbetsorder.view_fieldservice_order_map'), 'googlemap'),
            (ref('view_fsm_order_mobile_form'), 'form'),
        ]"/>
        <field name="domain">[]</field>
        <field name="context">{'search_default_my_orders': 1}</field>
    </record>

    <!-- Gammal action för "Alla arbetsorder" — tas bort, menyn slås ihop -->
    <record id="action_fsm_order_mobile_all" model="ir.actions.act_window">
        <field name="name">Alla arbetsorder</field>
        <field name="res_model">fieldservice.order</field>
        <field name="view_mode">kanban,tree,calendar,googlemap,form</field>
        <field name="views" eval="[
            (ref('elevata_fsm_flow.view_fieldservice_order_kanban_elevata'), 'kanban'),
            (ref('view_fsm_order_mobile_list'), 'tree'),
            (ref('fieldservice_vrtl.fieldservice_order_management_view_calendar'), 'calendar'),
            (ref('elevata_googlemap_arbetsorder.view_fieldservice_order_map'), 'googlemap'),
            (ref('view_fsm_order_mobile_form'), 'form'),
        ]"/>
        <field name="context">{}</field>
    </record>

</odoo>
