<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="mail_message_inherit_form_view" model="ir.ui.view">
            <field name="name">mail.message.form.inherit.hr</field>
            <field name="model">mail.message</field>
            <field name="inherit_id" ref="mail.mail_message_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[last()]" position="after">
                    <page string="Followup Questions">
                        <field name="followup_question_ids">
                            <list editable="bottom" string="Followup Questions">
                                <field name="question"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>