<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Order Form: history tab + active orders link -->
    <record id="fsm_order_form_history_inherit" model="ir.ui.view">
        <field name="name">fsm.order.form.history</field>
        <field name="model">fieldservice.order</field>
        <field name="inherit_id" ref="elevata_fsm_flow.fsm_order_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Order History" name="order_history"
                      invisible="not related_location_orders">
                    <field name="related_location_orders" readonly="1"
                           options="{'no_create': True}">
                        <list>
                            <field name="create_date" optional="show" string="Created"/>
                            <field name="name" optional="show" string="Order No."/>
                            <field name="product_tmpl_id" optional="show" string="Order Type"/>
                            <field name="description" optional="show" string="Description"/>
                            <field name="reporter" optional="hide" string="Felanmälare"/>
                            <field name="resolution" optional="show" string="Resolution"/>
                            <field name="stage_id" optional="hide" string="Stage"/>
                            <field name="date_completed" optional="hide" string="Completed"/>
                            <field name="requested_employee_ids" optional="show" string="Technician"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Location Form: history tab + active orders link -->
    <record id="fsm_location_form_history_inherit" model="ir.ui.view">
        <field name="name">fsm.location.form.history</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Order History" name="order_history"
                      invisible="not fsm_order_ids">
                    <field name="fsm_order_ids" readonly="1"
                           options="{'no_create': True}">
                        <list>
                            <field name="create_date" optional="show" string="Created"/>
                            <field name="name" optional="show" string="Order No."/>
                            <field name="product_tmpl_id" optional="show" string="Order Type"/>
                            <field name="description" optional="show" string="Description"/>
                            <field name="reporter" optional="hide" string="Felanmälare"/>
                            <field name="resolution" optional="show" string="Resolution"/>
                            <field name="stage_id" optional="hide" string="Stage"/>
                            <field name="date_completed" optional="hide" string="Completed"/>
                            <field name="requested_employee_ids" optional="show" string="Technician"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
