  Ported from Odoo 17 / OCA fieldservice. The elevator list was a
  standalone fsm.location tree; here it is a maintenance.equipment list
  filtered to elevators, with the address reached through the property.
-->
<odoo>

    <record id="view_maintenance_equipment_elevator_list_fsm_flow" model="ir.ui.view">
        <field name="name">maintenance.equipment.list.fsm.flow</field>
        <field name="model">maintenance.equipment</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list decoration-success="operational_status == 'operational'"
                  decoration-danger="operational_status == 'out_of_order'"
                  decoration-muted="operational_status == 'decommissioned'">
                <field name="elevator_number" string="Elevator Number"/>
                <field name="name" string="Name"/>
                <field name="property_id" string="Property" optional="show"/>
                <field name="operational_status" string="Driftstatus" widget="badge"/>
                <field name="elevator_type_id" string="Elevator Type"/>
                <field name="control_system_id" string="Control System"/>
                <field name="manufacturing_number" string="Manufacturing Number" optional="show"/>
                <field name="mechanical_brand_id" string="Mechanical Brand" optional="hide"/>
                <field name="last_inspection" string="Last Inspection" optional="show"/>
                <field name="fsm_order_count" string="Work Orders" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Use this list for the elevator action -->
    <record id="maintenance_elevator.action_maintenance_equipment_elevator"
            model="ir.actions.act_window">
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_maintenance_equipment_elevator_list_fsm_flow"/>
    </record>

</odoo>
