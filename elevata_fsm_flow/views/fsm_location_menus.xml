  Ported from Odoo 17 / OCA fieldservice. "Avställda hissar" was an
  fsm.location action; it is now a maintenance.equipment action filtered
  to elevators that are not in operation.
-->
<odoo>

    <record id="action_out_of_service_elevators" model="ir.actions.act_window">
        <field name="name">Avställda hissar</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_elevator', '=', True), ('operational_status', '!=', 'operational')]</field>
        <field name="context">{'default_is_elevator': True}</field>
    </record>

    <!-- Hidden on purpose: the list is reached from the elevator list's
         own filter rather than from a menu of its own. Kept as a record so
         the action stays available to other modules and to the filter. -->
    <record id="menu_out_of_service_elevators" model="ir.ui.menu">
        <field name="name">Avställda hissar</field>
        <field name="parent_id" ref="maintenance.menu_maintenance_title"/>
        <field name="action" ref="action_out_of_service_elevators"/>
        <field name="sequence">16</field>
        <field name="active" eval="False"/>
    </record>

</odoo>
