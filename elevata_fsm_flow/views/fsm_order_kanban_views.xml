  The field service kanban card. The original inherited the OCA kanban and
  replaced its whole <templates> block, which does not survive the move to
  the Vertel fork (the parent view has no oe_kanban_colorpicker and a
  different template structure). It is defined as a standalone view here
  instead, and the order action points at it.
-->
<odoo>

    <record id="view_fieldservice_order_kanban_elevata" model="ir.ui.view">
        <field name="name">fieldservice.order.kanban.elevata</field>
        <field name="model">fieldservice.order</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column">
                <field name="type_color"/>
                <field name="location_operational_status"/>
                <field name="location_operational_status_str"/>
                <field name="product_type"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click"
                             t-attf-style="border-left: 5px solid #{record.type_color.raw_value or '#FFFFFF'};">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <span class="badge rounded-pill"
                                      t-attf-class="{{ {
                                          '0': 'text-bg-secondary',
                                          '1': 'text-bg-light text-dark border',
                                          '2': 'text-bg-primary',
                                          '3': 'text-bg-warning text-dark',
                                          '4': 'text-bg-danger'
                                      }[record.priority.raw_value] || 'text-bg-secondary' }}">
                                    <field name="priority"/>
                                </span>
                            </div>

                            <div class="text-muted">
                                <field name="product_type"/>
                            </div>

                            <div>
                                <field name="tag_ids" widget="many2many_tags"/>
                            </div>

                            <div class="mt-1">
                                <field name="equipment_id"/>
                                <span class="badge rounded-pill ms-2"
                                      t-attf-class="{{ {
                                          'operational': 'text-bg-success',
                                          'out_of_order': 'text-bg-danger',
                                          'decommissioned': 'text-bg-dark'
                                      }[record.location_operational_status.raw_value] || 'text-bg-secondary' }}"
                                      t-if="record.location_operational_status.raw_value !== 'operational'">
                                    <field name="location_operational_status_str"/>
                                </span>
                            </div>

                            <div class="mt-1">
                                <strong>
                                    <field name="street"/>
                                    <span style="margin: 0 5px;"/>
                                    <field name="city"/>
                                </strong>
                            </div>

                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="planned_start_datetime" widget="date"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="requested_employee_ids"
                                           widget="many2many_avatar_employee"
                                           options="{'no_create': True}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Point the order action at the Elevata card -->
    <record id="fieldservice_vrtl.action_fieldservice_order" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_fieldservice_order_kanban_elevata"/>
    </record>

</odoo>
