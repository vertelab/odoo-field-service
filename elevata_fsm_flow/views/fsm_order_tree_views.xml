<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- FSM Order Tree View -->
    <record id="fsm_order_tree_view_inherit" model="ir.ui.view">
        <field name="name">fieldservice.order.tree.elevata</field>
        <field name="model">fieldservice.order</field>
        <field name="priority">20</field>
        <field name="inherit_id" ref="fieldservice_vrtl.view_fieldservice_order_tree"/>
        <field name="arch" type="xml">
            <list position="replace">
                <list name="orders" default_order="priority desc, planned_start_datetime"
                      decoration-danger="priority == '4' or stage_id in [%(fieldservice_vrtl.fieldservice_stage_new)d, %(fieldservice_vrtl.fieldservice_stage_assigned)d]"
                      decoration-warning="priority == '3'"
                      decoration-info="stage_id in [%(fieldservice_vrtl.fieldservice_stage_planning)d, %(elevata_fsm_flow.fsm_stage_started)d, %(fieldservice_vrtl.fieldservice_stage_completed)d]">
                    <field name="planned_start_datetime" optional="hide"/>
                    <field name="name" string="Order Number"/>
                    <field name="priority" optional="show" widget="elevata_priority_stars"/>
                    <field name="equipment_id"/>
                    <field name="location_operational_status" string="Hissstatus" widget="badge"/>
                    <field name="street"/>
                    <field name="city" optional="hide"/>
                    <field name="product_type" string="Order Type"/>
                    <field name="requested_employee_ids"/>
                    <field name="stage_id" string="Stage"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </list>
        </field>
    </record>

    <!-- Search View: add past-due filter -->
    <record id="fsm_order_search_view_inherit" model="ir.ui.view">
        <field name="name">fsm.order.search.elevata</field>
        <field name="model">fieldservice.order</field>
        <field name="inherit_id" ref="fieldservice_vrtl.view_fieldservice_order_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">[('name', 'ilike', self)]</attribute>
            </xpath>
            <xpath expr="//field[@name='requested_employee_ids']" position="attributes">
                <attribute name="string">Hisstekniker</attribute>
            </xpath>
            <search position="inside">
                <filter name="order_today" position="before">
                    <filter string="Past Due Orders"
                            domain="[('stage_id.name', 'not in', ['Started', 'Completed', 'Cancelled']), ('planned_start_datetime', '&lt;', current_date)]"
                            name="past_due"/>
                </filter>
            </search>
            <xpath expr="//search" position="inside">
                <filter name="priority_critical" string="Kritiska"
                        domain="[('priority', '=', '4')]"/>
                <filter name="priority_high_up" string="Hög prioritet"
                        domain="[('priority', 'in', ['3', '4'])]"/>
                <separator/>
                <filter name="group_priority" string="Prioritet"
                        context="{'group_by': 'priority'}"/>
            </xpath>
        </field>
    </record>

</odoo>
