<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Elevator data on the work order form.

         This used to be a full replacement: <xpath expr="//form"
         position="replace"> wrapped the entire form, which meant every
         module that inherited this view got Elevata's form whether it
         wanted it or not, and any module that anchored on a field from
         here depended on elevata_fsm_flow loading first.

         That made the upgrade order critical: with elevata_fsm_flow in
         "to upgrade" the view was not loaded, so elevator_type_id did not
         exist, and every inheriting view that anchored on it failed —
         which aborted the upgrade that would have loaded elevata_fsm_flow.
         A deadlock that could only be broken by hand.

         Now it is an ordinary extension view. The generic parts (button
         box, title, description, resolution, chatter) live in
         fieldservice_vrtl; this adds the elevator sections.
         ================================================================ -->
    <record id="fsm_order_form" model="ir.ui.view">
        <field name="name">fieldservice.order.form.elevata</field>
        <field name="model">fieldservice.order</field>
        <field name="inherit_id" ref="fieldservice_vrtl.view_fieldservice_order_form"/>
        <field name="arch" type="xml">

            <!-- Elevator out of service: the one thing on this form that
                 must not be missed, so it sits above the title. -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="alert alert-danger" role="alert"
                     invisible="not equipment_id or location_operational_status == 'operational'">
                    <strong>Observera:</strong>
                    <span class="ms-1">Hissen är</span>
                    <field name="location_operational_status_str" readonly="1"
                           nolabel="1" class="d-inline-block ms-1"/>
                </div>
            </xpath>

            <!-- Elevator identity next to the generic order fields. -->
            <xpath expr="//group[@name='group_top']" position="inside">
                <group string="Hiss">
                    <field name="elevator_type_id" string="Hisstyp"/>
                    <field name="control_system_id" string="Styrsystem"/>
                    <field name="manufacturing_number" string="Tillverkningsnummer"/>
                </group>
            </xpath>

            <!-- The elevator pages. -->
            <xpath expr="//notebook" position="inside">
                <page string="Hissdata" name="elevator_data_page" sequence="10">
                    <group>
                        <group string="Grundinformation">
                            <field name="elevator_type_id" string="Hisstyp"/>
                            <field name="control_system_id" string="Styrsystem"/>
                            <field name="manufacturing_number" string="Tillverkningsnummer"/>
                            <field name="mechanical_brand_id" string="Mekaniskt märke"/>
                        </group>
                        <group string="Dörrar &amp; övrigt">
                            <field name="car_door_type_id" string="Korgdörrstyp"/>
                            <field name="shaft_door_type_id" string="Schaktdörrstyp"/>
                            <field name="lubrication_type_id" string="Smörjtyp"/>
                            <field name="bearing_config_id" string="Lager/Topp/Grop"/>
                        </group>
                    </group>
                </page>
                <page string="Nödtelefon" name="emergency_phone_page" sequence="20">
                    <group>
                        <group string="Telefondetaljer">
                            <field name="emergency_phone_type_id" string="Nödtelefonstyp"/>
                            <field name="gsm_device_id" string="GSM enhet"/>
                            <field name="p100" string="P100"/>
                        </group>
                        <group>
                            <field name="sim_image" string="SIM-bild" widget="image"
                                   class="oe_avatar"/>
                        </group>
                    </group>
                </page>
                <page string="Besiktning" name="inspection_page" sequence="30">
                    <group>
                        <group>
                            <field name="last_inspection"/>
                            <field name="inspection_company_id"/>
                            <field name="inspection_number"/>
                            <field name="inspection_month"/>
                        </group>
                    </group>
                </page>
                <page string="Bilder" name="pictures_page" sequence="35" invisible="1">
                    <field name="location_image_ids" widget="many2many_binary"
                           string="Bilder" nolabel="1"/>
                </page>
            </xpath>

            <!-- Active orders on this elevator, next to the other stat
                 buttons. -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button type="object" name="action_view_active_orders"
                        class="oe_stat_button" icon="fa-wrench"
                        invisible="active_order_count == 0">
                    <field name="active_order_count" widget="statinfo"
                           string="Aktiva ordrar"/>
                </button>
                <button type="object" name="action_view_fsm_recurring"
                        class="oe_stat_button" icon="fa-calendar"
                        invisible="not fsm_recurring_id">
                    <span class="o_stat_text">Recurring Order</span>
                </button>
            </xpath>

        </field>
    </record>

</odoo>
