<odoo>

    <!-- Technician: active + recently closed orders -->
    <record id="fsm_order_rule_technician" model="ir.rule">
        <field name="name">Field Service Order: technician access to active and recent orders</field>
        <field name="model_id" ref="fieldservice_vrtl.model_fieldservice_order"/>
        <field name="domain_force">[
            '|',
            ('stage_id.is_closed', '=', False),
            '&amp;',
            ('stage_id.is_closed', '=', True),
            ('write_date', '&gt;=', time.strftime('%Y-%m-%d'))
        ]</field>
        <field name="groups" eval="[(4, ref('fieldservice_vrtl.fieldservice_group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
