<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="elevata_fsm_flow.FsmTechDashboard" owl="1">
        <div class="elevata_fsm_dashboard container-fluid py-3">
            <h4 class="mb-3">Min dag</h4>
            <div t-if="!state.loaded" class="text-muted p-4">Laddar...</div>
            <t t-else="">
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="elevata_dash_card" t-on-click="openToday">
                            <div class="card_value" t-esc="state.stats.today"/>
                            <div class="card_label">Idag</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="elevata_dash_card" t-on-click="openTomorrow">
                            <div class="card_value" t-esc="state.stats.tomorrow"/>
                            <div class="card_label">Imorgon</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="elevata_dash_card" t-on-click="openWeek">
                            <div class="card_value" t-esc="state.stats.week"/>
                            <div class="card_label">Denna vecka</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="elevata_dash_card" t-on-click="openMyOpen">
                            <div class="card_value" t-esc="state.stats.open"/>
                            <div class="card_label">Öppna ordrar</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="elevata_dash_card card_high" t-on-click="openPriority">
                            <div class="card_value" t-esc="state.stats.priority"/>
                            <div class="card_label">Prioriterade</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="elevata_dash_card card_shutdown" t-on-click="openShutdown">
                            <div class="card_value" t-esc="state.stats.shutdown"/>
                            <div class="card_label">Avstängda hissar</div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-4">
                        <div class="elevata_dash_card card_overdue" t-on-click="openOverdue">
                            <div class="card_value" t-esc="state.stats.overdue"/>
                            <div class="card_label">Försenade</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="elevata_dash_card" t-on-click="openUnscheduled">
                            <div class="card_value" t-esc="state.stats.unscheduled"/>
                            <div class="card_label">Oplanerade</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="elevata_dash_card" t-on-click="openDone">
                            <div class="card_value" t-esc="state.stats.done"/>
                            <div class="card_label">Avslutade</div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4" t-if="state.stages and state.stages.length">
                    <div class="col-12">
                        <div class="elevata_dash_panel">
                            <h5 class="panel_title">Mina ordrar per status</h5>
                            <div class="elevata_pipeline">
                                <div t-foreach="state.stages" t-as="st" t-key="st.id || 0"
                                     class="pipeline_step o_clickable"
                                     t-on-click="() => this.openStage(st)">
                                    <div class="step_count" t-esc="st.count"/>
                                    <div class="step_name" t-esc="st.name"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4" t-if="state.upcoming.length">
                    <div class="col-12">
                        <div class="elevata_dash_panel">
                            <h5 class="panel_title">Planering — kommande ordrar</h5>
                            <table class="table table-sm o_main_link mb-0">
                                <thead>
                                    <tr>
                                        <th>Order</th>
                                        <th>Hiss</th>
                                        <th>Typ</th>
                                        <th>Planerad start</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.upcoming" t-as="rec" t-key="rec.id"
                                        t-on-click="() => this.openOrder(rec)"
                                        class="o_clickable">
                                        <td t-esc="rec.name"/>
                                        <td t-esc="rec.equipment_id ? rec.equipment_id[1] : ''"/>
                                        <td t-esc="rec.type ? rec.type[1] : ''"/>
                                        <td t-esc="this.fmt(rec.planned_start_datetime)"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-lg-8">
                        <div class="elevata_dash_panel mb-3">
                            <h5 class="panel_title">Prioriterade ordrar</h5>
                            <table class="table table-sm o_main_link mb-0" t-if="state.priorityList.length">
                                <thead>
                                    <tr>
                                        <th>Order</th>
                                        <th>Hiss</th>
                                        <th>Typ</th>
                                        <th>Prio</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.priorityList" t-as="rec" t-key="rec.id"
                                        t-on-click="() => this.openOrder(rec)"
                                        class="o_clickable">
                                        <td t-esc="rec.name"/>
                                        <td t-esc="rec.equipment_id ? rec.equipment_id[1] : ''"/>
                                        <td t-esc="rec.type ? rec.type[1] : ''"/>
                                        <td>
                                            <span t-attf-class="badge {{rec.priority === '4' ? 'bg-danger' : 'bg-warning text-dark'}}"
                                                  t-esc="rec.priority === '4' ? 'Kritisk' : 'Hög'"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <p t-else="" class="text-muted mb-0">Inga kritiska eller högprioriterade ordrar.</p>
                        </div>
                        <div class="elevata_dash_panel" t-if="state.overdueList.length">
                            <h5 class="panel_title text-danger">Försenade ordrar</h5>
                            <table class="table table-sm o_main_link mb-0">
                                <thead>
                                    <tr>
                                        <th>Order</th>
                                        <th>Hiss</th>
                                        <th>Typ</th>
                                        <th>Planerad start</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.overdueList" t-as="rec" t-key="rec.id"
                                        t-on-click="() => this.openOrder(rec)"
                                        class="o_clickable">
                                        <td t-esc="rec.name"/>
                                        <td t-esc="rec.equipment_id ? rec.equipment_id[1] : ''"/>
                                        <td t-esc="rec.type ? rec.type[1] : ''"/>
                                        <td t-esc="this.fmt(rec.planned_start_datetime)"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="elevata_dash_panel">
                            <h5 class="panel_title text-danger">Avstängda hissar</h5>
                            <ul class="list-unstyled mb-0" t-if="state.shutdown.length">
                                <li t-foreach="state.shutdown" t-as="loc" t-key="loc.id"
                                    t-on-click="() => this.openLocation(loc)"
                                    class="o_clickable py-1 border-bottom">
                                    <i class="fa fa-exclamation-triangle text-danger me-2">&#xfeff;</i>
                                    <strong t-esc="loc.name"/>
                                    <div class="text-muted small ms-4">
                                        <t t-esc="loc.out_of_order_reason || 'Ingen anledning angiven'"/>
                                        <t t-if="loc.out_of_order_date"> — sedan <t t-esc="loc.out_of_order_date"/></t>
                                    </div>
                                </li>
                            </ul>
                            <p t-else="" class="text-muted mb-0">Inga avstängda hissar.</p>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
