<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="elevata_fsm_flow.ColoredPriorityField">
        <div class="o_field_widget o_field_elevata_priority_stars d-inline-flex align-items-center">
            <t t-foreach="selection" t-as="option" t-key="option[0]">
                <a href="#" role="button" tabindex="-1"
                   t-attf-class="o_priority_star fa {{ isFilled(option_index) ? 'fa-star' : 'fa-star-o' }} {{ props.readonly ? '' : 'o-clickable' }}"
                   t-att-title="option[1]"
                   t-att-style="starStyle(option_index)"
                   t-on-click.prevent="() => this.onClick(option[0])"/>
            </t>
        </div>
    </t>
</templates>
