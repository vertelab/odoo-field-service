<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="elevata_fsm_flow.TechnicianFilterMenu"
       t-inherit="web.SearchBarMenu"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_filter_menu')]/t[@t-set='currentGroup']" position="before">
            <t t-if="isFsmOrderSearch and technicianFilter.technicians.length">
                <div role="separator" class="dropdown-divider"/>
                <AccordionItem class="'text-truncate'"
                               description="'Hisstekniker'"
                               selected="technicianFilter.selectedId !== false">
                    <CheckboxItem t-foreach="technicianFilter.technicians"
                                  t-as="technician"
                                  t-key="technician.id"
                                  class="{ o_item_option: true, selected: technicianFilter.selectedId === technician.id }"
                                  checked="technicianFilter.selectedId === technician.id"
                                  parentClosingMode="'none'"
                                  t-esc="technician.name"
                                  onSelected="() => this.selectTechnician(technician)"/>
                </AccordionItem>
            </t>
        </xpath>
    </t>
</templates>
