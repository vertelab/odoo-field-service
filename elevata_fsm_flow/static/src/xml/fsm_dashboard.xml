<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="elevata_fsm_flow.FsmDashboard" owl="1">
        <div class="elevata_fsm_dashboard container-fluid py-3">
            <WithSearch resModel="'fieldservice.order'" domain="[]" context="{}"
                        searchViewId="false" loadIrFilters="true">
                <DashboardSearch/>
            </WithSearch>
            <div t-if="!state.loaded" class="text-muted p-4">Laddar...</div>
            <t t-else="">
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="elevata_dash_card" t-on-click="openOpenOrders">
                            <div class="card_value" t-esc="state.stats.openCount"/>
                            <div class="card_label">Öppna ordrar</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="elevata_dash_card card_critical" t-on-click="openCritical">
                            <div class="card_value" t-esc="state.stats.critical"/>
                            <div class="card_label">Kritiska</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="elevata_dash_card card_high" t-on-click="openHigh">
                            <div class="card_value" t-esc="state.stats.high"/>
                            <div class="card_label">Hög prioritet</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="elevata_dash_card" t-on-click="openToday">
                            <div class="card_value" t-esc="state.stats.today"/>
                            <div class="card_label">Ordrar idag</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="elevata_dash_card card_invoice" t-on-click="openToInvoice">
                            <div class="card_value" t-esc="state.stats.toInvoice"/>
                            <div class="card_label">Att fakturera</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="elevata_dash_card card_shutdown" t-on-click="openShutdown">
                            <div class="card_value" t-esc="state.stats.shutdown"/>
                            <div class="card_label">Avstängda hissar</div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="elevata_dash_card card_overdue" t-on-click="openOverdue">
                            <div class="card_value" t-esc="state.stats.overdue"/>
                            <div class="card_label">Försenade</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="elevata_dash_card" t-on-click="openUnassigned">
                            <div class="card_value" t-esc="state.stats.unassigned"/>
                            <div class="card_label">Otilldelade</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="elevata_dash_card card_note" t-on-click="openInspectionNotes">
                            <div class="card_value" t-esc="state.stats.inspectionNotes"/>
                            <div class="card_label">Besiktningsanmärkningar</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="elevata_dash_card card_contract" t-on-click="openContracts">
                            <div class="card_value" t-esc="state.stats.contracts"/>
                            <div class="card_label">Aktiva serviceavtal</div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4" t-if="state.stages and state.stages.length">
                    <div class="col-12">
                        <div class="elevata_dash_panel">
                            <h5 class="panel_title">Ordrar per status</h5>
                            <div class="elevata_pipeline">
                                <div t-foreach="state.stages" t-as="st" t-key="st.id || 0"
                                     class="pipeline_step o_clickable"
                                     t-on-click="() => this.openStage(st)">
                                    <div class="step_count" t-esc="st.count"/>
                                    <div class="step_name" t-esc="st.name"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4" t-if="state.planned.length">
                    <div class="col-12">
                        <div class="elevata_dash_panel">
                            <h5 class="panel_title">Planering — kommande ordrar</h5>
                            <table class="table table-sm o_main_link mb-0">
                                <thead>
                                    <tr>
                                        <th>Order</th>
                                        <th>Hiss</th>
                                        <th>Tekniker</th>
                                        <th>Typ</th>
                                        <th>Planerad start</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.planned" t-as="rec" t-key="rec.id"
                                        t-on-click="() => this.openOrder(rec)"
                                        class="o_clickable">
                                        <td t-esc="rec.name"/>
                                        <td t-esc="rec.equipment_id ? rec.equipment_id[1] : ''"/>
                                        <td t-esc="rec.person_id ? rec.person_id[1] : '—'"/>
                                        <td t-esc="rec.product_type ? rec.product_type[1] : ''"/>
                                        <td t-esc="formatPlanned(rec)"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-lg-8">
                        <div class="elevata_dash_panel">
                            <h5 class="panel_title">Prioriterade ordrar</h5>
                            <table class="table table-sm o_main_link mb-0" t-if="state.urgent.length">
                                <thead>
                                    <tr>
                                        <th>Order</th>
                                        <th>Hiss</th>
                                        <th>Typ</th>
                                        <th>Prio</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.urgent" t-as="rec" t-key="rec.id"
                                        t-on-click="() => this.openOrder(rec)"
                                        class="o_clickable">
                                        <td t-esc="rec.name"/>
                                        <td t-esc="rec.equipment_id ? rec.equipment_id[1] : ''"/>
                                        <td t-esc="rec.product_type ? rec.product_type[1] : ''"/>
                                        <td>
                                            <span t-attf-class="badge {{rec.priority === '4' ? 'bg-danger' : 'bg-warning text-dark'}}"
                                                  t-esc="rec.priority === '4' ? 'Kritisk' : 'Hög'"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <p t-else="" class="text-muted mb-0">Inga kritiska eller högprioriterade ordrar.</p>
                        </div>
                        <div class="elevata_dash_panel mt-3">
                            <h5 class="panel_title">Återkommande problem — flest ordrar senaste 30 dagarna</h5>
                            <table class="table table-sm o_main_link mb-0" t-if="state.repeatLocs.length">
                                <tbody>
                                    <tr t-foreach="state.repeatLocs" t-as="loc" t-key="loc.id"
                                        t-on-click="() => this.openLocation(loc)"
                                        class="o_clickable">
                                        <td>
                                            <i class="fa fa-refresh text-warning me-2"/>
                                            <strong t-esc="loc.name"/>
                                        </td>
                                        <td class="text-end">
                                            <span class="badge bg-danger me-1" t-if="loc.open" t-esc="loc.open + ' aktiva'"/>
                                            <span class="badge bg-secondary" t-esc="(loc.count - loc.open) + ' avslutade'"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <p t-else="" class="text-muted mb-0">Inga ordrar senaste 30 dagarna.</p>
                        </div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="elevata_dash_panel mb-3">
                            <h5 class="panel_title">Fakturering denna månad</h5>
                            <div class="d-flex justify-content-between align-items-baseline">
                                <span class="text-muted">Antal fakturor</span>
                                <strong t-esc="(state.stats.invMonth || {}).count || 0"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-baseline">
                                <span class="text-muted">Summa</span>
                                <strong t-esc="(state.stats.invMonth || {}).total || '0 kr'"/>
                            </div>
                        </div>
                        <div class="elevata_dash_panel">
                            <h5 class="panel_title text-danger">Avstängda hissar</h5>
                            <ul class="list-unstyled mb-0" t-if="state.shutdown.length">
                                <li t-foreach="state.shutdown" t-as="loc" t-key="loc.id"
                                    t-on-click="() => this.openLocation(loc)"
                                    class="o_clickable py-1 border-bottom">
                                    <i class="fa fa-exclamation-triangle text-danger me-2"/>
                                    <strong t-esc="loc.name"/>
                                    <div class="text-muted small ms-4">
                                        <t t-esc="loc.out_of_order_reason || 'Ingen anledning angiven'"/>
                                        <t t-if="loc.out_of_order_date"> — sedan <t t-esc="loc.out_of_order_date"/></t>
                                    </div>
                                </li>
                            </ul>
                            <p t-else="" class="text-muted mb-0">Inga avstängda hissar.</p>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>

    <t t-name="elevata_fsm_flow.DashboardSearch" owl="1">
        <div class="elevata_dash_searchbar d-flex align-items-center gap-1 mb-3">
            <SearchBar/>
            <SearchBarMenu/>
        </div>
        <div t-if="state.searched" class="elevata_dash_search_results mb-3">
            <div t-if="state.orders.length">
                <div class="result_header">Arbetsorder (<t t-esc="state.orders.length"/>)</div>
                <div t-foreach="state.orders" t-as="o" t-key="o.id"
                     class="result_row o_clickable"
                     t-on-click="() => this.openOrder(o)">
                    <i class="fa fa-wrench me-2 text-muted"/>
                    <strong t-esc="o.name"/>
                    <span class="text-muted ms-2" t-esc="o.equipment_id ? o.equipment_id[1] : ''"/>
                    <span class="badge bg-secondary ms-2" t-esc="o.stage_id ? o.stage_id[1] : ''"/>
                </div>
            </div>
            <div t-if="state.groups.length">
                <div class="result_header">Grupperat resultat</div>
                <div t-foreach="state.groups" t-as="g" t-key="g.name"
                     class="result_row o_clickable"
                     t-on-click="() => this.openGroup(g)">
                    <strong t-esc="g.name"/>
                    <span class="badge bg-primary ms-2" t-esc="g.count"/>
                </div>
            </div>
            <div class="result_row o_clickable text-primary" t-on-click="openAll">
                <i class="fa fa-list me-2"/>Öppna i arbetsordervyn
            </div>
        </div>
    </t>
</templates>
