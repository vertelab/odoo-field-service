<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_elevator_shutdown_wizard_form" model="ir.ui.view">
        <field name="name">elevata.elevator.shutdown.wizard.form</field>
        <field name="model">elevata.elevator.shutdown.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrera avstängning">
                <sheet>
                    <group>
                        <field name="equipment_id" readonly="1"/>
                        <field name="operational_status"/>
                        <field name="out_of_order_date"/>
                        <field name="out_of_order_reason"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm"
                            string="Spara avstängning"
                            type="object"
                            class="btn-primary"/>
                    <button string="Avbryt" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
