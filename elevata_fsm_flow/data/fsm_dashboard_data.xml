  Dashboard and the menus that hang off it. The original pointed at
  xmlids owned by the OCA fieldservice module (fieldservice.dashboard,
  fieldservice.action_fsm_dash_order, fieldservice_recurring.menu_*),
  none of which exist in the Vertel fork. They are defined here under
  this module's own namespace instead.
-->
<odoo>

    <!-- FSM dashboard client action -->
    <record id="action_elevata_fsm_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">elevata_fsm_dashboard</field>
    </record>

    <!-- Dashboard menu, pointing straight at the client action -->
    <record id="menu_elevata_fsm_dashboard" model="ir.ui.menu">
        <field name="name">Dashboard</field>
        <field name="parent_id" ref="fieldservice_vrtl.menu_fieldservice_root"/>
        <field name="action" ref="action_elevata_fsm_dashboard"/>
        <field name="sequence">1</field>
    </record>

    <!-- Work orders as a direct menu entry (no submenu) -->
    <record id="action_fsm_dash_order" model="ir.actions.act_window">
        <field name="name">Arbetsorder</field>
        <field name="res_model">fieldservice.order</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_my_orders': 1}</field>
    </record>
    <record id="menu_fsm_dash_order" model="ir.ui.menu">
        <field name="name">Arbetsorder</field>
        <field name="parent_id" ref="fieldservice_vrtl.menu_fieldservice_root"/>
        <field name="action" ref="action_fsm_dash_order"/>
        <field name="sequence">2</field>
    </record>

    <!-- Recurring orders under Configuration -->
    <record id="menu_fsm_recurring" model="ir.ui.menu">
        <field name="name">Återkommande ordrar</field>
        <field name="parent_id" ref="fieldservice_vrtl.configurations"/>
        <field name="action" ref="fieldservice_recurring_vrtl.fsm_recurring_action"/>
        <field name="sequence">50</field>
    </record>

</odoo>
