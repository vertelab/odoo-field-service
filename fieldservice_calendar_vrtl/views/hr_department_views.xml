<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Department calendar owner: the middle level of the owner chain. -->
    <record id="view_department_form_fsm_calendar" model="ir.ui.view">
        <field name="name">hr.department.form.fsm.calendar</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Field Service" name="fsm_calendar">
                    <field name="fsm_calendar_user_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
