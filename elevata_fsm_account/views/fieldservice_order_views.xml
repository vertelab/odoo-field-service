<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fieldservice_order_form_account" model="ir.ui.view">
        <field name="name">fieldservice.order.form.elevata.account</field>
        <field name="model">fieldservice.order</field>
        <field name="inherit_id" ref="elevata_fsm_flow.fsm_order_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Time &amp; Material" name="accounting_new" sequence="55">
                    <header>
                        <button name="account_create_invoice"
                                string="Create Invoice"
                                class="oe_highlight" type="object"
                                groups="account.group_account_invoice"
                                invisible="account_stage != 'confirmed'"/>
                        <button name="account_confirm"
                                string="Confirm" type="object"
                                groups="account.group_account_invoice"
                                invisible="account_stage != 'review'"/>
                        <button name="account_no_invoice"
                                string="No Invoice" type="object"
                                groups="account.group_account_invoice"
                                invisible="not is_closed or account_stage not in ('draft', 'review')"/>
                        <field name="account_stage" widget="statusbar"
                               statusbar_visible="draft,review,confirmed,invoiced"/>
                    </header>
                    <group name="bill_to">
                        <field name="bill_to" widget="radio"
                               options="{'horizontal': true}"/>
                    </group>
                    <group string="Contractor Costs">
                        <field name="contractor_cost_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="partner_id"/>
                                <field name="product_id" required="1"/>
                                <field name="quantity" required="1"/>
                                <field name="price_unit" required="1"/>
                            </list>
                        </field>
                    </group>
                    <group>
                        <field name="contractor_total" readonly="1"/>
                    </group>
                    <group string="Timesheets">
                        <field name="employee_timesheet_ids" nolabel="1"
                               context="{'default_project_id': project_id, 'default_task_id': task_id}"
                               colspan="2">
                            <list editable="bottom" default_order="date">
                                <field name="date"/>
                                <field name="employee_id" required="1"/>
                                <field name="product_id" required="1"
                                       domain="[('type', '=', 'service')]"/>
                                <field name="name"/>
                                <field name="time_start" widget="float_time"/>
                                <field name="time_end" widget="float_time"/>
                                <field name="unit_amount" string="Duration"
                                       widget="float_time" sum="Total Duration"/>
                                <field name="user_id" optional="hide"/>
                                <field name="company_id" optional="hide"/>
                                <field name="account_id" optional="hide"/>
                                <field name="project_id" optional="hide"/>
                                <field name="task_id" optional="hide"/>
                            </list>
                        </field>
                    </group>
                    <group col="4">
                        <field name="employee_time_total" readonly="1"/>
                        <field name="employee" invisible="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
