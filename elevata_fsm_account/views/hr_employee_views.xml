<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_form_account" model="ir.ui.view">
        <field name="name">hr.employee.form.account</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_bills" type="object"
                        class="oe_stat_button" icon="fa-credit-card"
                        groups="account.group_account_invoice">
                    <field name="bill_count" widget="statinfo" string="Vendor Bills"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
