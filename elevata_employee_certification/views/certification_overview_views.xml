<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view for certification overview -->
    <record id="view_employee_skill_cert_list" model="ir.ui.view">
        <field name="name">hr.employee.skill.cert.list</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
            <list string="Certifications"
                  decoration-danger="cert_status == 'expired'"
                  decoration-warning="cert_status == 'expiring'">
                <field name="employee_id"/>
                <field name="skill_id" string="Certification"/>
                <field name="date_issued"/>
                <field name="date_expiry"/>
                <field name="certificate_number"/>
                <field name="cert_status" widget="badge"
                       decoration-success="cert_status == 'valid'"
                       decoration-warning="cert_status == 'expiring'"
                       decoration-danger="cert_status == 'expired'"
                       decoration-muted="cert_status == 'no_date'"/>
            </list>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_employee_skill_cert_search" model="ir.ui.view">
        <field name="name">hr.employee.skill.cert.search</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
            <search string="Certifications">
                <field name="employee_id"/>
                <field name="skill_id" string="Certification"/>
                <filter string="Expired" name="expired"
                        domain="[('cert_status', '=', 'expired')]"/>
                <filter string="Expiring Soon" name="expiring"
                        domain="[('cert_status', '=', 'expiring')]"/>
                <filter string="Valid" name="valid"
                        domain="[('cert_status', '=', 'valid')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="by_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Certification" name="by_skill"
                            context="{'group_by': 'skill_id'}"/>
                    <filter string="Status" name="by_status"
                            context="{'group_by': 'cert_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_certification_overview" model="ir.actions.act_window">
        <field name="name">Certification Overview</field>
        <field name="res_model">hr.employee.skill</field>
        <field name="view_mode">list</field>
        <field name="domain">[('skill_type_id.is_certification', '=', True)]</field>
        <field name="view_id" ref="view_employee_skill_cert_list"/>
        <field name="search_view_id" ref="view_employee_skill_cert_search"/>
        <field name="context">{'search_default_expiring': 1}</field>
    </record>

    <!-- Menu item under Employees -->
    <menuitem id="menu_certification_overview"
              name="Certification Overview"
              parent="hr.menu_hr_root"
              action="action_certification_overview"
              sequence="25"/>

</odoo>
