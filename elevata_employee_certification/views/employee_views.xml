<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_certification" model="ir.ui.view">
        <field name="name">hr.employee.form.certification</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <!-- Smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_certifications"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-certificate">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="cert_count"/>
                        </span>
                        <span class="o_stat_text">Certifications</span>
                    </div>
                </button>
            </xpath>

            <!-- New tab: Certifications -->
            <xpath expr="//page[@name='skills_resume']" position="after">
                <page string="Certifications" name="certifications">
                    <field name="certification_skill_ids">
                        <list editable="bottom"
                              decoration-danger="cert_status == 'expired'"
                              decoration-warning="cert_status == 'expiring'">
                            <field name="skill_type_id" invisible="1"/>
                            <field name="skill_id" options="{'no_create_edit': True}"/>
                            <field name="skill_level_id" options="{'no_create_edit': True}"/>
                            <field name="date_issued"/>
                            <field name="date_expiry"/>
                            <field name="certificate_number"/>
                            <field name="cert_status" widget="badge"
                                   decoration-success="cert_status == 'valid'"
                                   decoration-warning="cert_status == 'expiring'"
                                   decoration-danger="cert_status == 'expired'"
                                   decoration-muted="cert_status == 'no_date'"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
