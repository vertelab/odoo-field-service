<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fieldservice_order_view_form_inherit_maintenance" model="ir.ui.view">
        <field name="name">fieldservice.order.form.inherit.maintenance</field>
        <field name="model">fieldservice.order</field>
        <field name="inherit_id" ref="fieldservice_vrtl.view_fieldservice_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_maintenance_request"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-wrench"
                        invisible="not maintenance_request_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Maintenance</span>
                        <span class="o_stat_text">Request</span>
                    </div>
                </button>
            </xpath>

            <!-- Odoo 18: fieldservice.order har INGET partner_id i huvudformuläret
                 (bara i stakeholder-listan). Fälten läggs i group_top_left i
                 stället — samma grupp som order_number. -->
            <xpath expr="//group[@name='group_top_left']/field[@name='order_number']" position="after">
                <field name="equipment_id"
                       options="{'no_create': True}"
                       invisible="not equipment_id"/>
                <field name="maintenance_request_id"
                       readonly="1"
                       invisible="not maintenance_request_id"/>
            </xpath>

        </field>
    </record>

    <record id="fieldservice_order_view_search_inherit_maintenance" model="ir.ui.view">
        <field name="name">fieldservice.order.search.inherit.maintenance</field>
        <field name="model">fieldservice.order</field>
        <field name="inherit_id" ref="fieldservice_vrtl.view_fieldservice_order_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="equipment_id"/>
                <field name="maintenance_request_id"/>
            </xpath>
        </field>
    </record>

</odoo>
