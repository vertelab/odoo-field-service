<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════════════════
         Checklist-mallar.
         ════════════════════════════════════════════════════════════════ -->

    <record id="fieldservice_checklist_view_list" model="ir.ui.view">
        <field name="name">fieldservice.checklist.list</field>
        <field name="model">fieldservice.checklist</field>
        <field name="arch" type="xml">
            <list string="Checklist Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="line_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="fieldservice_checklist_view_form" model="ir.ui.view">
        <field name="name">fieldservice.checklist.form</field>
        <field name="model">fieldservice.checklist</field>
        <field name="arch" type="xml">
            <form string="Checklist Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Quarterly inspection"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items" name="items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fieldservice_checklist_view_search" model="ir.ui.view">
        <field name="name">fieldservice.checklist.search</field>
        <field name="model">fieldservice.checklist</field>
        <field name="arch" type="xml">
            <search string="Checklist Templates">
                <field name="name"/>
                <filter name="inactive" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_fieldservice_checklist" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">fieldservice.checklist</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
