<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form view for Requested Materials -->
    <record id="view_fieldservice_order_line_form_planning_inherit_material" model="ir.ui.view">
        <field name="name">fieldservice.order.line.form.inherit.material</field>
        <field name="model">fieldservice.order.line</field>
        <field name="inherit_id" ref="fieldservice_vrtl.view_fieldservice_order_line_form_planning"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook[@name='planning_notebook']" position="inside">
                <page string="Requested materials">
                    <group>
                        <field name="requested_material_ids" string=" ">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="product_uom_qty"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Form view for Used Materials -->
    <record id="view_fieldservice_order_line_form_reporting_inherit_material" model="ir.ui.view">
        <field name="name">fieldservice.order.line.form.inherit.material</field>
        <field name="model">fieldservice.order.line</field>
        <field name="inherit_id" ref="fieldservice_vrtl.view_fieldservice_order_line_form_reporting"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook[@name='reporting_notebook']" position="inside">
                <page string="Used Materials">
                    <group>
                        <field name="requested_material_ids" string=" ">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="product_uom_qty"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>


    <record id="view_fieldservice_order_form_inherit_material" model="ir.ui.view">
        <field name="name">fieldservice.order.form.inherit.material</field>
        <field name="model">fieldservice.order</field>
        <field name="inherit_id" ref="fieldservice_vrtl.view_fieldservice_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook//field[@name='order_line_ids']/list" position="inside">
                <field name="used_material_ids" widget="many2many_tags" optional ="hide">
                </field>
                <field name="requested_material_ids" widget="many2many_tags" optional ="hide">

                </field>
            </xpath>
        </field>
    </record>

</odoo>
