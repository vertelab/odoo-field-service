<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <record id="module_category_key_management" model="ir.module.category">
        <field name="name">Key Management</field>
        <field name="description">Manage keys and key positions for field service</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_key_management_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_key_management"/>
        <field name="implied_ids" eval="[(4, ref('fieldservice_vrtl.fieldservice_group_user'))]"/>
    </record>

    <record id="group_key_management_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_key_management"/>
        <field name="implied_ids" eval="[(4, ref('group_key_management_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="rule_key_position_user" model="ir.rule">
        <field name="name">Key Position: User Read-Only</field>
        <field name="model_id" ref="model_elevata_key_position"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_key_management_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_key_position_manager" model="ir.rule">
        <field name="name">Key Position: Manager Full Access</field>
        <field name="model_id" ref="model_elevata_key_position"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_key_management_manager'))]"/>
    </record>

    <record id="rule_key_user" model="ir.rule">
        <field name="name">Key: User Read-Only</field>
        <field name="model_id" ref="model_elevata_key"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_key_management_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_key_manager" model="ir.rule">
        <field name="name">Key: Manager Full Access</field>
        <field name="model_id" ref="model_elevata_key"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_key_management_manager'))]"/>
    </record>

</odoo>
