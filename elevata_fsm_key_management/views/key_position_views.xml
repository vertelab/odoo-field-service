<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_key_position_search" model="ir.ui.view">
        <field name="name">elevata.key.position.search</field>
        <field name="model">elevata.key.position</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="street"/>
                <field name="city"/>
                <field name="position_type"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Key Tube" name="key_tube" domain="[('position_type', '=', 'key_tube')]"/>
                <filter string="Shaft" name="shaft" domain="[('position_type', '=', 'shaft')]"/>
                <filter string="Safe" name="safe" domain="[('position_type', '=', 'safe')]"/>
                <filter string="Other" name="other" domain="[('position_type', '=', 'other')]"/>
            </search>
        </field>
    </record>

    <record id="view_key_position_form" model="ir.ui.view">
        <field name="name">elevata.key.position.form</field>
        <field name="model">elevata.key.position</field>
        <field name="arch" type="xml">
            <form string="Key Position">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="position_type"/>
                            <field name="code"/>
                            <field name="owner_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="zip"/>
                            <field name="city"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Keys" name="keys">
                            <field name="key_ids"/>
                        </page>
                        <page string="Elevators" name="elevators">
                            <field name="elevator_ids" readonly="1"/>
                        </page>
                        <page string="Geolocation" name="geolocation">
                            <group>
                                <group string="Geolocation">
                                    <label for="date_localization" string="Position"/>
                                    <div>
                                        <span>Lat: <field name="latitude" nolabel="1" class="oe_inline"/></span>
                                        <br/>
                                        <span>Long: <field name="longitude" nolabel="1" class="oe_inline"/></span>
                                        <br/>
                                        <span invisible="not date_localization">
                                            Updated: <field name="date_localization" nolabel="1" readonly="1" class="oe_inline"/>
                                            <br/>
                                        </span>
                                        <div name="geo_localize_button">
                                            <button invisible="latitude != 0 or longitude != 0"
                                                    icon="fa-gear" string="Compute from address"
                                                    title="Compute position"
                                                    name="action_geo_localize" type="object"
                                                    class="btn btn-link p-0"/>
                                            <button invisible="latitude == 0 and longitude == 0"
                                                    icon="fa-refresh" string="Refresh"
                                                    title="Refresh position"
                                                    name="action_geo_localize" type="object"
                                                    class="btn btn-link p-0"/>
                                        </div>
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_key_position_tree" model="ir.ui.view">
        <field name="name">elevata.key.position.tree</field>
        <field name="model">elevata.key.position</field>
        <field name="arch" type="xml">
            <list string="Key Positions">
                <field name="name"/>
                <field name="street"/>
                <field name="zip"/>
                <field name="city"/>
                <field name="position_type"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

</odoo>
