<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fsm_order_form_key_inherit" model="ir.ui.view">
        <field name="name">fsm.order.form.key.inherit</field>
        <field name="model">fieldservice.order</field>
        <field name="inherit_id" ref="elevata_fsm_flow.fsm_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[1]" position="after">
                <group invisible="not key_ids">
                    <field name="key_ids" readonly="1" widget="many2many_tags"
                           options="{'no_create': True}" string="Key Number"/>
                    <field name="key_codes" readonly="1" invisible="not key_codes"
                           string="Codes/Notes"/>
                    <field name="key_position_addresses" readonly="1"
                           invisible="not key_position_addresses"
                           string="Key Position" widget="url_text"
                           options="{'url_field': 'key_position_map_url', 'target': '_blank'}"/>
                    <field name="key_position_codes" readonly="1"
                           invisible="not key_position_codes"
                           string="Key Position Code"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
