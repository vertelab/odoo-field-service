<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_key_search" model="ir.ui.view">
        <field name="name">elevata.key.search</field>
        <field name="model">elevata.key</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="position_id"/>
                <field name="owner_id"/>
                <field name="elevator_ids"/>
                <filter string="Service Keys" name="service"
                        domain="[('key_type', '=', 'service')]"/>
                <filter string="Master Keys" name="master"
                        domain="[('key_type', '=', 'master')]"/>
                <filter string="Emergency Keys" name="emergency"
                        domain="[('key_type', '=', 'emergency')]"/>
                <separator/>
                <filter string="Not Returned" name="not_returned"
                        domain="[('issued_date', '!=', False), ('returned_date', '=', False)]"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Key Position" name="group_position"
                        context="{'group_by': 'position_id'}"/>
                <filter string="Key Type" name="group_key_type"
                        context="{'group_by': 'key_type'}"/>
                <filter string="Owner" name="group_owner"
                        context="{'group_by': 'owner_id'}"/>
            </search>
        </field>
    </record>

</odoo>
