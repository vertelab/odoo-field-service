    <record id="view_fieldservice_order_line_employee_list" model="ir.ui.view">
        <field name="name">fieldservice.order.line.employee.list</field>
        <field name="model">fieldservice.order.line.employee</field>
        <field name="arch" type="xml">
            <list string="External Views">
                <field name="fieldservice_order_line_id"/>
                <field name="employee_id"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_fieldservice_order_line_employee_pivot" model="ir.ui.view">
        <field name="name">fieldservice.order.line.employee.view.pivot</field>
        <field name="model">fieldservice.order.line.employee</field>
        <field name="arch" type="xml">
            <pivot string="Service Request">

            </pivot>
        </field>
    </record>

    <record id="view_fieldservice_order_line_employee_search" model="ir.ui.view">
        <field name="name">fieldservice.order.line.employee.search</field>
        <field name="model">fieldservice.order.line.employee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="hr_department_id"/>
                <field name="employee_id"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'hr_department_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_fieldservice_employees" model="ir.actions.act_window">
        <field name="name">Field Service Employees</field>
        <field name="res_model">fieldservice.order.line.employee</field>
        <field name="view_mode">kanban,form,list,pivot,calendar</field>
    </record>

    <menuitem id="menu_fieldservice_employees" name="Employees" parent="fieldservice_vrtl.menu_fieldservice_root" action="action_fieldservice_employees" sequence="20"/>

</odoo>




    
