<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard Action -->
    <record id="action_elevata_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">fieldservice.order</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{
            'graph_measure': '__count__',
            'graph_groupbys': ['stage_id'],
            'graph_mode': 'bar',
        }</field>
    </record>

    <!-- Work Orders per Month (graph) -->
    <record id="view_dashboard_orders_per_month" model="ir.ui.view">
        <field name="name">fieldservice.order.graph.dashboard.month</field>
        <field name="model">fieldservice.order</field>
        <field name="arch" type="xml">
            <graph string="Work Orders per Month" type="bar">
                <field name="planned_start_datetime" interval="month"/>
                <field name="product_tmpl_id" type="col"/>
            </graph>
        </field>
    </record>

    <!-- Contracts Expiring Soon (tree) -->
    <record id="view_dashboard_contracts_expiring" model="ir.ui.view">
        <field name="name">elevata.service.contract.list.expiring</field>
        <field name="model">elevata.service.contract</field>
        <field name="arch" type="xml">
            <list string="Contracts Expiring Within 90 Days" decoration-warning="True">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_end"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_dashboard_contracts_expiring" model="ir.actions.act_window">
        <field name="name">Contracts Expiring Within 90 Days</field>
        <field name="res_model">elevata.service.contract</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[
            ('state', '=', 'confirmed'),
            ('date_end', '&lt;=', (context_today() + datetime.timedelta(days=90)).strftime('%Y-%m-%d')),
            ('date_end', '&gt;=', context_today().strftime('%Y-%m-%d')),
        ]</field>
        <field name="view_id" ref="view_dashboard_contracts_expiring"/>
    </record>

    <!-- Offers Pipeline (kanban) -->
    <record id="action_dashboard_offer_pipeline" model="ir.actions.act_window">
        <field name="name">Offer Pipeline</field>
        <field name="res_model">elevata.offer</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state', 'not in', ['won', 'lost', 'expired'])]</field>
    </record>

    <!-- Work Orders This Month -->
    <record id="action_dashboard_orders_month" model="ir.actions.act_window">
        <field name="name">Work Orders — This Month</field>
        <field name="res_model">fieldservice.order</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="view_dashboard_orders_per_month"/>
    </record>

    <!-- Inspections Next 60 Days -->
    <record id="action_dashboard_inspections_soon" model="ir.actions.act_window">
        <field name="name">Inspections — Next 60 Days</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[
            ('next_inspection', '&lt;=', (context_today() + datetime.timedelta(days=60)).strftime('%Y-%m-%d')),
            ('next_inspection', '&gt;=', context_today().strftime('%Y-%m-%d')),
        ]</field>
    </record>


</odoo>
