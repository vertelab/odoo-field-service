<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Hide the Location Workers menu.

             Our field service fork replaced fsm.person with hr.employee, so
             workers are no longer managed per location. The menu only exists
             on databases where the OCA fieldservice module once ran, so it is
             looked up by name rather than by xmlid — a <record> on a foreign
             xmlid would abort the install when the menu is absent. -->
        <function model="ir.ui.menu" name="_elevata_hide_location_workers"/>

    </data>
</odoo>
