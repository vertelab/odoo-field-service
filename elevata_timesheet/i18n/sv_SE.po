#. module: elevata_timesheet
#: model:mail.template,body_html:elevata_timesheet.mail_template_fsm_order_completed
msgid ""
"\n"
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"    <p>Dear {{ object.customer_id.name }},</p>\n"
"    <p>Work order <strong>{{ object.name }}</strong> has been completed.</p>\n"
"    <table style=\"width: 100%; border-collapse: collapse; margin: 16px 0;\">\n"
"        <tr style=\"background: #f0f8ff;\">\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Order</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.name }}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Location</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.location_id.name or '-' }}</td>\n"
"        </tr>\n"
"        <tr style=\"background: #f0f8ff;\">\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Type</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.type.name if object.type else '-' }}</td>\n"
"        </tr>\n"
"    </table>\n"
"    <p><strong>Description:</strong><br/>{{ object.description or '-' }}</p>\n"
"    <p><strong>Resolution:</strong><br/>{{ object.resolution or '-' }}</p>\n"
"    <p>Please contact us if you have any questions.</p>\n"
"    <p>Best regards,<br/>\n"
"    {{ object.company_id.name or object.env.company.name }}<br/>\n"
"    {{ object.company_id.phone or object.env.company.phone }}</p>\n"
"</div>\n"
"            "
msgstr "\\n\"\"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\\n\"\"    <p>Dear {{ object.customer_id.name }},</p>\\n\"\"    <p>Work order <strong>{{ object.name }}</strong> has been completed.</p>\\n\"\"    <table style=\"width: 100%; border-collapse: collapse; margin: 16px 0;\">\\n\"\"        <tr style=\"background: #f0f8ff;\">\\n\"\"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Order</strong></td>\\n\"\"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.name }}</td>\\n\"\"        </tr>\\n\"\"        <tr>\\n\"\"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Location</strong></td>\\n\"\"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.location_id.name or '-' }}</td>\\n\"\"        </tr>\\n\"\"        <tr style=\"background: #f0f8ff;\">\\n\"\"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Type</strong></td>\\n\"\"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.type.name if object.type else '-' }}</td>\\n\"\"        </tr>\\n\"\"    </table>\\n\"\"    <p><strong>Description:</strong><br/>{{ object.description or '-' }}</p>\\n\"\"    <p><strong>Resolution:</strong><br/>{{ object.resolution or '-' }}</p>\\n\"\"    <p>Please contact us if you have any questions.</p>\\n\"\"    <p>Best regards,<br/>\\n\"\"    {{ object.company_id.name or object.env.company.name }}<br/>\\n\"\"    {{ object.company_id.phone or object.env.company.phone }}</p>\\n\"\"</div>\\n\"\"            "

#. module: elevata_timesheet
#: model:mail.template,body_html:elevata_timesheet.mail_template_fsm_order_assigned
msgid ""
"\n"
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"    <p>Hi {{ object.person_id.name or 'technician' }},</p>\n"
"    <p>You have been assigned work order <strong>{{ object.name }}</strong>.</p>\n"
"    <table style=\"width: 100%; border-collapse: collapse; margin: 16px 0;\">\n"
"        <tr style=\"background: #f0f8ff;\">\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Order</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.name }}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Location</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.location_id.name or '-' }}</td>\n"
"        </tr>\n"
"        <tr style=\"background: #f0f8ff;\">\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Address</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.location_id.street or '' }}, {{ object.location_id.city or '' }}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Type</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.type.name if object.type else '-' }}</td>\n"
"        </tr>\n"
"        <tr style=\"background: #f0f8ff;\">\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Scheduled start</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.scheduled_date_start or 'Not scheduled' }}</td>\n"
"        </tr>\n"
"    </table>\n"
"    <p>{{ object.description or '' }}</p>\n"
"    <p>Contact the office if you have questions.</p>\n"
"</div>\n"
"            "
msgstr "\\n\"\"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\\n\"\"    <p>Hi {{ object.person_id.name or 'technician' }},</p>\\n\"\"    <p>You have been assigned work order <strong>{{ object.name }}</strong>.</p>\\n\"\"    <table style=\"width: 100%; border-collapse: collapse; margin: 16px 0;\">\\n\"\"        <tr style=\"background: #f0f8ff;\">\\n\"\"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Order</strong></td>\\n\"\"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.name }}</td>\\n\"\"        </tr>\\n\"\"        <tr>\\n\"\"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Location</strong></td>\\n\"\"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.location_id.name or '-' }}</td>\\n\"\"        </tr>\\n\"\"        <tr style=\"background: #f0f8ff;\">\\n\"\"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Address</strong></td>\\n\"\"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.location_id.street or '' }}, {{ object.location_id.city or '' }}</td>\\n\"\"        </tr>\\n\"\"        <tr>\\n\"\"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Type</strong></td>\\n\"\"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.type.name if object.type else '-' }}</td>\\n\"\"        </tr>\\n\"\"        <tr style=\"background: #f0f8ff;\">\\n\"\"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Scheduled start</strong></td>\\n\"\"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.scheduled_date_start or 'Not scheduled' }}</td>\\n\"\"        </tr>\\n\"\"    </table>\\n\"\"    <p>{{ object.description or '' }}</p>\\n\"\"    <p>Contact the office if you have questions.</p>\\n\"\"</div>\\n\"\"            "

