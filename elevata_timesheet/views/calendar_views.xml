<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_calendar_event_calendar_elevata" model="ir.ui.view">
        <field name="name">calendar.event.calendar.elevata</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_calendar"/>
        <field name="arch" type="xml">
            <xpath expr="//calendar" position="attributes">
                <attribute name="color">elevata_color</attribute>
            </xpath>
            <xpath expr="//field[@name='is_highlighted']" position="after">
                <field name="elevata_color" invisible="1"/>
                <field name="elevata_fsm_order_id" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
