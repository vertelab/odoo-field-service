<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Timesheet form: add start/end time -->
    <record id="hr_timesheet_line_form_time" model="ir.ui.view">
        <field name="name">account.analytic.line.form.time</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_form"/>
        <field name="priority">17</field>
        <field name="arch" type="xml">
            <field name="unit_amount" position="before">
                <field name="time_start" widget="timepicker_field"/>
                <field name="time_end" widget="timepicker_field"/>
            </field>
        </field>
    </record>

    <!-- Timesheet tree: add start/end time -->
    <record id="hr_timesheet_line_tree_time" model="ir.ui.view">
        <field name="name">account.analytic.line.tree.time</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_tree"/>
        <field name="priority">17</field>
        <field name="arch" type="xml">
            <field name="unit_amount" position="before">
                <field name="time_start" widget="timepicker_field"/>
                <field name="time_end" widget="timepicker_field"/>
            </field>
        </field>
    </record>

    <!-- Consolidated Time &amp; Material tab on FSM Order -->
    <record id="fsm_order_form_timesheet_ext" model="ir.ui.view">
        <field name="name">fsm.order.form.timesheet.ext</field>
        <field name="model">fieldservice.order</field>
        <field name="inherit_id" ref="elevata_fsm_flow.fsm_order_form"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">

            <!-- Hide old accounting_new tab if present -->
            <xpath expr="//page[@name='accounting_new']" position="replace">
                <page name="accounting_new" invisible="1"/>
            </xpath>

            <!-- Hide old tidrapport_tab if present -->
            <xpath expr="//page[@name='tidrapport_tab']" position="replace">
                <page name="tidrapport_tab" invisible="1"/>
            </xpath>

            <!-- Hide scheduling_fields_tab from elevata_service_contract -->
            <xpath expr="//page[@name='scheduling_fields_tab']" position="replace">
                <page name="scheduling_fields_tab" invisible="1"/>
            </xpath>

            <!-- Planering-flik (konsoliderad) — läggs in först -->
            <xpath expr="//notebook/page[1]" position="before">
                <page name="planering_tab" string="Planering" sequence="6">
                    <group>
                        <group string="Schemaläggning">
                            <field name="planned_start_datetime" string="Planerad start"/>
                            <field name="planned_duration" string="Planerad längd (timmar)"/>
                        </group>
                        <group string="Önskat tidsfönster">
                            <field name="deadline_datetime" string="Senast klar"/>
                        </group>
                    </group>
                    <separator string="Planeringsrader"/>
                    <field name="planning_line_ids" nolabel="1" colspan="2">
                        <list editable="bottom" default_order="date_start">
                            <field name="requested_employee_ids" string="Tekniker"/>
                            <field name="planning_date" string="Datum" required="1"/>
                            <field name="time_start" widget="timepicker_field" string="Start"/>
                            <field name="time_end" widget="timepicker_field" string="Slut"/>
                            <field name="is_confirmed" string="Bokad" help="Bokad med kund"/>
                            <field name="note" string="Anteckning" optional="show"/>
                            <field name="calendar_event_id" string="Kalender" readonly="1" optional="hide"/>
                            <button name="action_convert_to_timesheet"
                                    type="object"
                                    string="→ Tidrapport"
                                    class="btn-link"
                                    icon="fa-clock-o"
                                    confirm="Konvertera planeringsraden till tidrapport? Planeringsraden tas bort."/>
                        </list>
                    </field>
                </page>
            </xpath>

            <!-- Tid & material — läggs in före planering_tab (som nu är page[1]) -->
            <xpath expr="//notebook/page[1]" position="before">
                <page name="tid_material_consolidated" string="Tid &amp; material" sequence="5">

                    <header>
                        <button name="account_create_invoice"
                                string="Skapa faktura"
                                class="oe_highlight" type="object"
                                groups="account.group_account_invoice"
                                invisible="account_stage != 'confirmed'"/>
                        <button name="account_confirm"
                                string="Bekräfta"
                                type="object"
                                groups="account.group_account_invoice"
                                invisible="account_stage != 'review'"/>
                        <button name="account_no_invoice"
                                string="Ingen faktura"
                                type="object"
                                groups="account.group_account_invoice"
                                invisible="not is_closed or account_stage not in ('draft','review')"/>
                        <field name="account_stage" widget="statusbar"/>
                    </header>

                    <group name="bill_to_ext" invisible="1">
                        <field name="bill_to" widget="radio"
                               options="{'horizontal': true}" required="1"/>
                    </group>

                    <!-- Contract rate info box -->
                    <div invisible="not elevata_contract_type"
                         style="background:#f0f8ff; border:1px solid #b8d4ea; border-radius:6px; padding:10px 16px; margin-bottom:12px;">
                        <strong>Avtalade timpriser (<field name="elevata_contract_type" readonly="1" nolabel="1"/>):</strong>
                    </div>

                    <!-- Tid -->
                    <separator string="Tid"/>
                    <field name="employee_timesheet_ids" nolabel="1"
                           context="{'default_project_id': project_id, 'default_task_id': task_id, 'default_fsm_order_id': id}"
                           colspan="2">
                        <list editable="bottom" default_order="date">
                            <field name="employee_id" required="1" string="Tekniker"/>
                            <field name="date" string="Datum"/>
                            <field name="time_start" widget="timepicker_field" string="Start"/>
                            <field name="time_end" widget="timepicker_field" string="Slut"/>
                            <field name="unit_amount" string="Timmar" widget="float_time"/>
                            <field name="project_id" string="Projekt" optional="hide"/>
                            <field name="rate_type" string="Pristyp"/>
                            <field name="name" string="Beskrivning"/>
                            <field name="fsm_order_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer" col="2">
                        <field name="employee_time_total" string="Totalt timmar" readonly="1"/>
                    </group>

                    <!-- Material -->
                    <separator string="Material"/>
                    <field name="contractor_cost_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="product_id" required="1" string="Produkt"/>
                            <field name="quantity" required="1" string="Antal"/>
                            <field name="price_unit" required="1" string="Enhetspris"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer" col="2">
                        <field name="contractor_total" string="Totalt material" readonly="1"/>
                    </group>

                </page>
            </xpath>

        </field>
    </record>

    <!-- Kalendervy för tidrapporter -->
    <record id="hr_timesheet_line_calendar" model="ir.ui.view">
        <field name="name">account.analytic.line.calendar.elevata</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <calendar string="Tidrapporter"
                      date_start="datetime_start"
                      date_stop="datetime_end"
                      color="employee_id"
                      mode="week"
                      event_open_popup="true"
                      quick_create="false">
                <field name="employee_id" filters="1" avatar_field="image_128"/>
                <field name="name"/>
                <field name="unit_amount" widget="float_time"/>
                <field name="project_id"/>
            </calendar>
        </field>
    </record>

    <!-- Lägg till calendar i "Mina tidrapporter" och gör den till default -->
    <record id="hr_timesheet.act_hr_timesheet_line" model="ir.actions.act_window">
        <field name="view_mode">calendar,list,form,kanban,pivot,graph</field>
    </record>

    <!-- Odoo 18: hr_timesheet_calendar already registers the calendar view on
         this action (act_window_view_unique_mode_per_action). Removed here. -->

    <!-- Lägg till calendar i "Alla tidrapporter" -->
    <record id="hr_timesheet.timesheet_action_all" model="ir.actions.act_window">
        <field name="view_mode">calendar,list,form,kanban,pivot,graph</field>
    </record>

    <record id="timesheet_action_all_view_calendar" model="ir.actions.act_window.view">
        <field name="view_mode">calendar</field>
        <field name="sequence" eval="1"/>
        <field name="view_id" ref="hr_timesheet_calendar.hr_timesheet_line_calendar"/>
        <field name="act_window_id" ref="hr_timesheet.timesheet_action_all"/>
    </record>

</odoo>
