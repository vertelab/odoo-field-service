<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_elevata_calendar" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.elevata.calendar</field>
        <field name="priority" eval="200"/>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Elevata Kalender" string="Elevata Kalender" name="elevata_timesheet" groups="base.group_system">
                    <h2>Elevata Calendar Colors</h2>
                    <div class="row mt16 o_settings_container">

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Planned (not booked)</span>
                                <div class="text-muted">
                                    Events with category "Planering ej bokad"
                                </div>
                                <div class="content-group">
                                    <div class="row mt8">
                                        <div class="col-4">
                                            <label for="calendar_color_planned_bg" string="Background"/>
                                            <field name="calendar_color_planned_bg"/>
                                        </div>
                                        <div class="col-4">
                                            <label for="calendar_color_planned_border" string="Border"/>
                                            <field name="calendar_color_planned_border"/>
                                        </div>
                                        <div class="col-4">
                                            <label for="calendar_color_planned_text" string="Text"/>
                                            <field name="calendar_color_planned_text"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Planned Booked</span>
                                <div class="text-muted">
                                    Events with category "Planering bokad"
                                </div>
                                <div class="content-group">
                                    <div class="row mt8">
                                        <div class="col-4">
                                            <label for="calendar_color_booked_bg" string="Background"/>
                                            <field name="calendar_color_booked_bg"/>
                                        </div>
                                        <div class="col-4">
                                            <label for="calendar_color_booked_border" string="Border"/>
                                            <field name="calendar_color_booked_border"/>
                                        </div>
                                        <div class="col-4">
                                            <label for="calendar_color_booked_text" string="Text"/>
                                            <field name="calendar_color_booked_text"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Timesheet</span>
                                <div class="text-muted">
                                    Events with category "Tidrapport"
                                </div>
                                <div class="content-group">
                                    <div class="row mt8">
                                        <div class="col-4">
                                            <label for="calendar_color_timesheet_bg" string="Background"/>
                                            <field name="calendar_color_timesheet_bg"/>
                                        </div>
                                        <div class="col-4">
                                            <label for="calendar_color_timesheet_border" string="Border"/>
                                            <field name="calendar_color_timesheet_border"/>
                                        </div>
                                        <div class="col-4">
                                            <label for="calendar_color_timesheet_text" string="Text"/>
                                            <field name="calendar_color_timesheet_text"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Timesheet Locked</span>
                                <div class="text-muted">
                                    Events with category "Låst tidrapport"
                                </div>
                                <div class="content-group">
                                    <div class="row mt8">
                                        <div class="col-4">
                                            <label for="calendar_color_timesheet_locked_bg" string="Background"/>
                                            <field name="calendar_color_timesheet_locked_bg"/>
                                        </div>
                                        <div class="col-4">
                                            <label for="calendar_color_timesheet_locked_border" string="Border"/>
                                            <field name="calendar_color_timesheet_locked_border"/>
                                        </div>
                                        <div class="col-4">
                                            <label for="calendar_color_timesheet_locked_text" string="Text"/>
                                            <field name="calendar_color_timesheet_locked_text"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
