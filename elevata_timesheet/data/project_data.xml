<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Idempotent: the "Field Service" project and the "Elevator Object"
         analytic plan already exist in this database, so a plain <record>
         would create a duplicate. Reuse the existing one when present. -->
    <function model="project.project" name="_elevata_get_or_create_project">
        <value>Field Service</value>
    </function>

    <function model="account.analytic.plan" name="_elevata_get_or_create_plan">
        <value>Elevator Object</value>
    </function>

</odoo>
