<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Planned (not booked) — Green -->
        <record id="config_color_planned_bg" model="ir.config_parameter">
            <field name="key">elevata_timesheet.color_planned_bg</field>
            <field name="value">#27ae60</field>
        </record>
        <record id="config_color_planned_border" model="ir.config_parameter">
            <field name="key">elevata_timesheet.color_planned_border</field>
            <field name="value">#1e8449</field>
        </record>
        <record id="config_color_planned_text" model="ir.config_parameter">
            <field name="key">elevata_timesheet.color_planned_text</field>
            <field name="value">#ffffff</field>
        </record>

        <!-- Planned booked — Red -->
        <record id="config_color_booked_bg" model="ir.config_parameter">
            <field name="key">elevata_timesheet.color_booked_bg</field>
            <field name="value">#e74c3c</field>
        </record>
        <record id="config_color_booked_border" model="ir.config_parameter">
            <field name="key">elevata_timesheet.color_booked_border</field>
            <field name="value">#a93226</field>
        </record>
        <record id="config_color_booked_text" model="ir.config_parameter">
            <field name="key">elevata_timesheet.color_booked_text</field>
            <field name="value">#ffffff</field>
        </record>

        <!-- Timesheet — Grey with border -->
        <record id="config_color_timesheet_bg" model="ir.config_parameter">
            <field name="key">elevata_timesheet.color_timesheet_bg</field>
            <field name="value">#95a5a6</field>
        </record>
        <record id="config_color_timesheet_border" model="ir.config_parameter">
            <field name="key">elevata_timesheet.color_timesheet_border</field>
            <field name="value">#717d7e</field>
        </record>
        <record id="config_color_timesheet_text" model="ir.config_parameter">
            <field name="key">elevata_timesheet.color_timesheet_text</field>
            <field name="value">#ffffff</field>
        </record>

        <!-- Timesheet locked — Light grey with border -->
        <record id="config_color_timesheet_locked_bg" model="ir.config_parameter">
            <field name="key">elevata_timesheet.color_timesheet_locked_bg</field>
            <field name="value">#bdc3c7</field>
        </record>
        <record id="config_color_timesheet_locked_border" model="ir.config_parameter">
            <field name="key">elevata_timesheet.color_timesheet_locked_border</field>
            <field name="value">#95a5a6</field>
        </record>
        <record id="config_color_timesheet_locked_text" model="ir.config_parameter">
            <field name="key">elevata_timesheet.color_timesheet_locked_text</field>
            <field name="value">#333333</field>
        </record>

    </data>
</odoo>
