<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_fsm_order_assigned" model="mail.template">
            <field name="name">Elevata: Work Order Assigned</field>
            <field name="model_id" ref="fieldservice_vrtl.model_fieldservice_order"/>
            <field name="subject">Work Order {{ object.name }} assigned — {{ object.equipment_id.name or '' }}</field>
            <field name="email_from">{{ (object.company_id.email or object.env.company.email) }}</field>
            <field name="email_to">{{ object.requested_employee_ids.email or '' }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <p>Hi {{ object.requested_employee_ids.name or 'technician' }},</p>
    <p>You have been assigned work order <strong>{{ object.name }}</strong>.</p>
    <table style="width: 100%; border-collapse: collapse; margin: 16px 0;">
        <tr style="background: #f0f8ff;">
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Order</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Location</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.equipment_id.name or '-' }}</td>
        </tr>
        <tr style="background: #f0f8ff;">
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Address</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.equipment_id.street or '' }}, {{ object.equipment_id.city or '' }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Type</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.type.name if object.type else '-' }}</td>
        </tr>
        <tr style="background: #f0f8ff;">
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Scheduled start</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.planned_start_datetime or 'Not scheduled' }}</td>
        </tr>
    </table>
    <p>{{ object.description or '' }}</p>
    <p>Contact the office if you have questions.</p>
</div>
            ]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <record id="mail_template_fsm_order_completed" model="mail.template">
            <field name="name">Elevata: Service Report Complete</field>
            <field name="model_id" ref="fieldservice_vrtl.model_fieldservice_order"/>
            <field name="subject">Service Report {{ object.name }} — {{ object.equipment_id.name or '' }}</field>
            <field name="email_from">{{ (object.company_id.email or object.env.company.email) }}</field>
            <field name="email_to">{{ object.customer_id.email or '' }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <p>Dear {{ object.customer_id.name }},</p>
    <p>Work order <strong>{{ object.name }}</strong> has been completed.</p>
    <table style="width: 100%; border-collapse: collapse; margin: 16px 0;">
        <tr style="background: #f0f8ff;">
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Order</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Location</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.equipment_id.name or '-' }}</td>
        </tr>
        <tr style="background: #f0f8ff;">
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Type</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.type.name if object.type else '-' }}</td>
        </tr>
    </table>
    <p><strong>Description:</strong><br/>{{ object.description or '-' }}</p>
    <p><strong>Resolution:</strong><br/>{{ object.resolution or '-' }}</p>
    <p>Please contact us if you have any questions.</p>
    <p>Best regards,<br/>
    {{ object.company_id.name or object.env.company.name }}<br/>
    {{ object.company_id.phone or object.env.company.phone }}</p>
</div>
            ]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

    </data>
</odoo>
