<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form: show elevator number as title above name -->
    <record id="maintenance_equipment_form_inherit_elevator_number" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.inherit.elevator.number</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <div class="oe_title">
                    <h1>
                        <field name="elevator_number" readonly="1"/>
                    </h1>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Search: add elevator_number to quick search -->
    <record id="maintenance_equipment_search_inherit_elevator_number" model="ir.ui.view">
        <field name="name">maintenance.equipment.search.inherit.elevator.number</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="elevator_number"/>
            </xpath>
        </field>
    </record>

</odoo>
