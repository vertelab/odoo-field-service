<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="maintenance_equipment_form_analytic" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.analytic</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Analytic" name="analytic_page">
                    <group>
                        <field name="analytic_account_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="property_property_form_analytic" model="ir.ui.view">
        <field name="name">property.property.form.analytic</field>
        <field name="model">property.property</field>
        <field name="inherit_id" ref="property_mgmt.property_property_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="analytic" string="Analytic">
                    <field name="analytic_account_id"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
