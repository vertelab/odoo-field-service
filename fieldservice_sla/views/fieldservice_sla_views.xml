<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_fieldservice_sla_form" model="ir.ui.view">
        <field name="name">fieldservice.sla.form</field>
        <field name="model">fieldservice.sla</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <field name ="description" placeholder="Description of the policy..."/>
                    <group name="group_left">
                        <group string="Criteria">
                            <p>This SLA Policy will apply to tickets matching ALL of the following criteria:</p>

                            <field name="severity_level"/>
                            <!-- <field name =""/> -->
                            <field name ="company_id"/>


                        </group>


                    </group>
                    <group>
                        <group string ="Target">
                            <field name ="stage_id"/>
                            <label for="time_within"/>
                            <div class="o_row" string ="Time Within">
                                <field name="time_within" widget="float_time" class="oe_inline"/>
                                <span class="o_field_widget o_readonly_modifier">Working Hours</span>
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fieldservice_sla_list" model="ir.ui.view">
        <field name="name">fieldservice.sla.list</field>
        <field name="model">fieldservice.sla</field>
        <field name="arch" type="xml">
            <list>

                <field name="name"/>
                <field name="severity_level"/>
                <!-- <field name =""/> -->


            </list>
        </field>
    </record>

    <record id="action_fieldservice_sla" model="ir.actions.act_window">
        <field name="name"> Field Service SLA</field>
        <field name="res_model">fieldservice.sla</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <menuitem id="menu_fieldservice_sla" name="Field service SLA" action="action_fieldservice_sla" parent="fieldservice_vrtl.configurations" sequence="10" />

</odoo>