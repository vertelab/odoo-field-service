<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled SLA work is declared as cron.task, not ir.cron.
             cron_tick resolves model_name + method_name at run time and raises
             a descriptive UserError if the method is gone, instead of failing
             silently every interval. See design D4. -->

        <record id="cron_task_sla_check_breach" model="cron.task">
            <field name="name">SLA: check breaches</field>
            <field name="technical_name">sla_check_breach</field>
            <field name="model_name">fieldservice.sla</field>
            <field name="method_name">check_all_slas</field>
            <field name="cadence">hour</field>
            <field name="module">fieldservice_sla</field>
            <field name="sequence">10</field>
        </record>

        <record id="cron_task_sla_notify_breach" model="cron.task">
            <field name="name">SLA: notify breaches</field>
            <field name="technical_name">sla_notify_breach</field>
            <field name="model_name">fieldservice.sla</field>
            <field name="method_name">notify_sla_breach</field>
            <field name="cadence">hour</field>
            <field name="module">fieldservice_sla</field>
            <field name="sequence">20</field>
        </record>
    </data>
</odoo>
