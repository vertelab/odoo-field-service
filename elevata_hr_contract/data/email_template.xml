<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="email_template_contract" model="mail.template">
        <field name="name">Anställningsavtal</field>
        <field name="model_id" ref="hr_contract.model_hr_contract"/>
        <field name="email_from">{{ (object.company_id.email or object.env.user.email_formatted) }}</field>
        <field name="email_to">{{ object.employee_id.work_email or '' }}</field>
        <field name="subject">Anställningsavtal — {{ object.employee_id.name }}</field>
        <field name="body_html"><![CDATA[
<div style="font-family:'Segoe UI',Arial,sans-serif;font-size:13px;color:#333;max-width:600px;margin:0 auto;">
    <p>Hej {{ object.employee_id.name }},</p>
    <p>Bifogat finner du ditt anställningsavtal hos {{ object.company_id.name }}.</p>
    <table style="width:100%;border-collapse:collapse;margin:16px 0;">
        <tr><td style="padding:4px 8px;color:#64748b;">Avtalsnummer</td><td style="padding:4px 8px;font-weight:600;">{{ object.name }}</td></tr>
        <tr><td style="padding:4px 8px;color:#64748b;">Startdatum</td><td style="padding:4px 8px;">{{ object.date_start }}</td></tr>
        <tr><td style="padding:4px 8px;color:#64748b;">Befattning</td><td style="padding:4px 8px;">{{ object.job_id.name or '–' }}</td></tr>
    </table>
    <p>Vänligen granska avtalet och kontakta oss om du har frågor.</p>
    <p>Med vänlig hälsning,<br/>{{ object.company_id.name }}</p>
</div>
]]>
        </field>
        <field name="report_template_ids" eval="[(6, 0, [ref('action_report_hr_contract')])]"/>
        <field name="lang">{{ object.employee_id.lang }}</field>
        <field name="auto_delete" eval="False"/>
    </record>

</odoo>
