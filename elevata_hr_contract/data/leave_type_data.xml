<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Ledighetstyp: Semester (krävs för automatisk semestertilldelning) -->
        <record id="leave_type_semester" model="hr.leave.type">
            <field name="name">Vacation</field>
            <field name="requires_allocation">yes</field>
            <field name="employee_requests">no</field>
            <field name="allocation_validation_type">no_validation</field>
            <field name="leave_validation_type">manager</field>
            <field name="create_calendar_meeting" eval="True"/>
            <field name="sequence">1</field>
            <field name="color">3</field>
        </record>

    </data>
</odoo>
