<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_hr_contract" model="ir.actions.report">
        <field name="name">Anställningsavtal</field>
        <field name="model">hr.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">elevata_hr_contract.report_contract_document</field>
        <field name="report_file">elevata_hr_contract.report_contract_document</field>
        <field name="print_report_name">'Anställningsavtal - %s' % object.employee_id.name</field>
        <field name="binding_model_id" ref="hr_contract.model_hr_contract"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_contract_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <style>
                        .contract-doc { font-family: 'Segoe UI', Arial, sans-serif; font-size: 11pt; color: #253448; line-height: 1.6; }
                        .contract-doc h1 { font-size: 22pt; font-weight: 700; color: #2F4560; margin: 0 0 8mm; }
                        .contract-doc h2 { font-size: 14pt; font-weight: 600; color: #2F4560; margin: 10mm 0 4mm; border-bottom: 1px solid #cbd5df; padding-bottom: 2mm; }
                        .contract-doc .field-row { display: flex; padding: 2mm 0; }
                        .contract-doc .field-label { width: 55mm; font-weight: 600; color: #64748b; flex-shrink: 0; }
                        .contract-doc .field-value { flex: 1; }
                        .contract-doc .sig-block { margin-top: 20mm; display: flex; gap: 20mm; }
                        .contract-doc .sig-area { flex: 1; border-top: 1px solid #253448; padding-top: 3mm; }
                        .contract-doc .sig-area span { display: block; font-size: 9pt; color: #64748b; }
                        .contract-doc .notes { background: #f8f9fa; padding: 5mm; border-radius: 3px; margin-top: 5mm; font-size: 10pt; }
                    </style>
                    <div class="contract-doc page">
                        <h1>Anställningsavtal</h1>

                        <h2>Parterna</h2>
                        <div class="field-row">
                            <div class="field-label">Arbetsgivare</div>
                            <div class="field-value"><t t-out="doc.company_id.name"/></div>
                        </div>
                        <div class="field-row">
                            <div class="field-label">Org.nummer</div>
                            <div class="field-value"><t t-out="doc.company_id.vat or doc.company_id.company_registry or '–'"/></div>
                        </div>
                        <div class="field-row">
                            <div class="field-label">Adress</div>
                            <div class="field-value"><t t-out="', '.join(x for x in [doc.company_id.street, doc.company_id.zip, doc.company_id.city] if x)"/></div>
                        </div>
                        <div class="field-row">
                            <div class="field-label">Anställd</div>
                            <div class="field-value"><t t-out="doc.employee_id.name"/></div>
                        </div>
                        <div class="field-row" t-if="doc.employee_id.identification_id">
                            <div class="field-label">Personnummer</div>
                            <div class="field-value"><t t-out="doc.employee_id.identification_id"/></div>
                        </div>
                        <div class="field-row" t-if="doc.employee_id.work_contact_id.street">
                            <div class="field-label">Adress</div>
                            <div class="field-value"><t t-out="', '.join(x for x in [doc.employee_id.work_contact_id.street, doc.employee_id.work_contact_id.city] if x)"/></div>
                        </div>

                        <h2>Anställning</h2>
                        <div class="field-row">
                            <div class="field-label">Avtalsnummer</div>
                            <div class="field-value"><t t-out="doc.name"/></div>
                        </div>
                        <div class="field-row" t-if="doc.contract_type_id">
                            <div class="field-label">Anställningsform</div>
                            <div class="field-value"><t t-out="doc.contract_type_id.name"/></div>
                        </div>
                        <div class="field-row">
                            <div class="field-label">Startdatum</div>
                            <div class="field-value"><t t-out="doc.date_start"/></div>
                        </div>
                        <div class="field-row" t-if="doc.date_end">
                            <div class="field-label">Slutdatum</div>
                            <div class="field-value"><t t-out="doc.date_end"/></div>
                        </div>
                        <div class="field-row" t-if="doc.probation_end_date">
                            <div class="field-label">Provanställning t.o.m.</div>
                            <div class="field-value"><t t-out="doc.probation_end_date"/></div>
                        </div>
                        <div class="field-row" t-if="doc.job_id">
                            <div class="field-label">Befattning</div>
                            <div class="field-value"><t t-out="doc.job_id.name"/></div>
                        </div>
                        <div class="field-row" t-if="doc.department_id">
                            <div class="field-label">Avdelning</div>
                            <div class="field-value"><t t-out="doc.department_id.name"/></div>
                        </div>
                        <div class="field-row" t-if="doc.work_location">
                            <div class="field-label">Arbetsplats</div>
                            <div class="field-value">
                                <t t-if="doc.work_location == 'office'">Företagsadress</t>
                                <t t-if="doc.work_location == 'home'">Hemstationerad</t>
                                <t t-if="doc.work_location == 'field'">Fältarbete</t>
                                <t t-if="doc.work_location == 'hybrid'">Hybrid</t>
                            </div>
                        </div>
                        <div class="field-row" t-if="doc.employment_percentage">
                            <div class="field-label">Tjänstgöringsgrad</div>
                            <div class="field-value"><t t-out="'%.0f' % doc.employment_percentage"/> %</div>
                        </div>
                        <div class="field-row" t-if="doc.resource_calendar_id">
                            <div class="field-label">Arbetstid</div>
                            <div class="field-value"><t t-out="doc.resource_calendar_id.name"/></div>
                        </div>

                        <h2>Lön</h2>
                        <div class="field-row" t-if="doc.wage_type">
                            <div class="field-label">Löneform</div>
                            <div class="field-value">
                                <t t-if="doc.wage_type == 'monthly'">Månadslön</t>
                                <t t-if="doc.wage_type == 'hourly'">Timlön</t>
                            </div>
                        </div>
                        <div class="field-row">
                            <div class="field-label">Månadslön</div>
                            <div class="field-value"><t t-out="'{:,.0f}'.format(doc.wage).replace(',', ' ')"/> kr</div>
                        </div>
                        <div class="field-row" t-if="doc.wage_type == 'hourly' and doc.hourly_wage">
                            <div class="field-label">Timlön</div>
                            <div class="field-value"><t t-out="'{:,.0f}'.format(doc.hourly_wage).replace(',', ' ')"/> kr</div>
                        </div>
                        <div class="field-row" t-if="doc.pay_frequency">
                            <div class="field-label">Löneutbetalning</div>
                            <div class="field-value">
                                <t t-if="doc.pay_frequency == 'monthly'">Månadsvis</t>
                                <t t-if="doc.pay_frequency == 'biweekly'">Var 14:e dag</t>
                                <t t-if="doc.pay_frequency == 'weekly'">Veckovis</t>
                            </div>
                        </div>

                        <h2>Villkor</h2>
                        <div class="field-row" t-if="doc.collective_agreement">
                            <div class="field-label">Kollektivavtal</div>
                            <div class="field-value">
                                <t t-if="doc.collective_agreement == 'installationsavtalet'">Installationsavtalet (EIO/SEF)</t>
                                <t t-if="doc.collective_agreement == 'tjanstemannaavtalet'">Tjänstemannaavtalet (Unionen)</t>
                                <t t-if="doc.collective_agreement == 'teknikavtalet'">Teknikavtalet (IF Metall)</t>
                                <t t-if="doc.collective_agreement == 'inget'">Inget kollektivavtal</t>
                            </div>
                        </div>
                        <div class="field-row">
                            <div class="field-label">Semesterdagar</div>
                            <div class="field-value"><t t-out="doc.vacation_days"/> dagar/år</div>
                        </div>
                        <div class="field-row">
                            <div class="field-label">Uppsägningstid anställd</div>
                            <div class="field-value"><t t-out="doc.notice_period_employee"/> mån</div>
                        </div>
                        <div class="field-row">
                            <div class="field-label">Uppsägningstid arbetsgivare</div>
                            <div class="field-value"><t t-out="doc.notice_period_employer"/> mån</div>
                        </div>

                        <div t-if="doc.notes" class="notes">
                            <h2 style="margin-top:0">Övriga villkor</h2>
                            <t t-out="doc.notes"/>
                        </div>

                        <div class="sig-block">
                            <div class="sig-area">
                                <span>Arbetsgivare</span>
                                <br/><br/><br/>
                                <span>Datum: _______________</span>
                                <br/>
                                <span>Namnförtydligande: _______________</span>
                            </div>
                            <div class="sig-area">
                                <span>Anställd</span>
                                <br/><br/><br/>
                                <span>Datum: _______________</span>
                                <br/>
                                <span>Namnförtydligande: _______________</span>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
