#. module: elevata_hr_contract
#: model:mail.template,body_html:elevata_hr_contract.email_template_contract
msgid ""
"\n"
"<div style=\"font-family:'Segoe UI',Arial,sans-serif;font-size:13px;color:#333;max-width:600px;margin:0 auto;\">\n"
"    <p>Hej {{ object.employee_id.name }},</p>\n"
"    <p>Bifogat finner du ditt anställningsavtal hos {{ object.company_id.name }}.</p>\n"
"    <table style=\"width:100%;border-collapse:collapse;margin:16px 0;\">\n"
"        <tr><td style=\"padding:4px 8px;color:#64748b;\">Avtalsnummer</td><td style=\"padding:4px 8px;font-weight:600;\">{{ object.name }}</td></tr>\n"
"        <tr><td style=\"padding:4px 8px;color:#64748b;\">Startdatum</td><td style=\"padding:4px 8px;\">{{ object.date_start }}</td></tr>\n"
"        <tr><td style=\"padding:4px 8px;color:#64748b;\">Befattning</td><td style=\"padding:4px 8px;\">{{ object.job_id.name or '–' }}</td></tr>\n"
"    </table>\n"
"    <p>Vänligen granska avtalet och kontakta oss om du har frågor.</p>\n"
"    <p>Med vänlig hälsning,<br/>{{ object.company_id.name }}</p>\n"
"</div>\n"
"\n"
"        "
