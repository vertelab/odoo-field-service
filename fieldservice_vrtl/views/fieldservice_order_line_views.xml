    <record id="view_fieldservice_order_line_search" model="ir.ui.view">
        <field name="name">fieldservice.order.line.search</field>
        <field name="model">fieldservice.order.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="date_start"/>
                <field name="date_day_start_char"/>
                <field name="date_week_start_char"/>
                <group expand="1" string="Group By">
                    <!-- <filter string="Date" name="group_by_date" context="{'group_by': 'date_start:day'}"/> -->
                    <filter string="Days" name="date_day_start_char" context="{'group_by': 'date_day_start_char'}"/>
                    <filter string="Week" name="date_week_start_char" context="{'group_by': 'date_week_start_char'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fieldservice_order_line" model="ir.actions.act_window">
        <field name="name">Field Service Kalender</field>
        <field name="res_model">fieldservice.order.line</field>
        <field name="view_mode">list,kanban,calendar,form</field>
    </record>

    <record id="view_fieldservice_order_line_tree" model="ir.ui.view">
        <field name="name">fieldservice.order.line.tree</field>
        <field name="model">fieldservice.order.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="order_id"/>
                <field name="stage_id"/>
                <field name="date_start"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_fieldservice_order_line_root" name="Occasions" parent="menu_fieldservice_root"  sequence="10"/>
    <menuitem id="menu_fieldservice_order_line" name="Occasions" parent="menu_fieldservice_order_line_root" action="action_fieldservice_order_line" sequence="20"/>

</odoo>
