<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_fieldservice_order_line_form" model="ir.ui.view">
        <field name="name">fieldservice.order.form</field>
        <field name="model">fieldservice.order.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <notebook name="main_notebook">
                        <page string="Order Details" name="base_page">
                            <group name="group_top">
                                <group>
                                    <field name="order_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                </group>
                                <group>
                                    <field name="image_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="fieldservice_order_management_view_calendar" model="ir.ui.view">
        <field name="name">fieldservice.order.view.calendar</field>
        <field name="model">fieldservice.order</field>
        <field name="arch" type="xml">
            <calendar date_start="planned_start_datetime" date_stop="deadline_datetime">
                <field name="name"/>
                <field name="priority"/>
                <field name="stage_id"/>
                <field name="requested_employee_ids" widget="many2many_tags"/>
            </calendar>
        </field>
    </record>

    <record id="view_fieldservice_order_line_kanban" model="ir.ui.view">
        <field name="name">fieldservice.order.line.kanban</field>
        <field name="model">fieldservice.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="date_start:day" class="o_kanban_small_column o_kanban_project_tasks">
                <field name="date_start"/>
                <!-- Lägg till andra fält som du vill visa i Kanban-korten -->
                <templates>
                    <t t-name="kanban-box" class="o_kanban_small_column" on_create="quick_create">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="date_start"/>
                                </div>
                                <!-- Lägg till mer innehåll för Kanban-korten här -->
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="view_fieldservice_order_line_search" model="ir.ui.view">
        <field name="name">fieldservice.order.line.search</field>
        <field name="model">fieldservice.order.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="date_start"/>
                <group expand="1" string="Group By">
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date_start:day'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="fieldservice_order_line_form_view_inherit" model="ir.ui.view">
        <field name="name">fieldservice.order.line.form.inherit</field>
        <field name="model">fieldservice.order.line</field>
        <field name="inherit_id" ref="fieldservice.fieldservice_order_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="fieldservice_order_line_employee_ids">
                    <tree editable="bottom">
                        <field name="employee_id"/>
                        <field name="start_time"/>
                        <field name="end_time"/>
                    </tree>
                </field>
            </xpath>
        </field>
    </record>



    <record id="action_fieldservice_order_line" model="ir.actions.act_window">
        <field name="name">Field Service Kalender</field>
        <field name="res_model">fieldservice.order</field>
        <field name="view_mode">list,kanban,calendar,form</field>
    </record>


    <record id="view_fieldservice_order_line_tree" model="ir.ui.view">
        <field name="name">fieldservice.order.line.tree</field>
        <field name="model">fieldservice.order.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="order_id"/>
                <field name="stage_id"/>
                <field name="date_start"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_fieldservice_order_line" name="Order Lines" parent="menu_fieldservice_root" action="action_fieldservice_order_line" sequence="20"/>



</odoo>