<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fieldservice_team_view_list" model="ir.ui.view">
        <field name="name">fieldservice.team.list</field>
        <field name="model">fieldservice.team</field>
        <field name="arch" type="xml">
            <list string="Teams">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="leader_id"/>
                <field name="member_count"/>
                <field name="order_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="fieldservice_team_view_form" model="ir.ui.view">
        <field name="name">fieldservice.team.form</field>
        <field name="model">fieldservice.team</field>
        <field name="arch" type="xml">
            <form string="Team">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Team North"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="leader_id"/>
                            <field name="calendar_user_id"/>
                            <field name="color" widget="color"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Members" name="members">
                            <field name="member_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="job_title"/>
                                    <field name="work_email"/>
                                </list>
                            </field>
                        </page>
                        <page string="Orders" name="orders">
                            <field name="order_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="planned_start_datetime"/>
                                    <field name="stage_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fieldservice_team_view_kanban" model="ir.ui.view">
        <field name="name">fieldservice.team.kanban</field>
        <field name="model">fieldservice.team</field>
        <field name="arch" type="xml">
            <kanban default_group_by="company_id" class="o_kanban_small_column">
                <field name="color"/>
                <field name="name"/>
                <field name="member_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center mb-1">
                            <span class="o_color_swatch me-2"
                                  t-attf-style="background-color: #{record.color.value or '#3498DB'};"/>
                            <strong><field name="name"/></strong>
                        </div>
                        <div>
                            <field name="leader_id"/>
                        </div>
                        <div class="text-muted">
                            <field name="member_count"/> members
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="fieldservice_team_view_search" model="ir.ui.view">
        <field name="name">fieldservice.team.search</field>
        <field name="model">fieldservice.team</field>
        <field name="arch" type="xml">
            <search string="Teams">
                <field name="name"/>
                <field name="leader_id"/>
                <field name="member_ids"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"/>
                    <filter name="group_leader" string="Team Leader"
                            context="{'group_by': 'leader_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="fieldservice_team_action" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">fieldservice.team</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="fieldservice_team_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first team</p>
            <p>A team groups technicians. It can represent a work crew, a
               vehicle with its crew, a competence group, or a single
               technician.</p>
        </field>
    </record>

    <menuitem id="fieldservice_team_menu"
              name="Teams"
              parent="menu_fieldservice_root"
              action="fieldservice_team_action"
              sequence="15"/>

</odoo>
