msgid ""
"<div style=\"font-family:'Segoe UI',Arial,sans-serif;font-size:13px;color:#333;max-width:600px;margin:0 auto;\">\n"
"\n"
"  <p>Hej <t t-out=\"object.partner_id.name\"></t>,</p>\n"
"\n"
"  <p>\n"
"    Ert serviceavtal <strong><t t-out=\"object.name\"></t></strong> har bekräftats och är nu aktivt.\n"
"  </p>\n"
"\n"
"  <table style=\"width:100%;border-collapse:collapse;margin:16px 0;font-size:12px;\">\n"
"    <tr style=\"background:#f5f5f5;\">\n"
"      <td style=\"padding:8px 12px;color:#777;width:140px;\">Avtalsnummer</td>\n"
"      <td style=\"padding:8px 12px;font-weight:600;\"><t t-out=\"object.name\"></t></td>\n"
"    </tr>\n"
"    <tr>\n"
"      <td style=\"padding:8px 12px;color:#777;\">Avtalstyp</td>\n"
"      <td style=\"padding:8px 12px;\"><t t-out=\"object.contract_type or '-'\"></t></td>\n"
"    </tr>\n"
"    <tr style=\"background:#f5f5f5;\">\n"
"      <td style=\"padding:8px 12px;color:#777;\">Startdatum</td>\n"
"      <td style=\"padding:8px 12px;\"><t t-out=\"object.date_start or '-'\"></t></td>\n"
"    </tr>\n"
"  </table>\n"
"\n"
"  <p>Vi kommer att kontakta er för att boka in första servicebesöket.</p>\n"
"\n"
"  <p style=\"margin-top:24px;\">\n"
"    Med vänliga hälsningar,<br>\n"
"    <strong><t t-out=\"object.company_id.name or object.env.company.name\"></t></strong><br>\n"
"    <t t-if=\"object.company_id.phone\">\n"
"      Tel: <t t-out=\"object.company_id.phone\"></t><br>\n"
"    </t>\n"
"  </p>\n"
"\n"
"</div>\n"
