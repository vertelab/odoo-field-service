<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_generate_service_orders" model="ir.cron">
            <field name="name">Elevata: Generate Service Work Orders from Contracts</field>
            <field name="model_id" ref="model_elevata_service_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_service_orders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_auto_invoice" model="ir.cron">
            <field name="name">Elevata: Automatic Invoicing of Service Contracts</field>
            <field name="model_id" ref="model_elevata_service_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_invoice()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_renewal_reminder" model="ir.cron">
            <field name="name">Elevata: Renewal Reminder for Service Contracts (90 days)</field>
            <field name="model_id" ref="model_elevata_service_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_renewal_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_check_expired_contracts" model="ir.cron">
            <field name="name">Elevata: Check Expired Service Contracts</field>
            <field name="model_id" ref="model_elevata_service_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expired()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
