<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="email_template_contract_confirmed" model="mail.template">
        <field name="name">Service Contract - Confirmed</field>
        <field name="model_id" ref="elevata_service_contract.model_elevata_service_contract"/>
        <field name="subject">Service Contract {{ object.name }} confirmed &#8211; Elevata Hiss AB</field>
        <field name="email_from">{{ (object.company_id.email or object.env.company.email) }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="auto_delete">False</field>
        <field name="body_html" type="html">
<div style="font-family:'Segoe UI',Arial,sans-serif;font-size:13px;color:#333;max-width:600px;margin:0 auto;">

  <p>Hello <t t-out="object.partner_id.name"/>,</p>

  <p>
    Your service contract <strong><t t-out="object.name"/></strong> has been confirmed and is now active.
  </p>

  <table style="width:100%;border-collapse:collapse;margin:16px 0;font-size:12px;">
    <tr style="background:#f5f5f5;">
      <td style="padding:8px 12px;color:#777;width:140px;">Contract Number</td>
      <td style="padding:8px 12px;font-weight:600;"><t t-out="object.name"/></td>
    </tr>
    <tr>
      <td style="padding:8px 12px;color:#777;">Contract Type</td>
      <td style="padding:8px 12px;"><t t-out="object.contract_type or '-'"/></td>
    </tr>
    <tr style="background:#f5f5f5;">
      <td style="padding:8px 12px;color:#777;">Start Date</td>
      <td style="padding:8px 12px;"><t t-out="object.date_start or '-'"/></td>
    </tr>
  </table>

  <p>We will contact you to schedule the first service visit.</p>

  <p style="margin-top:24px;">
    Kind regards,<br/>
    <strong><t t-out="object.company_id.name or object.env.company.name"/></strong><br/>
    <t t-if="object.company_id.phone">
      Tel: <t t-out="object.company_id.phone"/><br/>
    </t>
  </p>

</div>
        </field>
    </record>

</odoo>
