<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Inledning -->
        <record id="contract_template_introduction" model="elevata.contract.template">
            <field name="name">Introduction</field>
            <field name="position">before</field>
            <field name="sequence">10</field>
            <field name="contract_type">standard</field>
            <field name="is_locked">true</field>
            <field name="content"><![CDATA[
                <div class="contract-section">
                    <h2>Service Contract</h2>
                    <p>This service contract ("the Contract") is entered into between:</p>
                    <p><strong>Supplier:</strong> Elevata AB ("Elevata")</p>
                    <p><strong>Customer:</strong> ${object.owner_id.name}</p>
                    <p>The contract covers service and maintenance of elevators as specified below.</p>
                </div>
            ]]></field>
        </record>

        <!-- Allmänna villkor -->
        <record id="contract_template_general_terms" model="elevata.contract.template">
            <field name="name">General Terms</field>
            <field name="position">after</field>
            <field name="sequence">20</field>
            <field name="contract_type">standard</field>
            <field name="is_locked">true</field>
            <field name="content"><![CDATA[
                <div class="contract-section">
                    <h2>General Terms</h2>
                    <p>1. This contract governs the terms for service and maintenance of the elevators specified in the contract.</p>
                    <p>2. Elevata undertakes to perform service and maintenance according to industry standards and applicable safety regulations.</p>
                    <p>3. Service is performed during normal working hours (weekdays 07:00-16:00).</p>
                    <p>4. The customer shall provide Elevata access to the elevators for service and maintenance.</p>
                </div>
            ]]></field>
        </record>

        <!-- Omfattning -->
        <record id="contract_template_scope" model="elevata.contract.template">
            <field name="name">Scope</field>
            <field name="position">after</field>
            <field name="sequence">30</field>
            <field name="contract_type">standard</field>
            <field name="is_locked">true</field>
            <field name="content"><![CDATA[
                <div class="contract-section">
                    <h2>Scope</h2>
                    <p>This service contract covers the following services:</p>
                    <ul>
                        <li>Regular service and maintenance</li>
                        <li>Safety inspections</li>
                        <li>Technical support</li>
                        <li>Documentation of completed work</li>
                    </ul>
                </div>
            ]]></field>
        </record>

        <!-- Priser och betalning -->
        <record id="contract_template_pricing" model="elevata.contract.template">
            <field name="name">Pricing and Payment</field>
            <field name="position">after</field>
            <field name="sequence">40</field>
            <field name="contract_type">standard</field>
            <field name="is_locked">true</field>
            <field name="content"><![CDATA[
                <div class="contract-section">
                    <h2>Pricing and Payment</h2>
                    <p>1. Prices are stated in Swedish kronor (SEK) excluding VAT.</p>
                    <p>2. Invoicing is done quarterly in advance.</p>
                    <p>3. Payment terms: 30 days net.</p>
                    <p>4. Prices are adjusted annually according to SCB's service index.</p>
                </div>
            ]]></field>
        </record>

        <!-- Jour och beredskap -->
        <record id="contract_template_emergency" model="elevata.contract.template">
            <field name="name">On-call and Standby</field>
            <field name="position">after</field>
            <field name="sequence">50</field>
            <field name="contract_type">standard</field>
            <field name="is_locked">true</field>
            <field name="content"><![CDATA[
                <div class="contract-section">
                    <h2>On-call and Standby</h2>
                    <p>1. Elevata provides on-call service 24/7, every day.</p>
                    <p>2. Emergencies or entrapments are prioritized for dispatch.</p>
                    <p>3. Contact our on-call phone: [On-call phone number]</p>
                </div>
            ]]></field>
        </record>

        <!-- Ansvar och försäkring -->
        <record id="contract_template_liability" model="elevata.contract.template">
            <field name="name">Liability and Insurance</field>
            <field name="position">after</field>
            <field name="sequence">60</field>
            <field name="contract_type">standard</field>
            <field name="is_locked">true</field>
            <field name="content"><![CDATA[
                <div class="contract-section">
                    <h2>Liability and Insurance</h2>
                    <p>1. Elevata is liable for damages caused by negligence during service work.</p>
                    <p>2. Elevata holds required insurance for its operations.</p>
                    <p>3. The customer is responsible for informing about special conditions that may affect service work.</p>
                </div>
            ]]></field>
        </record>

        <!-- Avtalstid och uppsägning -->
        <record id="contract_template_termination" model="elevata.contract.template">
            <field name="name">Contract Period and Termination</field>
            <field name="position">after</field>
            <field name="sequence">70</field>
            <field name="contract_type">standard</field>
            <field name="is_locked">true</field>
            <field name="content"><![CDATA[
                <div class="contract-section">
                    <h2>Contract Period and Termination</h2>
                    <p>1. The contract is valid from the start date and runs for the specified contract period.</p>
                    <p>2. Notice period: 3 months before the end of the contract period.</p>
                    <p>3. If not terminated, the contract is automatically extended by 12 months.</p>
                </div>
            ]]></field>
        </record>

        <!-- Underskrifter -->
        <record id="contract_template_signatures" model="elevata.contract.template">
            <field name="name">Signatures</field>
            <field name="position">after</field>
            <field name="sequence">80</field>
            <field name="contract_type">standard</field>
            <field name="is_locked">true</field>
            <field name="content"><![CDATA[
                <div class="contract-section signatures">
                    <h2>Signatures</h2>
                    <div class="signature-block">
                        <div class="signature-line">
                            <p>For Elevata AB:</p>
                            <p>_______________________</p>
                            <p>Name:</p>
                            <p>Date:</p>
                        </div>
                        <div class="signature-line">
                            <p>For the Customer:</p>
                            <p>_______________________</p>
                            <p>Name:</p>
                            <p>Date:</p>
                        </div>
                    </div>
                </div>
            ]]></field>
        </record>
    </data>
</odoo>
