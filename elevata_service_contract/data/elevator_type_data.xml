<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Elevator types referenced by the service checklists.

         These lived in Elevata's fsm.elevator.type in 17.0. In 18.0 the
         reference data is maintenance.elevator.type, which ships five
         generic types; the eleven below are the ones the checklists need
         and maintenance_elevator does not define. -->
    <record id="elevator_type_traction" model="maintenance.elevator.type">
        <field name="model_type">elevator</field>
        <field name="name">Traction Elevator</field>
        <field name="code">TR</field>
        <field name="sequence">20</field>
    </record>
    <record id="elevator_type_hydraulic" model="maintenance.elevator.type">
        <field name="model_type">elevator</field>
        <field name="name">Hydraulic Elevator</field>
        <field name="code">HY</field>
        <field name="sequence">21</field>
    </record>
    <record id="elevator_type_machine_room_less" model="maintenance.elevator.type">
        <field name="model_type">elevator</field>
        <field name="name">Machine Room Less</field>
        <field name="code">MRL</field>
        <field name="sequence">22</field>
    </record>
    <record id="elevator_type_screw_drive" model="maintenance.elevator.type">
        <field name="model_type">elevator</field>
        <field name="name">Screw Drive Elevator</field>
        <field name="code">SD</field>
        <field name="sequence">23</field>
    </record>
    <record id="elevator_type_screw_drive_home" model="maintenance.elevator.type">
        <field name="model_type">elevator</field>
        <field name="name">Screw Drive Home Elevator</field>
        <field name="code">SDH</field>
        <field name="sequence">24</field>
    </record>
    <record id="elevator_type_stair_lift" model="maintenance.elevator.type">
        <field name="model_type">elevator</field>
        <field name="name">Stair Lift</field>
        <field name="code">SL</field>
        <field name="sequence">25</field>
    </record>
    <record id="elevator_type_stair_lift_home" model="maintenance.elevator.type">
        <field name="model_type">elevator</field>
        <field name="name">Home Stair Lift</field>
        <field name="code">SLH</field>
        <field name="sequence">26</field>
    </record>
    <record id="elevator_type_small_goods" model="maintenance.elevator.type">
        <field name="model_type">elevator</field>
        <field name="name">Small Goods Elevator</field>
        <field name="code">SG</field>
        <field name="sequence">27</field>
    </record>
    <record id="elevator_type_lifting_table" model="maintenance.elevator.type">
        <field name="model_type">elevator</field>
        <field name="name">Lifting Table</field>
        <field name="code">LT</field>
        <field name="sequence">28</field>
    </record>
    <record id="elevator_type_door_automatic" model="maintenance.elevator.type">
        <field name="model_type">car_door</field>
        <field name="name">Automatic Door</field>
        <field name="code">AD</field>
        <field name="sequence">40</field>
    </record>
    <record id="elevator_type_gate" model="maintenance.elevator.type">
        <field name="model_type">car_door</field>
        <field name="name">Gate</field>
        <field name="code">GA</field>
        <field name="sequence">41</field>
    </record>
</odoo>
