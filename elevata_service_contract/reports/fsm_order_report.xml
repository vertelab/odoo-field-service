<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Report Action -->
        <record id="action_report_fsm_order_service" model="ir.actions.report">
            <field name="name">Service Report</field>
            <field name="model">fieldservice.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">elevata_service_contract.report_fsm_order_service</field>
            <field name="report_file">elevata_service_contract.report_fsm_order_service</field>
            <field name="print_report_name">'Service Report - %s' % object.name</field>
            <field name="binding_model_id" ref="fieldservice_vrtl.model_fieldservice_order"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="base.paperformat_euro"/>
        </record>

        <!-- Report Template -->
        <template id="report_fsm_order_service">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <style>
                                .sr-header { border-bottom: 2px solid #2c6fad; padding-bottom: 12px; margin-bottom: 20px; }
                                .sr-title { font-size: 20px; font-weight: bold; color: #2c6fad; }
                                .sr-ref { font-size: 12px; color: #666; margin-top: 3px; }
                                .sr-badge { display: inline-block; padding: 2px 10px; border-radius: 3px; font-size: 11px; font-weight: bold; }
                                .sr-badge-warranty { background: #fff3cd; color: #856404; border: 1px solid #ffc107; }
                                .sr-info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px; }
                                .sr-info-box { background: #f8f9fa; border-left: 3px solid #2c6fad; padding: 10px 14px; }
                                .sr-label { font-size: 10px; text-transform: uppercase; color: #888; letter-spacing: 0.8px; }
                                .sr-value { font-size: 13px; font-weight: 600; margin-top: 3px; }
                                .sr-section { margin-top: 20px; }
                                .sr-section-title { font-size: 12px; font-weight: bold; text-transform: uppercase;
                                                    color: #2c6fad; border-bottom: 1px solid #dee2e6;
                                                    padding-bottom: 5px; margin-bottom: 10px; letter-spacing: 0.5px; }
                                .sr-table { width: 100%; border-collapse: collapse; font-size: 12px; }
                                .sr-table th { background: #e9ecef; padding: 6px 10px; text-align: left; font-weight: 600; }
                                .sr-table td { padding: 6px 10px; border-bottom: 1px solid #f0f0f0; }
                                .sr-table tr:last-child td { border-bottom: none; }
                                .sr-done { color: #198754; }
                                .sr-undone { color: #999; }
                                .sr-footer-note { margin-top: 30px; font-size: 11px; color: #888;
                                                  border-top: 1px solid #dee2e6; padding-top: 10px; }
                            </style>

                            <!-- Header -->
                            <div class="sr-header">
                                <div class="sr-title">Service Report</div>
                                <div class="sr-ref"><t t-esc="doc.name"/></div>
                                <t t-if="doc.is_warranty">
                                    <span class="sr-badge sr-badge-warranty">⚠ Warranty Job</span>
                                </t>
                            </div>

                            <!-- Info-rutor -->
                            <div class="sr-info-grid">
                                <div class="sr-info-box">
                                    <div class="sr-label">Elevator</div>
                                    <div class="sr-value"><t t-esc="doc.equipment_id.name or '—'"/></div>
                                    <t t-if="doc.equipment_id.street">
                                        <div style="font-size:11px;color:#666;margin-top:2px;">
                                            <t t-esc="doc.equipment_id.street"/>
                                            <t t-if="doc.equipment_id.city">, <t t-esc="doc.equipment_id.city"/></t>
                                        </div>
                                    </t>
                                </div>
                                <div class="sr-info-box">
                                    <div class="sr-label">Customer</div>
                                    <div class="sr-value">
                                        <t t-esc="doc.equipment_id.customer_id.name or doc.equipment_id.owner_id.name or '—'"/>
                                    </div>
                                </div>
                                <div class="sr-info-box">
                                    <div class="sr-label">Technician</div>
                                    <div class="sr-value"><t t-esc="doc.requested_employee_ids.name or '—'"/></div>
                                </div>
                                <div class="sr-info-box">
                                    <div class="sr-label">Completed Date</div>
                                    <div class="sr-value">
                                        <t t-esc="doc.date_end or doc.planned_date_end or '—'"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Beskrivning -->
                            <t t-if="doc.description or doc.request">
                                <div class="sr-section">
                                    <div class="sr-section-title">Description of Work Performed</div>
                                    <p style="font-size:12px;white-space:pre-wrap;">
                                        <t t-esc="doc.description or doc.request"/>
                                    </p>
                                </div>
                            </t>

                            <!-- Checklista -->
                            <t t-if="doc.checklist_item_ids">
                                <div class="sr-section">
                                    <div class="sr-section-title">
                                        Checklist
                                        (<t t-esc="doc.checklist_done_count"/>/<t t-esc="doc.checklist_count"/> completed)
                                    </div>
                                    <table class="sr-table">
                                        <thead>
                                            <tr>
                                                <th style="width:40px;">Status</th>
                                                <th>Item</th>
                                                <th>Notes</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="doc.checklist_item_ids" t-as="item">
                                                <tr>
                                                    <td class="text-center">
                                                        <t t-if="item.done">
                                                            <span class="sr-done">✓</span>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="sr-undone">○</span>
                                                        </t>
                                                    </td>
                                                    <td><t t-esc="item.name"/></td>
                                                    <td style="color:#666;"><t t-esc="item.note or ''"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>

                            <!-- Tidslogg -->
                            <t t-if="doc.time_line_ids">
                                <div class="sr-section">
                                    <div class="sr-section-title">Time Log</div>
                                    <table class="sr-table">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Technician</th>
                                                <th class="text-end">Hours</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="doc.time_line_ids" t-as="tl">
                                                <tr>
                                                    <td><t t-esc="tl.date"/></td>
                                                    <td><t t-esc="tl.requested_employee_ids.name or tl.description or '—'"/></td>
                                                    <td class="text-end"><t t-esc="'%.2f' % tl.hours"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>

                            <!-- Status -->
                            <div class="sr-section">
                                <div class="sr-section-title">Order Status</div>
                                <table class="sr-table">
                                    <tr>
                                        <td style="width:160px;color:#888;">Status</td>
                                        <td><t t-esc="doc.stage_id.name or '—'"/></td>
                                    </tr>
                                    <tr>
                                        <td style="color:#888;">Order Type</td>
                                        <td><t t-esc="doc.type.name or '—'"/></td>
                                    </tr>
                                    <tr>
                                        <td style="color:#888;">Billing Status</td>
                                        <td><t t-esc="doc.billing_label or '—'"/></td>
                                    </tr>
                                </table>
                            </div>

                            <div class="sr-footer-note">
                                Service report generated <span t-esc="context_today()"/> |
                                <t t-esc="doc.name"/> | <t t-esc="doc.equipment_id.name or ''"/>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
