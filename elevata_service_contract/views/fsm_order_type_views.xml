<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_order_type_form_view_checklist" model="ir.ui.view">
        <field name="name">fsm.order.type.form.checklist</field>
        <field name="model">fieldservice.order.type</field>
        <field name="inherit_id" ref="fieldservice_order_type_color.view_fieldservice_order_type_form"/>
