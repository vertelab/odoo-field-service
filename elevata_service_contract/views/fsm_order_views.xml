<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend FSM Order form: billing status + invoice button -->
    <record id="view_fsm_order_service_contract_ext" model="ir.ui.view">
        <field name="name">fsm.order.service.contract.ext</field>
        <field name="model">fieldservice.order</field>
        <field name="inherit_id" ref="elevata_fsm_flow.fsm_order_form"/>
        <field name="arch" type="xml">

            <!-- Garantijobb-badge (visas bara vid garanti) -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="billing_type" invisible="1"/>
                <field name="billing_label" invisible="1"/>
                <div invisible="not is_warranty"
                     style="margin: 4px 0 8px; display: inline-block;">
                    <span class="badge text-bg-danger"
                          style="font-size: 13px; padding: 4px 12px;">
                        Garantijobb — faktureras ej
                    </span>
                </div>
                <field name="is_warranty" invisible="1"/>
            </xpath>

            <!-- Serviceavtal i huvudgruppen (live från hissen) -->
            <xpath expr="//field[@name='equipment_id']" position="after">
                <field name="location_active_contract_id" string="Serviceavtal" readonly="1"
                       invisible="not location_active_contract_id"/>
                <field name="service_contract_id" invisible="1"/>
                <field name="billing_interval" invisible="1"/>
            </xpath>

            <!-- Avtalstyp + besök + ej skötselfirma ovanför hisstyp -->
            <xpath expr="//field[@name='elevator_type_id'][1]" position="before">
                <field name="live_contract_type" string="Avtalstyp" readonly="1"
                       invisible="not location_active_contract_id"/>
                <field name="live_visits_per_year" string="Antal besök/år" readonly="1"
                       invisible="not location_active_contract_id"/>
                <label for="location_active_contract_id" string="Serviceavtal"
                       invisible="location_active_contract_id"/>
                <div invisible="location_active_contract_id"
                     style="font-weight:bold; color:#dc3545;">
                    Ej skötselfirma
                </div>
            </xpath>

            <!-- Tid och material-flik -->
            <xpath expr="//notebook" position="inside">
                <page string="Tid och material" name="tidrapport_tab" sequence="51">

                    <!-- Avtalets timpriser (info-ruta) -->
                    <div invisible="not elevata_contract_type"
                         style="background:#f0f8ff; border:1px solid #b8d4ea; border-radius:6px; padding:10px 16px; margin-bottom:12px;">
                        <strong>Avtalade timpriser (<field name="elevata_contract_type" readonly="1" nolabel="1"/>):</strong>
                        &amp;nbsp;&amp;nbsp;
                        Normaltid: <field name="rate_normaltid" readonly="1" nolabel="1"/> kr/h
                        &amp;nbsp;|&amp;nbsp;
                        Övertid 1-2h: <field name="rate_overtid" readonly="1" nolabel="1"/> kr/h
                        &amp;nbsp;|&amp;nbsp;
                        Jourutryckning: <field name="rate_jour" readonly="1" nolabel="1"/> kr/h
                    </div>

                    <!-- TID -->
                    <separator string="Tid"/>
                    <field name="time_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="datetime_from" string="Från" widget="datetime"/>
                            <field name="datetime_to" string="Till" widget="datetime"/>
                            <field name="hours" string="Timmar" readonly="1"/>
                            <field name="requested_employee_ids" string="Tekniker"/>
                            <field name="rate_type"/>
                            <field name="price_per_hour" string="Timpris (kr/h)"/>
                            <field name="amount" readonly="1"/>
                            <field name="description" optional="show"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer" col="2">
                        <field name="time_total_hours" string="Totalt timmar" readonly="1"/>
                        <field name="time_total_amount" string="Totalt tid (kr)" readonly="1"/>
                    </group>

                    <!-- MATERIAL -->
                    <separator string="Material"/>
                    <field name="material_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="product_id" string="Produkt"/>
                            <field name="name"/>
                            <field name="quantity" string="Antal"/>
                            <field name="price_unit" string="Enhetspris (kr)"/>
                            <field name="amount" readonly="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer" col="2">
                        <field name="material_total_amount" string="Totalt material (kr)" readonly="1"/>
                    </group>

                    <!-- Fakturera-knapp -->
                    <div style="margin-top:16px;">
                        <button name="action_create_time_invoice" type="object"
                                string="Skapa faktura för tid och material"
                                class="btn btn-primary"
                                invisible="not time_line_ids"/>
                    </div>
                </page>
            </xpath>

            <!-- Planering-flik (ihopslagen: Scheduling + Requested) — efter Tid och material -->
            <xpath expr="//page[@name='tidrapport_tab']" position="after">
                <page string="Planering" name="scheduling_fields_tab" sequence="52">
                    <group>
                        <group string="Schemaläggning">
                            <field name="planned_start_datetime" string="Planerad start"/>
                            <field name="planned_duration" string="Planerad längd (timmar)" widget="float_time"/>
                        </group>
                        <group string="Önskat tidsfönster">
                            <field name="deadline_datetime" string="Senast klar"/>
                        </group>
                    </group>
                    <group string="Begärda arbetare" name="request_workers">
                        <field name="requested_employee_ids" widget="many2many" nolabel="1" colspan="2"
                               context="{'search_default_equipment_ids': equipment_id}">
                            <list>
                                <field name="name" string="Namn"/>
                                <field name="phone" string="Telefon"/>
                                <field name="email" string="E-post"/>
                                <field name="resource_calendar_id" string="Arbetstid"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
