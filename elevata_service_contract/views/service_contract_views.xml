<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban View -->
    <record id="view_service_contract_kanban" model="ir.ui.view">
        <field name="name">elevata.service.contract.kanban</field>
        <field name="model">elevata.service.contract</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="amount_total"/>
                <field name="currency_id"/>
                <field name="billing_interval"/>
                <field name="line_ids"/>
                <field name="fsm_order_count"/>
                <field name="activity_ids"/>
                <field name="activity_state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-0">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="mb-1">
                                        <strong><field name="partner_id"/></strong>
                                    </div>
                                    <div class="text-muted small">
                                        <field name="date_start"/> — <field name="date_end"/>
                                    </div>
                                    <div class="mt-1">
                                        <span class="fw-bold"><field name="amount_total" widget="monetary"/></span>
                                        <span class="text-muted small"> /år</span>
                                    </div>
                                    <div class="text-muted small mt-1">
                                        <field name="billing_interval"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom mt-1">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span t-if="record.fsm_order_count.raw_value > 0" class="badge text-bg-info">
                                            <i class="fa fa-wrench me-1"/><field name="fsm_order_count"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_service_contract_tree" model="ir.ui.view">
        <field name="name">elevata.service.contract.list</field>
        <field name="model">elevata.service.contract</field>
        <field name="arch" type="xml">
            <list string="Service Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="contract_years" string="Contract Years"/>
                <field name="date_end" string="End Date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_service_contract_form" model="ir.ui.view">
        <field name="name">elevata.service.contract.form</field>
        <field name="model">elevata.service.contract</field>
        <field name="arch" type="xml">
            <form string="Service Contract">
                <header>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state not in ['cancelled','expired']"/>
                    <button name="action_confirm" type="object" string="Confirm Contract" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_generate_service_orders" type="object" string="Generate Work Orders" class="btn-secondary" invisible="state != 'confirmed'"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice" class="btn-secondary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel Contract" invisible="state not in ['draft', 'confirmed']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_fsm_orders" icon="fa-wrench">
                            <field name="fsm_order_count" widget="statinfo" string="Work Orders"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_invoices" icon="fa-file-text-o"
                                invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Contract Number"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" string="Customer"/>
                            <field name="date_start" string="Start Date"/>
                            <field name="contract_years" string="Contract Years"/>
                            <field name="date_end" string="End Date"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="pricelist_id" string="Pricelist" options="{'no_create': True}"/>
                            <field name="amount_total" string="Annual Total"/>
                            <field name="billing_interval" string="Billing Interval"/>
                            <field name="next_invoice_date" string="Next Invoice"
                                   invisible="billing_interval == 'manual'"/>
                            <field name="payment_term_id" string="Payment Terms"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contract Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="equipment_id" string="Elevator"/>
                                    <field name="contract_type_selection" string="Contract Type"/>
                                    <field name="visits_per_year" string="Visits/Year"/>
                                    <field name="include_inspection" string="Inspection"/>
                                    <field name="billing_type" string="Billing"/>
                                    <field name="price_unit" string="Price/Year"/>
                                    <field name="customer_id" string="Billing Customer" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Price Rules" name="price_rules">
                            <field name="price_rule_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="rule_type"/>
                                    <field name="equipment_id" string="Elevator" optional="show"/>
                                    <field name="product_id" string="Product" optional="show"/>
                                    <field name="rate_type" string="Time Type"
                                           invisible="rule_type not in ['hourly', 'included']"/>
                                    <field name="price" string="Price (SEK)"
                                           invisible="rule_type in ['material_markup', 'included']"/>
                                    <field name="discount_pct" string="Discount %"
                                           invisible="rule_type == 'included'"/>
                                    <field name="is_included" string="Included"
                                           invisible="rule_type != 'included'"/>
                                    <field name="note" string="Comment" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Contract Content" name="content">
                            <field name="content" widget="html" options="{'resizable': true, 'style-inline': true}"/>
                        </page>
                        <page string="Work Orders" name="orders">
                            <field name="fsm_order_ids" readonly="1">
                                <list decoration-success="billing_type == 'prepaid'" decoration-warning="billing_type == 'postpaid'">
                                    <field name="name"/>
                                    <field name="equipment_id" string="Elevator"/>
                                    <field name="planned_start_datetime" string="Scheduled Date"/>
                                    <field name="product_tmpl_id" string="Type"/>
                                    <field name="billing_type" string="Billing"/>
                                    <field name="stage_id" string="Status"/>
                                </list>
                            </field>
                        </page>
                        <page string="History" name="template_history">
                            <field name="template_modification_ids" readonly="1">
                                <list>
                                    <field name="template_id"/>
                                    <field name="modification_date"/>
                                    <field name="modified_by"/>
                                    <field name="changes_description"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_service_contract_search" model="ir.ui.view">
        <field name="name">elevata.service.contract.search</field>
        <field name="model">elevata.service.contract</field>
        <field name="arch" type="xml">
            <search string="Search Service Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Partner" name="group_by_partner" domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter string="State" name="group_by_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Start Date" name="group_by_start_date" domain="[]" context="{'group_by': 'date_start'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_service_contract" model="ir.actions.act_window">
        <field name="name">Service Contracts</field>
        <field name="res_model">elevata.service.contract</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_service_contract_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first service contract!
            </p>
        </field>
    </record>
</odoo>
