<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_service_contract_template_modification_tree" model="ir.ui.view">
        <field name="name">elevata.service.contract.template.modification.list</field>
        <field name="model">elevata.service.contract.template.modification</field>
        <field name="arch" type="xml">
            <list string="Template Modifications">
                <field name="service_contract_id"/>
                <field name="template_id"/>
                <field name="modification_date"/>
                <field name="modified_by"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_service_contract_template_modification_form" model="ir.ui.view">
        <field name="name">elevata.service.contract.template.modification.form</field>
        <field name="model">elevata.service.contract.template.modification</field>
        <field name="arch" type="xml">
            <form string="Template Modification">
                <sheet>
                    <group>
                        <group>
                            <field name="service_contract_id"/>
                            <field name="template_id"/>
                        </group>
                        <group>
                            <field name="modification_date"/>
                            <field name="modified_by"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Changes Description">
                            <field name="changes_description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_service_contract_template_modification_search" model="ir.ui.view">
        <field name="name">elevata.service.contract.template.modification.search</field>
        <field name="model">elevata.service.contract.template.modification</field>
        <field name="arch" type="xml">
            <search string="Search Template Modifications">
                <field name="service_contract_id"/>
                <field name="template_id"/>
                <field name="modified_by"/>
                <group expand="0" string="Group By">
                    <filter string="Contract" name="group_by_contract" domain="[]" context="{'group_by': 'service_contract_id'}"/>
                    <filter string="Template" name="group_by_template" domain="[]" context="{'group_by': 'template_id'}"/>
                    <filter string="Modified By" name="group_by_user" domain="[]" context="{'group_by': 'modified_by'}"/>
                    <filter string="Modification Date" name="group_by_date" domain="[]" context="{'group_by': 'modification_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_service_contract_template_modification" model="ir.actions.act_window">
        <field name="name">Template Modifications</field>
        <field name="res_model">elevata.service.contract.template.modification</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_service_contract_template_modification_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No template modifications found!
            </p>
        </field>
    </record>
</odoo>
