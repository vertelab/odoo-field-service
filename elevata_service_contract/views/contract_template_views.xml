<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_contract_template_tree" model="ir.ui.view">
        <field name="name">elevata.contract.template.list</field>
        <field name="model">elevata.contract.template</field>
        <field name="arch" type="xml">
            <list string="Contract Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="position"/>
                <field name="contract_type"/>
                <field name="is_locked"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_contract_template_form" model="ir.ui.view">
        <field name="name">elevata.contract.template.form</field>
        <field name="model">elevata.contract.template</field>
        <field name="arch" type="xml">
            <form string="Contract Template">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="position"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="contract_type"/>
                            <field name="is_locked"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <field name="content" widget="html"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_contract_template_search" model="ir.ui.view">
        <field name="name">elevata.contract.template.search</field>
        <field name="model">elevata.contract.template</field>
        <field name="arch" type="xml">
            <search string="Search Contract Templates">
                <field name="name"/>
                <field name="contract_type"/>
                <separator/>
                <filter string="Locked" name="is_locked" domain="[('is_locked', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Position" name="group_by_position" domain="[]" context="{'group_by': 'position'}"/>
                    <filter string="Contract Type" name="group_by_contract_type" domain="[]" context="{'group_by': 'contract_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_contract_templates" model="ir.actions.act_window">
        <field name="name">Contract Templates</field>
        <field name="res_model">elevata.contract.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_contract_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first contract template!
            </p>
        </field>
    </record>
</odoo>
