<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal home: räknare för hissar, avtal, arbetsorder -->
    <template id="portal_my_home_elevata" inherit_id="portal.portal_my_home" priority="25">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Elevators</t>
                <t t-set="url">/my/elevators</t>
                <t t-set="placeholder_count">elevator_count</t>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Service Contracts</t>
                <t t-set="url">/my/contracts</t>
                <t t-set="placeholder_count">contract_count</t>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Work Orders</t>
                <t t-set="url">/my/workorders</t>
                <t t-set="placeholder_count">workorder_count</t>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Report Problem</t>
                <t t-set="url">/my/report-problem</t>
                <t t-set="placeholder_count">0</t>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Invoices</t>
                <t t-set="url">/my/invoices</t>
                <t t-set="placeholder_count">invoice_count</t>
            </t>
        </xpath>
    </template>

    <!-- ── Mina hissar ── -->
    <template id="portal_my_elevators" name="My Elevators">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Elevators</t>
            </t>
            <t t-if="not elevators">
                <div class="alert alert-info">No elevators found for your account.</div>
            </t>
            <t t-if="elevators">
                <div class="card">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Elevator</th>
                                <th>Address</th>
                                <th>Status</th>
                                <th>Next Inspection</th>
                                <th>Service Visits/Year</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="elevators" t-as="loc">
                                <tr>
                                    <td><strong><t t-esc="loc.name"/></strong></td>
                                    <td>
                                        <t t-esc="loc.street or ''"/>
                                        <t t-if="loc.city">, <t t-esc="loc.city"/></t>
                                    </td>
                                    <td>
                                        <t t-if="loc.elevator_status == 'active'"><span class="badge bg-success">Active</span></t>
                                        <t t-elif="loc.elevator_status == 'inactive'"><span class="badge bg-secondary">Inactive</span></t>
                                        <t t-elif="loc.elevator_status == 'modernization'"><span class="badge bg-warning text-dark">Modernization</span></t>
                                        <t t-else=""><span class="badge bg-light text-dark"><t t-esc="loc.elevator_status or '—'"/></span></t>
                                    </td>
                                    <td><t t-esc="loc.next_inspection_date or '—'"/></td>
                                    <td><t t-esc="loc.annual_visits or '—'"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                <div t-if="pager" class="o_portal_pager text-center mt-3">
                    <t t-call="portal.pager"/>
                </div>
            </t>
            <div class="mt-3">
                <a href="/my/report-problem" class="btn btn-outline-danger">
                    ⚠ Report Elevator Problem
                </a>
            </div>
        </t>
    </template>

    <!-- ── Mina avtal ── -->
    <template id="portal_my_contracts" name="Service Contracts">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Service Contracts</t>
            </t>
            <t t-if="not contracts">
                <div class="alert alert-info">No active service contracts found.</div>
            </t>
            <t t-if="contracts">
                <div class="card">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Contract No.</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>No. of Elevators</th>
                                <th class="text-end">Annual Fee</th>
                                <th>Billing</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="contracts" t-as="c">
                                <tr>
                                    <td><strong><t t-esc="c.name"/></strong></td>
                                    <td><t t-esc="c.date_start"/></td>
                                    <td><t t-esc="c.date_end"/></td>
                                    <td class="text-center"><t t-esc="len(c.line_ids)"/></td>
                                    <td class="text-end">
                                        <t t-esc="'%.2f kr' % c.amount_total"/>
                                    </td>
                                    <td>
                                        <t t-if="c.billing_interval == 'monthly'">Monthly</t>
                                        <t t-elif="c.billing_interval == 'quarterly'">Quarterly</t>
                                        <t t-elif="c.billing_interval == 'yearly'">Yearly</t>
                                        <t t-else="">Manual</t>
                                    </td>
                                </tr>
                                <!-- Hissar i avtalet -->
                                <t t-if="c.line_ids">
                                    <tr class="table-light">
                                        <td colspan="6" class="py-1 px-4">
                                            <small class="text-muted">
                                                <t t-foreach="c.line_ids" t-as="line">
                                                    <span class="me-3">
                                                        <i class="fa fa-elevator"/> <t t-esc="line.equipment_id.name or '—'"/>
                                                        <t t-if="line.visits_per_year">
                                                            (<t t-esc="line.visits_per_year"/> visits/year)
                                                        </t>
                                                    </span>
                                                </t>
                                            </small>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
                <div t-if="pager" class="o_portal_pager text-center mt-3">
                    <t t-call="portal.pager"/>
                </div>
            </t>
        </t>
    </template>

    <!-- ── Arbetsorder ── -->
    <template id="portal_my_workorders" name="Work Orders">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Work Orders</t>
            </t>
            <t t-if="not orders">
                <div class="alert alert-info">No work orders found.</div>
            </t>
            <t t-if="orders">
                <div class="card">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Order</th>
                                <th>Elevator</th>
                                <th>Description</th>
                                <th>Scheduled Date</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="orders" t-as="order">
                                <tr>
                                    <td>
                                        <a t-attf-href="/my/workorders/#{order.id}">
                                            <strong><t t-esc="order.name"/></strong>
                                        </a>
                                    </td>
                                    <td><t t-esc="order.equipment_id.name or '—'"/></td>
                                    <td>
                                        <span class="text-truncate d-inline-block" style="max-width:200px;">
                                            <t t-esc="order.description or order.request or '—'"/>
                                        </span>
                                    </td>
                                    <td><t t-esc="order.planned_start_datetime or '—'"/></td>
                                    <td><t t-esc="order.stage_id.name or '—'"/></td>
                                    <td>
                                        <a t-attf-href="/my/workorders/#{order.id}/pdf"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="fa fa-file-pdf-o"/> PDF
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                <div t-if="pager" class="o_portal_pager text-center mt-3">
                    <t t-call="portal.pager"/>
                </div>
            </t>
        </t>
    </template>

    <!-- ── Arbetsorder detalj ── -->
    <template id="portal_workorder_detail" name="Work Order Detail">
        <t t-call="portal.portal_layout">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <!-- Tillbaka-länk -->
                    <div class="mb-3">
                        <a href="/my/workorders" class="btn btn-sm btn-outline-secondary">
                            <i class="fa fa-arrow-left"/> Tillbaka till arbetsorder
                        </a>
                    </div>

                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h4 class="mb-0"><t t-esc="order.name"/></h4>
                            <span class="badge bg-primary" style="font-size:14px;">
                                <t t-esc="order.stage_id.name or '—'"/>
                            </span>
                        </div>
                        <div class="card-body">
                            <!-- Orderinfo -->
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <table class="table table-sm table-borderless mb-0">
                                        <tr>
                                            <td class="text-muted" style="width:40%;">Hiss</td>
                                            <td><strong><t t-esc="order.equipment_id.name or '—'"/></strong></td>
                                        </tr>
                                        <tr t-if="order.equipment_id.street">
                                            <td class="text-muted">Adress</td>
                                            <td>
                                                <t t-esc="order.equipment_id.street"/>
                                                <t t-if="order.equipment_id.city">, <t t-esc="order.equipment_id.city"/></t>
                                            </td>
                                        </tr>
                                        <tr t-if="order.type">
                                            <td class="text-muted">Typ</td>
                                            <td><t t-esc="order.type.name"/></td>
                                        </tr>
                                        <tr t-if="order.planned_start_datetime">
                                            <td class="text-muted">Planerat datum</td>
                                            <td><t t-esc="order.planned_start_datetime"/></td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-md-6">
                                    <table class="table table-sm table-borderless mb-0">
                                        <tr t-if="order.requested_employee_idss">
                                            <td class="text-muted" style="width:40%;">Tekniker</td>
                                            <td>
                                                <t t-foreach="order.requested_employee_idss" t-as="p">
                                                    <span class="d-block"><t t-esc="p.name"/></span>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr t-if="order.date_start">
                                            <td class="text-muted">Utförd start</td>
                                            <td><t t-esc="order.date_start"/></td>
                                        </tr>
                                        <tr t-if="order.date_end">
                                            <td class="text-muted">Utförd slut</td>
                                            <td><t t-esc="order.date_end"/></td>
                                        </tr>
                                        <tr t-if="order.resolution">
                                            <td class="text-muted">Åtgärd</td>
                                            <td><t t-esc="order.resolution"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- Checklista (visas bara om den finns) -->
                            <t t-if="order.checklist_item_ids">
                                <h5 class="mb-3">
                                    <i class="fa fa-check-square-o"/> Servicechecklista
                                </h5>
                                <table class="table table-sm">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:50px;">Status</th>
                                            <th>Uppgift</th>
                                            <th>Anteckning</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="order.checklist_item_ids" t-as="item">
                                            <tr t-attf-class="#{'text-muted' if item.done else ''}">
                                                <td class="text-center">
                                                    <t t-if="item.done">
                                                        <i class="fa fa-check-square text-success" style="font-size:18px;"/>
                                                    </t>
                                                    <t t-else="">
                                                        <i class="fa fa-square-o text-muted" style="font-size:18px;"/>
                                                    </t>
                                                </td>
                                                <td><t t-esc="item.name"/></td>
                                                <td class="text-muted"><t t-esc="item.note or ''"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                                <div class="text-muted mb-3" style="font-size:13px;">
                                    <t t-set="done_count" t-value="len(order.checklist_item_ids.filtered(lambda i: i.done))"/>
                                    <t t-set="total_count" t-value="len(order.checklist_item_ids)"/>
                                    <t t-esc="done_count"/> av <t t-esc="total_count"/> uppgifter klara
                                </div>
                            </t>

                            <!-- PDF-knapp -->
                            <div class="mt-3">
                                <a t-attf-href="/my/workorders/#{order.id}/pdf"
                                   class="btn btn-outline-secondary">
                                    <i class="fa fa-file-pdf-o"/> Ladda ner servicerapport (PDF)
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ── Felanmälan ── -->
    <template id="portal_report_problem" name="Report Problem">
        <t t-call="portal.portal_layout">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="mb-0">⚠ Report Problem</h4>
                        </div>
                        <div class="card-body">
                            <t t-if="submitted">
                                <div class="alert alert-success">
                                    <strong>Thank you for your report!</strong>
                                    We have received your report and will contact you to schedule a visit.
                                </div>
                                <a href="/my/elevators" class="btn btn-primary">Back to My Elevators</a>
                            </t>
                            <t t-if="not submitted">
                                <t t-if="error">
                                    <div class="alert alert-danger">
                                        Please fill in all required fields and try again.
                                    </div>
                                </t>
                                <form action="/my/report-problem/submit" method="POST">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Select Elevator <span class="text-danger">*</span></label>
                                        <select name="equipment_id" class="form-select" required="required">
                                            <option value="">— Select Elevator —</option>
                                            <t t-foreach="elevators" t-as="loc">
                                                <option t-att-value="loc.id">
                                                    <t t-esc="loc.name"/>
                                                    <t t-if="loc.street"> — <t t-esc="loc.street"/></t>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Problem Description <span class="text-danger">*</span></label>
                                        <textarea name="description" class="form-control" rows="5"
                                                  placeholder="Describe the problem as detailed as possible: what happened, when, how often does it occur?"
                                                  required="required"/>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            We normally respond within 1 business day.
                                        </small>
                                        <button type="submit" class="btn btn-danger">
                                            Submit Report
                                        </button>
                                    </div>
                                </form>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
