<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Security Groups -->
        <record id="module_category_service_contract" model="ir.module.category">
            <field name="name">Service Contracts</field>
            <field name="description">User access level for service contracts</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_service_contract_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_service_contract"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_service_contract_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_service_contract"/>
            <field name="implied_ids" eval="[(4, ref('group_service_contract_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record Rules -->
        <record id="rule_service_contract_all_users" model="ir.rule">
            <field name="name">Service Contract: Users can see all contracts</field>
            <field name="model_id" ref="model_elevata_service_contract"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_service_contract_template_modification_all_users" model="ir.rule">
            <field name="name">Service Contract Template Modification: Users can see all modifications</field>
            <field name="model_id" ref="model_elevata_service_contract_template_modification"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
